      "verb_form": "II",
      "occurrence_count": 5,
      "senses": [
        {
          "sense_id": "formII_ammar_s1",
          "definition": "To prolong or extend someone's life; to grant someone a long life.",
          "usage_conditions": "The Quran uses both passive and active forms for being granted an extended lifespan and for granting it.",
          "source_refs": [
            "lane:entry:4741",
            "mufradat:row:1008"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:96",
          "word_location": "2:96:12",
          "sense_ids": [
            "formII_ammar_s1"
          ]
        },
        {
          "verse_key": "36:68",
          "word_location": "36:68:2",
          "sense_ids": [
            "formII_ammar_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "formVIII_itamara",
      "form_group_ids": [
        "qac-form:Emr:{Eotamara:verb:VIII"
      ],
      "headword_arabic": "اعْتَمَرَ",
      "public_pos_label": "Verb · Form VIII",
      "verb_form": "VIII",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "formVIII_itamara_s1",
          "definition": "To visit or repair oneself to a place.",
          "usage_conditions": "This general visiting sense is associated with the Quranic interpretation of the mosque construction, while the attested Form VIII occurrence is in the specialized pilgrimage sense.",
          "source_refs": [
            "lane:entry:4744",
            "mufradat:row:1008"
          ]
        },
        {
          "sense_id": "formVIII_itamara_s2",
          "definition": "To perform the religious visit called ʿumrah.",
          "usage_conditions": "A pilgrimage construction referring to the minor pilgrimage, including its prescribed rites.",
          "source_refs": [
            "lane:entry:4744",
            "mufradat:row:1008"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:158",
          "word_location": "2:158:11",
          "sense_ids": [
            "formVIII_itamara_s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "formX_istaamara",
      "form_group_ids": [
        "qac-form:Emr:{sotaEomara:verb:X"
      ],
      "headword_arabic": "اسْتَعْمَرَ",
      "public_pos_label": "Verb · Form X",
      "verb_form": "X",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "formX_istaamara_s1",
          "definition": "To entrust, enable, or charge someone with inhabiting and cultivating a land.",
          "usage_conditions": "In the Quranic construction, the land is placed under human responsibility for development and habitation; the sense is not the later political meaning of colonial rule.",
          "source_refs": [
            "mufradat:row:1008"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "11:61",
          "word_location": "11:61:18",
          "sense_ids": [
            "formX_istaamara_s1"
          ]
        }
      ]
    },
