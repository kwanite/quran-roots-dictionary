  "quranic_forms": [
    {
      "public_form_id": "formI_amar",
      "form_group_ids": [
        "qac-form:Emr:Eamaru:verb:I"
      ],
      "headword_arabic": "عَمَرَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 4,
      "senses": [
        {
          "sense_id": "formI_amar_s1",
          "definition": "To remain, dwell, or abide in a place; by extension, to frequent or attend it.",
          "usage_conditions": "In the Quranic mosque construction, the verb has been understood as abiding in, visiting, entering, or attending the places of worship.",
          "source_refs": [
            "lane:entry:4740",
            "mufradat:row:1008"
          ]
        },
        {
          "sense_id": "formI_amar_s2",
          "definition": "To inhabit, people, cultivate, build up, or maintain a place.",
          "usage_conditions": "Used transitively with a place or building; the Quranic usages include maintaining places of worship and developing land or buildings rather than leaving them desolate.",
          "source_refs": [
            "lane:entry:4740",
            "mufradat:row:1008"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "9:18",
          "word_location": "9:18:2",
          "sense_ids": [
            "formI_amar_s1",
            "formI_amar_s2"
          ]
        },
        {
          "verse_key": "30:9",
          "word_location": "30:9:18",
          "sense_ids": [
            "formI_amar_s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "formII_ammar",
      "form_group_ids": [
        "qac-form:Emr:yuEam~aru:verb:II"
      ],
      "headword_arabic": "عَمَّرَ",
