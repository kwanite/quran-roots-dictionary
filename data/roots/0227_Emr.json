  "other_classical_meanings": [
    {
      "meaning_id": "cm_formI_life",
      "headword_arabic": "عَمِرَ",
      "definition": "To live, remain alive, or grow old; to have a long life.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4740"
      ]
    },
    {
      "meaning_id": "cm_formI_property",
      "headword_arabic": "عَمَرَ",
      "definition": "Of property, camels, or similar resources: to become plentiful, numerous, or flourishing.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4740"
      ]
    },
    {
      "meaning_id": "cm_formI_prolong",
      "headword_arabic": "عَمَرَ",
      "definition": "To prolong another person's life, as a synonym of عَمَّرَ.",
      "usage_conditions": "A transitive use distinct from the Form I meanings of inhabiting or maintaining a place.",
      "source_refs": [
        "lane:entry:4740"
      ]
    },
    {
      "meaning_id": "cm_formI_good",
      "headword_arabic": "عَمَرَ",
      "definition": "To cultivate, promote, observe, or maintain what is good.",
      "usage_conditions": "An abstract extension of the cultivation and maintenance branch.",
      "source_refs": [
        "lane:entry:4740"
      ]
    },
    {
      "meaning_id": "cm_formI_worship",
      "headword_arabic": "عَمَرَ",
      "definition": "To serve or worship one's Lord, including praying and fasting.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4740"
      ]
    },
    {
      "meaning_id": "cm_formII_selflifespan",
      "headword_arabic": "عَمَّرَ",
      "definition": "To assign or determine a limited lifespan for oneself.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4741"
      ]
    },
    {
      "meaning_id": "cm_formII_divineeverlasting",
      "headword_arabic": "عَمَّرَ",
      "definition": "To acknowledge the everlasting existence of God.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4741"
      ]
    },
    {
      "meaning_id": "cm_formII_adjure",
      "headword_arabic": "عَمَّرَ",
      "definition": "To adjure, remind, or beg someone by invoking God and the prolongation of life.",
      "usage_conditions": "Occurs in formulaic expressions such as عَمَّرْتُكَ اللهُ and related oath-like constructions.",
      "source_refs": [
        "lane:entry:4741"
      ]
    },
    {
      "meaning_id": "cm_formII_furnish",
      "headword_arabic": "عَمَّرَ",
      "definition": "To furnish a tent with the things it requires.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4741"
      ]
    },
    {
      "meaning_id": "cm_formIII_cohabit",
      "headword_arabic": "عَامَرَ",
      "definition": "To live with someone throughout that person's life.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4742"
      ]
    },
    {
      "meaning_id": "cm_formIV_inhabit",
      "headword_arabic": "أَعْمَرَ",
      "definition": "To make or enable someone to inhabit a place, or to make a land inhabited and cultivated.",
      "usage_conditions": "This is the Form IV construction discussed in the lexical evidence and is kept distinct from the Quranic Form X headword.",
      "source_refs": [
        "lane:entry:4743"
      ]
    },
    {
      "meaning_id": "cm_formIV_lifetimegrant",
      "headword_arabic": "أَعْمَرَ",
      "definition": "To assign a house, land, or camels to someone for the duration of a life.",
      "usage_conditions": "The assignment is traditionally made with a lifetime condition and is the basis of the legal term ʿumrā.",
      "source_refs": [
        "lane:entry:4743"
      ]
    },
    {
      "meaning_id": "cm_formIV_enrich",
      "headword_arabic": "أَعْمَرَ",
      "definition": "To make someone rich, competent, or free from want.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4743"
      ]
    },
    {
      "meaning_id": "cm_formIV_umrah",
      "headword_arabic": "أَعْمَرَ",
      "definition": "To assist someone in performing ʿumrah or cause someone to perform it.",
      "usage_conditions": "The usage is reported as analogical and also occurs in transmitted usage.",
      "source_refs": [
        "lane:entry:4743"
      ]
    },
    {
      "meaning_id": "cm_formVIII_purpose",
      "headword_arabic": "اعْتَمَرَ",
      "definition": "To betake oneself to an affair, aim at it, or purpose it.",
      "usage_conditions": "The object may be an expedition or another intended undertaking.",
      "source_refs": [
        "lane:entry:4744"
      ]
    },
    {
      "meaning_id": "cm_formVIII_head",
      "headword_arabic": "اعْتَمَرَ",
      "definition": "To put a head ornament, such as a turban, on one's own head.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4744"
      ]
    },
    {
      "meaning_id": "cm_amr_religion",
      "headword_arabic": "عَمْرٌ",
      "definition": "Religion or religious commitment in certain oath formulas.",
      "usage_conditions": "This is an alternative interpretation of expressions such as لَعَمْرِي and لَعَمْرُكَ, distinct from the literal meaning “by my/your life.”",
      "source_refs": [
        "lane:entry:4746"
      ]
    },
    {
      "meaning_id": "cm_amr_gum",
      "headword_arabic": "عَمْرٌ",
      "definition": "The flesh of the gum or the flesh between the teeth; the gums.",
      "usage_conditions": "Plural عُمُورٌ.",
      "source_refs": [
        "lane:entry:4746"
      ]
    },
    {
      "meaning_id": "cm_abuumrah",
      "headword_arabic": "أَبُو عُمْرَةَ",
      "definition": "A figurative name for bankruptcy, insolvency, or hunger.",
      "usage_conditions": "A fixed expression rather than the ordinary noun عُمْرَةٌ.",
      "source_refs": [
        "lane:entry:4750"
      ]
    },
    {
      "meaning_id": "cm_umrah_spousal",
      "headword_arabic": "عُمْرَةٌ",
      "definition": "A man's going in to his newly married wife in her family's abode.",
      "usage_conditions": "If she is moved to his own family's abode, the act is termed ʿurs.",
      "source_refs": [
        "lane:entry:4751"
      ]
    },
    {
      "meaning_id": "cm_umra_lifetimegift",
      "headword_arabic": "عُمْرَى",
      "definition": "A lifetime gift or assignment of a house, land, or property to another person.",
      "usage_conditions": "The property is assigned for the life of the recipient or giver, traditionally with a condition concerning its return after death.",
      "source_refs": [
        "lane:entry:4752"
      ]
    },
    {
      "meaning_id": "cm_umri_tree",
      "headword_arabic": "عُمْرِيٌّ",
      "definition": "Of a tree: old or long-lived, especially an old lote tree.",
      "usage_conditions": "A specialized adjective applied to trees.",
      "source_refs": [
        "lane:entry:4753"
      ]
    },
    {
      "meaning_id": "cm_umran_inhabited",
      "headword_arabic": "عُمْرَانٌ",
      "definition": "Inhabited, peopled, cultivated, flourishing land or a house in good repair; also a body of people associated with such habitation.",
      "usage_conditions": "The form is also used as an epithet related to عَامِرٌ.",
      "source_refs": [
        "lane:entry:4755"
      ]
    },
    {
      "meaning_id": "cm_umran_building",
      "headword_arabic": "عُمْرَانٌ",
      "definition": "A building, structure, or edifice; possibly the act of building.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4755"
      ]
    },
    {
      "meaning_id": "cm_abuumayr",
      "headword_arabic": "أَبُو عُمَيْرِ",
      "definition": "The male animal.",
      "usage_conditions": "A fixed lexical expression.",
      "source_refs": [
        "lane:entry:4758"
      ]
    },
    {
      "meaning_id": "cm_amar_headornament",
      "headword_arabic": "عَمَارٌ",
      "definition": "An object worn on the head, such as a turban, cap, crown, or wreath, especially as a sign of rank.",
      "usage_conditions": "The term may also denote an aromatic plant worn on the head.",
      "source_refs": [
        "lane:entry:4759"
      ]
    },
    {
      "meaning_id": "cm_amar_tentornament",
      "headword_arabic": "عَمَارَةٌ",
      "definition": "An ornamented piece of cloth attached to a tent or its tent-pole as a sign of headship.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4759"
      ]
    },
    {
      "meaning_id": "cm_amar_salutation",
      "headword_arabic": "عَمَارَةٌ",
      "definition": "A salutation or invocation meaning “may God prolong your life,” and associated with raising the voice or aromatic plants.",
      "usage_conditions": "A conventional greeting or ceremonial expression with variant explanations.",
      "source_refs": [
        "lane:entry:4759"
      ]
    },
    {
      "meaning_id": "cm_umara_pay",
      "headword_arabic": "عُمَارَةٌ",
      "definition": "Hire, pay, or wages for work by which a place is rendered inhabited or maintained.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4760"
      ]
    },
    {
      "meaning_id": "cm_imara_work",
      "headword_arabic": "عِمَارَةٌ",
      "definition": "The work, labor, or occupation by which a place is rendered inhabited, cultivated, or flourishing.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4761"
      ]
    },
    {
      "meaning_id": "cm_imara_building",
      "headword_arabic": "عِمَارَةٌ",
      "definition": "The act or art of building; a building, structure, or edifice.",
      "usage_conditions": "In later usage, especially a public edifice; plural عَمَائِرُ.",
      "source_refs": [
        "lane:entry:4761"
      ]
    },
    {
      "meaning_id": "cm_imara_breast",
      "headword_arabic": "عِمَارَةٌ",
      "definition": "A man's breast.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4761"
      ]
    },
    {
      "meaning_id": "cm_imara_tribe",
      "headword_arabic": "عِمَارَةٌ",
      "definition": "A large self-sufficient tribe or body of people that peoples a place.",
      "usage_conditions": "A social group between larger and smaller tribal divisions in the terminology reported.",
      "source_refs": [
        "lane:entry:4761"
      ]
    },
    {
      "meaning_id": "cm_aamir_longlife",
      "headword_arabic": "عَامِرٌ",
      "definition": "Living long.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4763"
      ]
    },
    {
      "meaning_id": "cm_aamir_inhabitant",
      "headword_arabic": "عَامِرٌ",
      "definition": "Remaining, residing, or dwelling in a place; an inhabitant of a house.",
      "usage_conditions": "The plural عُمَّارُ البُيُوتِ may refer to jinn inhabiting houses, and عَوَامِرُ البُيُوتِ to snakes in houses.",
      "source_refs": [
        "lane:entry:4763"
      ]
    },
    {
      "meaning_id": "cm_aamir_place",
      "headword_arabic": "عَامِرٌ",
      "definition": "Of a land or dwelling: inhabited, peopled, cultivated, flourishing, or restored from ruin.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4763"
      ]
    },
    {
      "meaning_id": "cm_aamir_worship",
      "headword_arabic": "عَامِرٌ",
      "definition": "A servant or worshipper of his Lord.",
      "usage_conditions": "Used in the expression إِنَّهُ لَعَامِرٌ لِرَبِّهِ.",
      "source_refs": [
        "lane:entry:4763"
      ]
    },
    {
      "meaning_id": "cm_ummamir_hyena",
      "headword_arabic": "أُمُّ عَامِرٍ",
      "definition": "The hyena, in a fixed metonymic surname.",
      "usage_conditions": "A determinate compound name for the species.",
      "source_refs": [
        "lane:entry:4763"
      ]
    },
    {
      "meaning_id": "cm_awmarah_clamour",
      "headword_arabic": "عَوْمَرَةٌ",
      "definition": "Clamour, confusion, mischief, or wearying contention.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4764"
      ]
    },
    {
      "meaning_id": "cm_maamar_place",
      "headword_arabic": "مَعْمَرٌ",
      "definition": "A spacious, agreeable, inhabited place of abode, rich in water and herbage.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4765"
      ]
    },
    {
      "meaning_id": "cm_mimaar_architect",
      "headword_arabic": "مِعْمَارٌ",
      "definition": "An architect.",
      "usage_conditions": "The evidence marks this usage as probably postclassical.",
      "source_refs": [
        "lane:entry:4766"
      ]
    },
    {
      "meaning_id": "cm_maamur_jinn",
      "headword_arabic": "مَعْمُورٌ",
      "definition": "An inhabited house, including a house inhabited by jinn.",
      "usage_conditions": "A specialized use of the passive-participial adjective outside the Quranic celestial expression.",
      "source_refs": [
        "lane:entry:4767"
      ]
    },
    {
      "meaning_id": "cm_maamur_served",
      "headword_arabic": "مَعْمُورٌ",
      "definition": "Served or worshipped.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4767"
      ]
    },
    {
      "meaning_id": "cm_mutamir_visitor",
      "headword_arabic": "مُعْتَمِرٌ",
      "definition": "A visitor or one repairing to a place.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4769"
      ]
    },
    {
      "meaning_id": "cm_mutamir_umrah",
      "headword_arabic": "مُعْتَمِرٌ",
      "definition": "One performing the religious visit called ʿumrah.",
      "usage_conditions": "A pilgrim who has entered the state of iḥrām for that visit.",
      "source_refs": [
        "lane:entry:4769"
      ]
    },
    {
      "meaning_id": "cm_mutamir_purpose",
      "headword_arabic": "مُعْتَمِرٌ",
      "definition": "One betaking himself to, aiming at, or purposing an affair.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4769"
      ]
    },
    {
      "meaning_id": "cm_mutamir_head",
      "headword_arabic": "مُعْتَمِرٌ",
      "definition": "One whose head is attired with a turban or similar head ornament.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:4769"
      ]
    },
    {
      "meaning_id": "cm_muawmar_congregate",
      "headword_arabic": "مُعَوْمِرًا",
      "definition": "Congregating and detaining people at a person's door.",
      "usage_conditions": "A specialized participial expression describing a crowd-gathering action.",
      "source_refs": [
        "lane:entry:4770"
      ]
    },
    {
      "meaning_id": "cm_yaamur_kid",
      "headword_arabic": "يَعْمُورٌ",
      "definition": "A kid or lamb.",
      "usage_conditions": "Plural يَعَامِيرُ.",
      "source_refs": [
        "lane:entry:4771"
      ]
    }
  ],
