{
  "root": "dhn",
  "arabic": "دهن",
  "root_idea": {
    "summary": "The root centers on softness, ease, and smallness or scantness, with oil as a principal concrete expression.",
    "development": "From oil and its effects of softening and moistening, the lexicon extends to slight wetting, paucity, gentle treatment, accommodation, and—figuratively—dissimulation or yielding.",
    "source_refs": [
      "maqayis:row:1852",
      "mufradat:row:492"
    ]
  },
