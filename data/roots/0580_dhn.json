  "other_classical_meanings": [
    {
      "meaning_id": "dhn_formI_anoint",
      "headword_arabic": "دَهَنَ",
      "definition": "To anoint, grease, or moisten something with oil.",
      "usage_conditions": "Used of applying oil or grease to the head, hair, moustache, or another object.",
      "source_refs": [
        "lane:entry:1475"
      ]
    },
    {
      "meaning_id": "dhn_formI_lightwet",
      "headword_arabic": "دَهَنَ",
      "definition": "Of rain, to moisten the ground slightly or wet its surface.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:1475"
      ]
    },
    {
      "meaning_id": "dhn_formI_gentlestrike",
      "headword_arabic": "دَهَنَ",
      "definition": "To strike someone gently with a staff or stick.",
      "usage_conditions": "The expression is figurative and denotes light blows or gentle strokes.",
      "source_refs": [
        "lane:entry:1475"
      ]
    },
    {
      "meaning_id": "dhn_formI_hypocriticalact",
      "headword_arabic": "دَهَنَ",
      "definition": "To act hypocritically toward someone.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:1475"
      ]
    },
    {
      "meaning_id": "dhn_formI_camel_scantmilk",
      "headword_arabic": "دَهِنَ",
      "definition": "Of a she-camel, to have little milk.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:1475"
      ]
    },
    {
      "meaning_id": "dhn_formI_weaksoft",
      "headword_arabic": "دَهِنَ",
      "definition": "To be weak, foolish, or soft and flaccid.",
      "usage_conditions": "The lexical descriptions include both weakness or foolishness and physical softness or flaccidity.",
      "source_refs": [
        "lane:entry:1475"
      ]
    },
    {
      "meaning_id": "dhn_mudahana_conciliation",
      "headword_arabic": "مُدَاهَنَةٌ",
      "definition": "Conciliation, accommodation, making peace, or becoming reconciled with another.",
      "usage_conditions": "This is the Form III verbal noun and is distinct from the Form IV Quranic form displayed above.",
      "source_refs": [
        "lane:entry:1477"
      ]
    },
    {
      "meaning_id": "dhn_mudahana_dissimulation",
      "headword_arabic": "مُدَاهَنَةٌ",
      "definition": "Dissimulation or dishonest conduct in which one conceals a contrary intention.",
      "usage_conditions": "The usage may involve showing another person something different from what is held inwardly.",
      "source_refs": [
        "lane:entry:1477"
      ]
    },
    {
      "meaning_id": "dhn_mudahana_soothing",
      "headword_arabic": "مُدَاهَنَةٌ",
      "definition": "Treating someone with gentleness, blandishment, coaxing, wheedling, beguiling, or deluding.",
      "usage_conditions": "The construction can include refraining from restraint or prohibition in order to placate or influence someone.",
      "source_refs": [
        "lane:entry:1477"
      ]
    },
    {
      "meaning_id": "dhn_mudahana_contempt",
      "headword_arabic": "مُدَاهَنَةٌ",
      "definition": "Holding something in light, little, or mean estimation, or treating it with contempt.",
      "usage_conditions": "This is a later conventional figurative extension of the term.",
      "source_refs": [
        "lane:entry:1477"
      ]
    },
    {
      "meaning_id": "dhn_idhan_spare",
      "headword_arabic": "إِدْهَانٌ",
      "definition": "To spare, show mercy or pity, pardon, or leave something intact.",
      "usage_conditions": "The construction لَا تُدْهِنْ عَلَيْهِ is explained as not sparing or pardoning him.",
      "source_refs": [
        "lane:entry:1478"
      ]
    },
    {
      "meaning_id": "dhn_idhan_fallshort",
      "headword_arabic": "إِدْهَانٌ",
      "definition": "To fall short in an affair or case.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:1478"
      ]
    },
    {
      "meaning_id": "dhn_udhina_camelvertigo",
      "headword_arabic": "أُدْهِنَ",
      "definition": "Of a camel, to be affected by the vertigo called دُهْنٌ.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:1478"
      ]
    },
    {
      "meaning_id": "dhn_iddahana_selfanoint",
      "headword_arabic": "اِدَّهَنَ",
      "definition": "To anoint oneself with oil or grease.",
      "usage_conditions": "This is the Form VIII reflexive use.",
