      "headword_arabic": "أَدْهَنَ",
      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "dhn_formIV_s1_accommodate",
          "definition": "To accommodate, conciliate, or yield toward another, especially by softening one's stance or religious commitment.",
          "usage_conditions": "In 68:9 the construction is interpreted as reciprocal conciliation or compromise; related interpretations emphasize pliancy and abandonment of firmness, with one reported interpretation intensifying this to unbelief.",
          "source_refs": [
            "lane:entry:1477",
            "mufradat:row:492"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "68:9",
          "word_location": "68:9:3",
          "sense_ids": [
            "dhn_formIV_s1_accommodate"
          ]
        },
        {
          "verse_key": "68:9",
          "word_location": "68:9:4",
          "sense_ids": [
            "dhn_formIV_s1_accommodate"
          ]
        }
      ]
    },
    {
      "public_form_id": "dhn_dihan",
      "form_group_ids": [
        "qac-form:dhn:d~ihaAn:nominal:-"
      ],
      "headword_arabic": "دِهَانٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "dhn_dihan_s1_redhide_or_oildregs",
          "definition": "A red hide, or—by another interpretation—the dregs or varied substance of oil; in the Quranic simile, something resembling one of these.",
          "usage_conditions": "In 55:37 the expression admits the lexical alternatives of a vividly red hide and oil or oil dregs; the occurrence is a comparison rather than a literal identification.",
          "source_refs": [
            "lane:entry:1490",
            "mufradat:row:492"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "55:37",
          "word_location": "55:37:6",
          "sense_ids": [
            "dhn_dihan_s1_redhide_or_oildregs"
          ]
        }
      ]
    },
    {
      "public_form_id": "dhn_duhn",
      "form_group_ids": [
        "qac-form:dhn:d~uhon:nominal:-"
      ],
      "headword_arabic": "دُهْنٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "dhn_duhn_s1_oil",
          "definition": "Oil or grease used for anointing, greasing, or moistening.",
          "usage_conditions": "The Quranic occurrence denotes oil in the context of the produce of the olive tree; the noun can also denote a portion or kind of oil.",
          "source_refs": [
            "lane:entry:1483",
            "mufradat:row:492"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "23:20",
          "word_location": "23:20:7",
          "sense_ids": [
            "dhn_duhn_s1_oil"
          ]
        }
      ]
    },
    {
      "public_form_id": "dhn_mudhin",
      "form_group_ids": [
        "qac-form:dhn:m~udohinuwn:nominal:-"
      ],
      "headword_arabic": "مُدْهِنٌ",
      "public_pos_label": "Active participle",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "dhn_mudhin_s1_treatlightly",
          "definition": "One who treats an authoritative message lightly, disregards it, or rejects it.",
          "usage_conditions": "In 56:81 the participle is interpreted as holding the revelation in little or mean estimation and thereby rejecting or disbelieving it; the sense also reflects abandoning seriousness.",
          "source_refs": [
            "lane:entry:1496",
            "mufradat:row:492"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "56:81",
          "word_location": "56:81:4",
          "sense_ids": [
            "dhn_mudhin_s1_treatlightly"
          ]
        }
      ]
    }
