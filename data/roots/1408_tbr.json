  "other_classical_meanings": [
    {
      "meaning_id": "cm_tbr_tabira_perish",
      "headword_arabic": "تَبِرَ",
      "definition": "To perish; come to ruin.",
      "usage_conditions": "Intransitive Form I verb.",
      "source_refs": [
        "lane:entry:16447"
      ]
    },
    {
      "meaning_id": "cm_tbr_tabara_transitive",
      "headword_arabic": "تَبَرَ",
      "definition": "To break something up or into small pieces, crumble it, do away with it, or destroy it.",
      "usage_conditions": "Transitive Form I construction, distinct from intransitive تَبِرَ “to perish”; تَبْرٌ is also attested as its verbal noun.",
      "source_refs": [
        "lane:entry:16448",
        "mufradat:row:173"
      ]
    },
    {
      "meaning_id": "cm_tbr_tibr_unwrought_metal",
      "headword_arabic": "تِبْرٌ",
      "definition": "Native or unworked metal, especially gold; also silver and other mineral ores before they are wrought or used.",
      "usage_conditions": "Especially applied to gold dust, nuggets, or broken particles; its application is also extended to silver and other native ores or minerals.",
      "source_refs": [
        "lane:entry:16449"
      ]
    },
    {
      "meaning_id": "cm_tbr_tibr_broken_glass",
      "headword_arabic": "تِبْرٌ",
      "definition": "Broken pieces of glass.",
      "usage_conditions": "A distinct additional lexical application of تِبْرٌ.",
      "source_refs": [
        "lane:entry:16449"
      ]
    },
    {
      "meaning_id": "cm_tbr_tibriya_scurf",
      "headword_arabic": "تِبْرِيَةٌ",
      "definition": "Scurf formed at the roots of the hair, resembling bran.",
      "usage_conditions": "Dialectal variant of هِبْرِيَةٌ.",
      "source_refs": [
        "lane:entry:16450"
      ]
    },
    {
      "meaning_id": "cm_tbr_mutabbar_counsel_nought",
      "headword_arabic": "مُتَبَّر",
      "definition": "Brought to nought, of counsel or a plan.",
      "usage_conditions": "Figurative or conventional predication of counsel that has been rendered useless.",
      "source_refs": [
        "lane:entry:16452"
      ]
    },
    {
      "meaning_id": "cm_tbr_matbur_destroyed",
      "headword_arabic": "مَتْبُور",
      "definition": "Destroyed; in a state of destruction.",
      "usage_conditions": "Adjectival description of a person or thing in a ruined state.",
