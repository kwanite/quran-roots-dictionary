    },
    {
      "meaning_id": "cm_shawar_pudenda",
      "headword_arabic": "شَوَارٌ",
      "definition": "The pudendum or pudenda of a man or woman; more specifically, a man's penis, testicles, and anus.",
      "usage_conditions": "The word also occurs in the imprecation asking that someone's pudenda be made bare.",
