{
  "root": "$wr",
  "arabic": "شور",
  "root_idea": {
    "summary": "The root has two established semantic orientations: displaying or making something manifest, and taking or extracting something.",
    "development": "From extracting honey came the figurative development of extracting another person's opinion through consultation; the displaying branch includes showing, indicating, appearance, and related forms.",
