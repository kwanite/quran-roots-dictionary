      "headword_arabic": "شَاوَرَ",
      "public_pos_label": "Verb · Form III",
      "verb_form": "III",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "sense_shawara_consult",
          "definition": "To consult someone or consult together, seeking or eliciting an opinion.",
          "usage_conditions": "Used for reciprocal deliberation or for seeking counsel from another person; the Quranic occurrence is an imperative addressed to the Prophet concerning consultation with them.",
          "source_refs": [
            "lane:entry:39520",
            "mufradat:row:797"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "3:159",
          "word_location": "3:159:19",
          "sense_ids": [
            "sense_shawara_consult"
          ]
        }
      ]
    },
    {
      "public_form_id": "form_ashara_IV",
      "form_group_ids": [
        "qac-form:$wr:>a$aArato:verb:IV"
      ],
      "headword_arabic": "أَشَارَ",
      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "sense_ashara_point",
          "definition": "To point or signal to someone or something, conveying an intended message.",
          "usage_conditions": "The sign may be made with the hand, head, eye, eyebrow, or another communicative gesture; the Quranic occurrence describes pointing toward the child.",
          "source_refs": [
            "lane:entry:39521"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "19:29",
          "word_location": "19:29:1",
          "sense_ids": [
            "sense_ashara_point"
          ]
        }
      ]
    },
    {
      "public_form_id": "form_shura",
      "form_group_ids": [
        "qac-form:$wr:$uwraY`:nominal:-"
      ],
      "headword_arabic": "شُورَىٰ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "sense_shura_deliberation",
          "definition": "Mutual consultation; an affair or decision determined through consultation.",
          "usage_conditions": "The Quranic construction presents the community's affairs as subject to deliberation among its members, rather than being appropriated by one person alone.",
          "source_refs": [
            "mufradat:row:797",
            "lane:entry:39547"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "42:38",
          "word_location": "42:38:7",
          "sense_ids": [
            "sense_shura_deliberation"
          ]
        }
      ]
    },
    {
      "public_form_id": "form_tashawur",
      "form_group_ids": [
        "qac-form:$wr:ta$aAwur:nominal:-"
      ],
      "headword_arabic": "تَشَاوُر",
      "public_pos_label": "Verbal noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "sense_tashawur_mutual_consultation",
          "definition": "Mutual consultation: the reciprocal eliciting and exchange of opinions.",
          "usage_conditions": "A verbal noun for people consulting together or debating in order to arrive at one another's views; the Quranic occurrence is in the context of a jointly considered parental decision.",
          "source_refs": [
            "lane:entry:39523",
            "mufradat:row:797"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:233",
          "word_location": "2:233:40",
          "sense_ids": [
            "sense_tashawur_mutual_consultation"
          ]
        }
      ]
    }
  ],
  "other_classical_meanings": [
    {
      "meaning_id": "cm_shar_honey",
      "headword_arabic": "شَارَ",
      "definition": "To gather or extract honey from its hive or from a hollow where it has been deposited.",
      "usage_conditions": "The extraction may be from a natural hollow or from a hive.",
      "source_refs": [
        "lane:entry:39518",
        "lane:entry:39527"
      ]
    },
    {
      "meaning_id": "cm_shar_display",
      "headword_arabic": "شَارَ",
      "definition": "To exhibit or display something; especially, to exhibit a beast for sale while testing its pace, manner of going, or power.",
      "usage_conditions": "The beast may be made to run or be examined as part of the display; displaying one's own agility is also attested.",
      "source_refs": [
        "lane:entry:39518"
      ]
    },
    {
      "meaning_id": "cm_shar_adorn",
      "headword_arabic": "شَارَ",
      "definition": "To ornament or decorate something.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:39518"
      ]
    },
    {
      "meaning_id": "cm_shar_goodly",
      "headword_arabic": "شَارَ",
      "definition": "To become goodly in appearance; of an animal, to become fat and goodly.",
      "usage_conditions": "Attested of persons, horses, camels, and camels collectively.",
      "source_refs": [
        "lane:entry:39518"
      ]
    },
    {
      "meaning_id": "cm_shawwar_shame",
      "headword_arabic": "شَوَّرَ",
      "definition": "To expose someone to shame, including by exposing the pudenda, and thereby leave him ashamed, confounded, or perplexed.",
      "usage_conditions": "The causative construction describes shame or confusion resulting from an indecent act.",
      "source_refs": [
        "lane:entry:39519"
      ]
    },
    {
      "meaning_id": "cm_shawwar_cotton",
      "headword_arabic": "شَوَّرَ",
      "definition": "To turn over, separate, or loosen cotton with a carding implement.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:39519"
      ]
    },
    {
      "meaning_id": "cm_ashwara_honey_help",
      "headword_arabic": "أَشْوَرَ",
      "definition": "To help someone gather honey.",
      "usage_conditions": "The construction is attested with honey as its object.",
      "source_refs": [
        "lane:entry:39521"
      ]
    },
    {
      "meaning_id": "cm_ashwara_fire",
      "headword_arabic": "أَشْوَرَ",
      "definition": "To stir up a fire or make it burn more strongly.",
      "usage_conditions": "The object may be the fire itself or an expression meaning to stir it up.",
      "source_refs": [
        "lane:entry:39521"
      ]
    },
    {
      "meaning_id": "cm_ashara_make_known",
      "headword_arabic": "أَشَارَ",
      "definition": "To make something known, indicate it, or notify someone of it.",
      "usage_conditions": "In grammatical usage, the verb can indicate a vowel or case-ending by a subtle pronunciation while pausing.",
      "source_refs": [
        "lane:entry:39521"
      ]
    },
    {
      "meaning_id": "cm_ashara_advise",
      "headword_arabic": "أَشَارَ",
      "definition": "To advise, counsel, guide, or direct someone toward a course of action.",
      "usage_conditions": "The construction may convey advice, notification of the right course, an order, or an injunction.",
      "source_refs": [
        "lane:entry:39521"
      ]
    },
    {
      "meaning_id": "cm_tashawwara_shame",
      "headword_arabic": "تَشَوَّرَ",
      "definition": "To become ashamed and confounded or perplexed after an indecent act.",
      "usage_conditions": "The attestation is reported with some lexicographical disagreement about its genuineness.",
      "source_refs": [
        "lane:entry:39522"
      ]
    },
    {
      "meaning_id": "cm_tashayara_conspicuous",
      "headword_arabic": "تَشَايَرَ",
      "definition": "To render someone conspicuous or notorious through people's looking at him.",
      "usage_conditions": "This is a reported traditional usage of the form with yāʾ in place of the root wāw.",
      "source_refs": [
        "lane:entry:39523"
      ]
    },
    {
      "meaning_id": "cm_ishtara_tail",
      "headword_arabic": "اِشْتَارَ",
      "definition": "Of a horse, to raise its tail while running.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:39524"
      ]
    },
    {
      "meaning_id": "cm_istashara_camel",
      "headword_arabic": "اِسْتَشَارَ",
      "definition": "Of a stallion-camel, to smell and examine a she-camel to determine whether she has conceived.",
      "usage_conditions": "The construction is specifically used for the stallion's examination of the she-camel.",
      "source_refs": [
        "lane:entry:39525"
      ]
    },
    {
      "meaning_id": "cm_istashara_manifest",
      "headword_arabic": "اِسْتَشَارَ",
      "definition": "For a person's case or affair to become manifest.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:39525"
      ]
    },
    {
      "meaning_id": "cm_istashara_apparel",
      "headword_arabic": "اِسْتَشَارَ",
      "definition": "To put on or clothe oneself in goodly apparel.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:39525"
      ]
    },
    {
      "meaning_id": "cm_shura_appearance",
