        "lane:entry:39539"
      ]
    },
    {
      "meaning_id": "cm_shayir_inner",
      "headword_arabic": "شَيِّرٌ",
      "definition": "Goodly in intrinsic qualities when tried.",
      "usage_conditions": "The sense concerns inward character rather than outward appearance.",
