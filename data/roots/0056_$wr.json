      "usage_conditions": "Plural forms are also reported.",
      "source_refs": [
        "lane:entry:39538"
      ]
    },
    {
      "meaning_id": "cm_shayir_consultant",
      "headword_arabic": "شَيِّرٌ",
      "definition": "A consulter or counsellor, one qualified to be consulted.",
      "usage_conditions": "It can also denote one's adviser or vizier.",
