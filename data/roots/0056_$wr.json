    },
    {
      "meaning_id": "cm_shura_inner_quality",
      "headword_arabic": "شُورَةٌ",
      "definition": "A person's internal or intrinsic state or quality as revealed when tried.",
      "usage_conditions": "This contrasts the inward character of a person with outward form or appearance.",
