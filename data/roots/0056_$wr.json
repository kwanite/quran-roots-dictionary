        "lane:entry:39539"
      ]
    },
    {
      "meaning_id": "cm_shayir_appearance",
      "headword_arabic": "شَيِّرٌ",
      "definition": "Goodly in outward appearance or apparel; beautiful or good.",
      "usage_conditions": "The feminine form is attested for a woman in this outward sense.",
