      "verb_form": "V",
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "kbr-takabbara-s1",
          "definition": "To exalt oneself arrogantly; to regard oneself as superior and act disdainfully.",
          "usage_conditions": "In the Quran, the form denotes blameworthy self-exaltation, including holding oneself above submission or refusing what one ought to accept; بِـ or فِي constructions specify the sphere of the arrogance.",
          "source_refs": [
            "lane:entry:27793",
            "mufradat:row:1232"
          ]
        }
      ],
      "quran_examples": [
