      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "kbr-akbara-verb-s1",
          "definition": "To regard something as great; to be greatly impressed by it.",
          "usage_conditions": "The Quranic use describes a strong reaction of admiration or astonishment upon seeing someone or something.",
          "source_refs": [
            "lane:entry:27792",
            "mufradat:row:1232"
          ]
        }
      ],
      "quran_examples": [
        {
