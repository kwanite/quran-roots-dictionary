      "occurrence_count": 4,
      "senses": [
        {
          "sense_id": "kbr-kabbara-s1",
          "definition": "To make great; to magnify or honor.",
          "usage_conditions": "In Quranic worship language, it denotes magnifying God, declaring His greatness, and expressing that greatness in devotion.",
          "source_refs": [
            "lane:entry:27790",
            "mufradat:row:1232"
          ]
        }
      ],
