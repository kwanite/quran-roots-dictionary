{
  "root": "kbr",
  "arabic": "كبر",
  "root_idea": {
    "summary": "A root oriented toward becoming or being great rather than small, whether in physical size, age, rank, importance, severity, or perceived superiority.",
    "development": "The lexical field extends from physical magnitude and growth to age, eminence, consequence, and the evaluation of an affair as difficult or grave. It also develops into magnification, divine majesty, and—when claimed improperly—self-exaltation and arrogance.",
    "source_refs": [
      "maqayis:row:3918",
      "mufradat:row:1232"
    ]
  },
