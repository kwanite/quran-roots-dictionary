      "headword_arabic": "كَبِير",
      "public_pos_label": "Adjective / noun",
      "verb_form": null,
      "occurrence_count": 40,
      "senses": [
        {
          "sense_id": "kbr-kabir-s1",
          "definition": "Great or large in magnitude, importance, rank, or dignity; incomparably great.",
          "usage_conditions": "The same adjective may describe physical or abstract greatness, eminence, or consequence; as a divine epithet it denotes incomparable greatness.",
          "source_refs": [
            "lane:entry:27809",
            "mufradat:row:1232"
          ]
        },
        {
          "sense_id": "kbr-kabir-s2",
          "definition": "Advanced in age, old, or full-grown.",
          "usage_conditions": "Used of a person or other living being that has reached advanced age, full growth, adolescence, or puberty.",
          "source_refs": [
            "lane:entry:27809",
            "mufradat:row:1232"
          ]
        },
        {
          "sense_id": "kbr-kabir-s3",
          "definition": "A chief, leader, master, teacher, or senior figure.",
          "usage_conditions": "This substantivized use denotes the recognized head or leading member of a group, including a teacher or the most learned person.",
          "source_refs": [
            "lane:entry:27809",
            "mufradat:row:1232"
          ]
        },
        {
          "sense_id": "kbr-kabir-s4",
          "definition": "Grave, difficult, severe, or burdensome.",
          "usage_conditions": "When used substantivally or adjectivally of an affair, sin, statement, or consequence, it marks serious magnitude or difficulty rather than mere physical size.",
          "source_refs": [
            "lane:entry:27809",
            "mufradat:row:1232"
          ]
        }
      ],
