  "quranic_forms": [
    {
      "public_form_id": "kbr-kabura",
      "form_group_ids": [
        "qac-form:kbr:kabura:verb:I"
      ],
      "headword_arabic": "كَبُرَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 8,
      "senses": [
        {
          "sense_id": "kbr-kabura-s1",
          "definition": "To become great, large, or significant; to grow up or attain maturity.",
          "usage_conditions": "Used of physical or recognized greatness and, in Quranic contexts, of growing up or becoming momentous.",
          "source_refs": [
            "lane:entry:27789",
            "mufradat:row:1232"
          ]
        },
        {
          "sense_id": "kbr-kabura-s2",
          "definition": "To be difficult, severe, grievous, or burdensome.",
          "usage_conditions": "Frequently occurs with عَلَيْهِ, describing an affair or message as difficult or distressing to someone; it can also characterize a grave or momentous statement or matter.",
          "source_refs": [
            "lane:entry:27789",
            "mufradat:row:1232"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "4:6",
          "word_location": "4:6:19",
          "sense_ids": [
            "kbr-kabura-s1"
          ]
        },
        {
          "verse_key": "6:35",
          "word_location": "6:35:3",
          "sense_ids": [
            "kbr-kabura-s2"
          ]
        },
        {
