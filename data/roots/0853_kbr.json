  "other_classical_meanings": [
    {
      "meaning_id": "kbr-kabira-aging",
      "headword_arabic": "كَبِرَ",
      "definition": "To become full-grown, old, or advanced in age; to reach adolescence or puberty.",
      "usage_conditions": "This is the vocalized verb كَبِرَ, distinct from the Quranic Form I citation كَبُرَ.",
      "source_refs": [
        "lane:entry:27789"
      ]
    },
    {
      "meaning_id": "kbr-kabara-age-exceed",
      "headword_arabic": "كَبَرَ",
      "definition": "To exceed another in age.",
      "usage_conditions": "Used transitively in expressions stating that one person is older than another by a specified number of years.",
      "source_refs": [
        "lane:entry:27789"
      ]
    },
    {
      "meaning_id": "kbr-kabara-vie",
      "headword_arabic": "كَابَرَ",
      "definition": "To vie or contend with another for superiority; to dispute or overcome in a contest of greatness.",
      "usage_conditions": "The construction may describe rivalry, disputation, or overcoming another in claimed superiority.",
      "source_refs": [
        "lane:entry:27791"
      ]
    },
    {
      "meaning_id": "kbr-kabara-deny-right",
      "headword_arabic": "كَابَرَ",
      "definition": "To deny or disacknowledge another's right while contending for it.",
      "usage_conditions": "A specialized transitive construction for disputing a due or right, including knowingly resisting the truth of an opponent's claim.",
      "source_refs": [
        "lane:entry:27791"
      ]
    },
    {
      "meaning_id": "kbr-mukabar-force",
      "headword_arabic": "مُكَابَرٌ عَلَيْهِ",
      "definition": "To have one's property taken from one by force.",
      "usage_conditions": "A passive construction describing forcible seizure or overpowering with respect to property.",
      "source_refs": [
        "lane:entry:27791",
        "lane:entry:27819"
      ]
    },
    {
      "meaning_id": "kbr-akbara-large-birth",
      "headword_arabic": "أَكْبَرَ",
      "definition": "Of a female animal, to bring forth a large young one.",
      "usage_conditions": "This is a specialized Classical Arabic use of the Form IV verb, distinct from the Quranic sense of regarding something as great.",
      "source_refs": [
        "lane:entry:27792"
      ]
    },
    {
      "meaning_id": "kbr-takabbara-genuine-superiority",
      "headword_arabic": "تَكَبَّرَ",
      "definition": "To possess or manifest genuine excellence and superiority in great actions.",
      "usage_conditions": "A laudatory Classical Arabic use, distinguished from the Quranic blameworthy use of affected or arrogant self-exaltation.",
      "source_refs": [
        "lane:entry:27793"
      ]
    },
    {
      "meaning_id": "kbr-istakbara-proper-seeking",
      "headword_arabic": "اِسْتَكْبَرَ",
      "definition": "To seek or endeavor to become great in an appropriate way.",
      "usage_conditions": "In the ethical distinction preserved in the lexical discussion, seeking legitimate greatness in the proper circumstance may be praiseworthy; this is separate from the Quranic blameworthy usage.",
      "source_refs": [
        "lane:entry:27793",
        "mufradat:row:1232"
      ]
    },
    {
      "meaning_id": "kbr-kibr-unbelief",
      "headword_arabic": "كِبْر",
      "definition": "Unbelief or associating another being with God.",
      "usage_conditions": "A specialized traditional usage extending the notion of arrogant refusal into unbelief and shirk.",
      "source_refs": [
        "lane:entry:27797"
      ]
    },
    {
      "meaning_id": "kbr-kabar-caper",
      "headword_arabic": "كَبَر",
      "definition": "The caper or capparis plant.",
      "usage_conditions": "A separate plant name, described as an Arabicized borrowing and not a semantic branch of greatness.",
      "source_refs": [
        "lane:entry:27798"
      ]
    },
    {
      "meaning_id": "kbr-kabra-oldness",
      "headword_arabic": "كَبْرَة",
      "definition": "Oldness or age; by extension, age-worn or rust-damaged condition of an iron weapon head or blade.",
      "usage_conditions": "The noun can describe old age in persons and deterioration through age in objects; it is also used of dates and similar things.",
      "source_refs": [
        "lane:entry:27802"
      ]
    },
    {
      "meaning_id": "kbr-kibra-seniority",
      "headword_arabic": "كِبْرَة",
      "definition": "The eldest or greatest member of a family or people, or the one nearest in kin to the chief ancestor.",
      "usage_conditions": "The term may mark seniority by age, headship, genealogical proximity, or precedence in inheritance from an emancipator.",
      "source_refs": [
        "lane:entry:27803"
      ]
    },
    {
      "meaning_id": "kbr-kabir-kabir",
      "headword_arabic": "كَابِر",
      "definition": "Great in dignity or nobility; one who prevails in greatness; a lord, chief, or greatest ancestor.",
      "usage_conditions": "This is the separate active-participial headword كَابِر, including the idiom of inheriting dignity from one great ancestor after another.",
      "source_refs": [
        "lane:entry:27809"
      ]
    },
    {
      "meaning_id": "kbr-kibr-elders",
      "headword_arabic": "كِبْر",
      "definition": "Elders, senior men, or great people of a group.",
      "usage_conditions": "In a special plural usage, كِبْر can function as a plural of أَكْبَر for senior or eminent members of a community.",
      "source_refs": [
        "lane:entry:27814"
      ]
    },
    {
      "meaning_id": "kbr-kubra-age",
      "headword_arabic": "كُبْرَىٰ",
      "definition": "Advanced in age, especially among a group of daughters or children.",
      "usage_conditions": "A specialized feminine superlative use referring to age and seniority rather than general greatness or severity.",
      "source_refs": [
        "lane:entry:27814"
      ]
    }
  ],
