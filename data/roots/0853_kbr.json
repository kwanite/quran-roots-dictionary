            "mufradat:row:1232"
          ]
        },
        {
          "sense_id": "kbr-mutakabbir-s2",
          "definition": "The One whose greatness, majesty, and excellence surpass all created beings.",
          "usage_conditions": "As a divine epithet, the form denotes genuine and absolute greatness, not affected human arrogance.",
