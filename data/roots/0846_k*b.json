  "other_classical_meanings": [
    {
      "meaning_id": "cl-f1-resembling",
      "headword_arabic": "كَذَبَ",
      "definition": "To utter a statement resembling a lie while intending the truth.",
      "usage_conditions": "A reported conventional use illustrated by statements that appear false although their speaker remains truthful.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-error",
      "headword_arabic": "كَذَبَ",
      "definition": "To state something untrue unintentionally; to make a mistake or err.",
      "usage_conditions": "A Classical use explicitly distinguished from deliberate lying.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-nonhuman-failure",
      "headword_arabic": "كَذَبَ",
      "definition": "Of an expectation, dream, opinion, desire, promise, or similar thing: to prove false or fail to materialize.",
      "usage_conditions": "A broader Classical use of the verb for non-human subjects, including a dream or a promise of rain.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-perception",
      "headword_arabic": "كَذَبَ",
      "definition": "Of sight or judgment: to deceive or misrepresent reality.",
      "usage_conditions": "Used in expressions where the eye or judgment presents something contrary to its real state.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-physical-failure",
      "headword_arabic": "كَذَبَ",
      "definition": "To fail, slacken, or abate after giving an indication of continuation.",
      "usage_conditions": "Applied in Classical expressions to camel's milk, a camel's pace, or heat.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-camel",
      "headword_arabic": "كَذَبَتْ",
      "definition": "Of a she-camel covered by a stallion: to raise her tail and return without conceiving.",
      "usage_conditions": "A specialized animal-related use.",
      "source_refs": [
        "lane:entry:28020",
        "lane:entry:28035"
      ]
    },
    {
      "meaning_id": "cl-f1-urging",
      "headword_arabic": "كَذَبَ عَلَيْكَ",
      "definition": "To urge someone to adhere to, undertake, or take up something; hence, in some idioms, that the matter is incumbent or practicable.",
      "usage_conditions": "An idiomatic exhortatory construction, especially كَذَبَ عَلَيْكَ or كَذَبَ عَلَيْكُمْ; it can be interpreted as “keep to,” “undertake,” “it is incumbent,” or “it is possible.”",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-contrary-truth",
      "headword_arabic": "كَذَبَ",
      "definition": "In a reported contrary usage, to speak truth.",
      "usage_conditions": "A lexically reported contronymic use, particularly in the expression كَذَبَ النَّسَّابُونَ.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f1-breakwind",
      "headword_arabic": "كَذَبَتْ عَفَّاقَتُكَ",
      "definition": "To break wind.",
      "usage_conditions": "A rare idiomatic expression.",
      "source_refs": [
        "lane:entry:28020"
      ]
    },
    {
      "meaning_id": "cl-f2-repel",
      "headword_arabic": "كَذَّبَ عَنْهُ",
      "definition": "To repel or defend someone.",
      "usage_conditions": "A specialized transitive construction with عَنْ.",
      "source_refs": [
        "lane:entry:28021"
      ]
    },
    {
      "meaning_id": "cl-f2-fighting",
      "headword_arabic": "كَذَّبَ",
      "definition": "In fighting, to fail to follow through on a charge, retreat, or act cowardly after charging.",
      "usage_conditions": "The expression can also describe a charge that falsifies the expectation formed by it or a false charge.",
      "source_refs": [
        "lane:entry:28021"
      ]
    },
    {
      "meaning_id": "cl-f2-slacken",
      "headword_arabic": "كَذَّبَ السَّيْرَ",
      "definition": "To slacken one's pace or cease proceeding with energy.",
      "usage_conditions": "A specialized construction concerning travel or movement.",
      "source_refs": [
        "lane:entry:28021"
      ]
    },
    {
      "meaning_id": "cl-f2-delay",
      "headword_arabic": "مَا كَذَّبَ أَنْ فَعَلَ",
      "definition": "Not to delay or hesitate to do something.",
      "usage_conditions": "A construction describing prompt action and absence of cowardly hesitation.",
      "source_refs": [
        "lane:entry:28021"
      ]
    },
    {
      "meaning_id": "cl-f2-desist",
      "headword_arabic": "كَذَّبَ عَنْ أَمْرٍ",
      "definition": "To abstain, desist, or draw back through fear from something one intended to do.",
      "usage_conditions": "A specialized intransitive construction.",
      "source_refs": [
        "lane:entry:28021"
      ]
    },
    {
      "meaning_id": "cl-f2-wildbeast",
      "headword_arabic": "كَذَّبَ",
      "definition": "Of a wild beast: to run and then stop to see what is behind it.",
      "usage_conditions": "A specialized animal-behavior use.",
      "source_refs": [
        "lane:entry:28021"
      ]
    },
    {
      "meaning_id": "cl-f3-mutual",
      "headword_arabic": "كَاذَبَ",
      "definition": "To lie to one another.",
      "usage_conditions": "A reciprocal Form III construction.",
      "source_refs": [
        "lane:entry:28022"
      ]
    },
    {
      "meaning_id": "cl-f4-findliar",
      "headword_arabic": "أَكْذَبَ",
      "definition": "To find, show, or prove someone to be a liar.",
      "usage_conditions": "Reported alongside the related sense of announcing or making manifest another person's lying.",
      "source_refs": [
        "lane:entry:28023"
      ]
    },
    {
      "meaning_id": "cl-f4-incite",
      "headword_arabic": "أَكْذَبَ",
      "definition": "To incite, urge, or induce someone to lie.",
      "usage_conditions": "A further reported Form IV use.",
      "source_refs": [
        "lane:entry:28023"
      ]
    },
    {
      "meaning_id": "cl-f4-feignsleep",
      "headword_arabic": "أَكْذَبَ",
      "definition": "When called or shouted to, to remain silent while pretending to be asleep.",
      "usage_conditions": "A specialized idiomatic use.",
      "source_refs": [
        "lane:entry:28023"
      ]
    },
    {
      "meaning_id": "cl-f5-affectedlie",
      "headword_arabic": "تَكذَّبَ",
      "definition": "To affect lying or deliberately tell a lie.",
      "usage_conditions": "A Form V reflexive or middle construction expressing purposeful or affected lying.",
      "source_refs": [
        "lane:entry:28024"
      ]
    },
    {
      "meaning_id": "cl-f5-accuse",
      "headword_arabic": "تَكذَّبَ عَلَيْهِ",
      "definition": "To assert that someone is a liar or bring a charge of lying against him.",
      "usage_conditions": "A transitive or prepositional Form V construction.",
      "source_refs": [
        "lane:entry:28024"
      ]
    },
    {
      "meaning_id": "cl-f6-mutual",
      "headword_arabic": "تَكَاذَبَ",
      "definition": "To lie mutually or tell lies to one another.",
      "usage_conditions": "A reciprocal Form VI construction.",
      "source_refs": [
        "lane:entry:28025"
      ]
    },
    {
      "meaning_id": "cl-kadhib-accusation",
      "headword_arabic": "كَذِبٌ",
      "definition": "An accusation of lying or an act of making someone a liar.",
      "usage_conditions": "A nominal use preserved in expressions that negate accusing the addressee of lying.",
      "source_refs": [
        "lane:entry:28027"
      ]
    },
    {
      "meaning_id": "cl-soul-deceiver",
      "headword_arabic": "الكَذُوبُ",
      "definition": "The soul as a deceiver that raises vain hopes or makes a person imagine that he cannot carry out an undertaking.",
      "usage_conditions": "A figurative name for the soul in Classical usage.",
      "source_refs": [
        "lane:entry:28031"
      ]
    },
    {
      "meaning_id": "cl-kadhdhabah-cloth",
      "headword_arabic": "كَذَّابَةٌ",
      "definition": "A figured or multicolored cloth whose design appears to be on the ceiling although it is on cloth below it.",
      "usage_conditions": "A specialized figurative noun based on deceptive appearance.",
      "source_refs": [
        "lane:entry:28034"
      ]
    },
    {
      "meaning_id": "cl-kadhib-false-dream",
      "headword_arabic": "كَاذِبٌ",
      "definition": "False or vain, as of a dream whose promise or appearance proves unreal.",
      "usage_conditions": "An adjectival use applied to a dream or similar expectation.",
      "source_refs": [
        "lane:entry:28035"
      ]
    },
    {
      "meaning_id": "cl-kadhib-abortive-charge",
      "headword_arabic": "كَاذِبٌ",
      "definition": "Of a charge: abortive or followed by cowardly retreat.",
      "usage_conditions": "A specialized adjectival use for an action that fails to fulfill the promise of its beginning.",
      "source_refs": [
        "lane:entry:28035"
      ]
    },
    {
      "meaning_id": "cl-makdhub",
      "headword_arabic": "مَكْذُوبٌ",
