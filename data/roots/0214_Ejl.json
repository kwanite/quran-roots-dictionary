      "meaning_id": "cm_ajlan_bow",
      "headword_arabic": "عَجْلَانُ",
      "definition": "Quick-shooting, applied to a bow whose arrow flies swiftly.",
      "usage_conditions": "Used in the feminine form with قَوْسٌ.",
      "source_refs": [
        "lane:entry:2280"
      ]
    },
    {
      "meaning_id": "cm_ajlan_bird",
      "headword_arabic": "عَجْلَانُ",
      "definition": "A named bird, black with white at the base of its tail.",
      "usage_conditions": "The bird is noted for frequent movement of its tail.",
      "source_refs": [
        "lane:entry:2280"
      ]
    },
    {
      "meaning_id": "cm_ajlan_month",
      "headword_arabic": "عَجْلَانُ",
      "definition": "Shaʿbān, so called for its apparently swift passing.",
      "usage_conditions": "A traditional name explained by the month's seeming brevity before the fast of Ramadan.",
      "source_refs": [
        "lane:entry:2280"
      ]
    },
    {
      "meaning_id": "cm_ajul_bereaved",
      "headword_arabic": "عَجُولٌ",
      "definition": "A female camel distracted or agitated after losing her young; also a woman bereaved of her child.",
      "usage_conditions": "The usage emphasizes restless coming and going caused by grief and impatience.",
      "source_refs": [
        "lane:entry:2281"
      ]
    },
    {
      "meaning_id": "cm_ajul_death",
      "headword_arabic": "عَجُولٌ",
      "definition": "Death or the decree of death.",
      "usage_conditions": "Figuratively, death hastens the one it overtakes and prevents him from reaching his family.",
      "source_refs": [
        "lane:entry:2281"
      ]
    },
    {
      "meaning_id": "cm_ujala_provision",
      "headword_arabic": "عُجَالَةٌ",
      "definition": "Food or provision taken hastily, especially a rider's travel food or a quick provision for a guest.",
      "usage_conditions": "Includes dates, parched-barley meal, and other food requiring little preparation.",
      "source_refs": [
        "lane:entry:2284",
        "lane:entry:2289"
      ]
    },
    {
      "meaning_id": "cm_ujala_milk",
      "headword_arabic": "عُجَالَةٌ",
      "definition": "Milk brought promptly from animals at pasture before the ordinary milking.",
      "usage_conditions": "Used of milk carried to the household while the flock is still away or before its return.",
      "source_refs": [
        "lane:entry:2284"
      ]
    },
    {
      "meaning_id": "cm_ijala_plant",
      "headword_arabic": "عِجَالَةٌ",
      "definition": "A certain creeping plant, identified with the plant also called وَشِيجٌ.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:2285"
      ]
    },
    {
      "meaning_id": "cm_ujayla_pace",
      "headword_arabic": "عُجَيْلَى",
      "definition": "A quick pace.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:2287"
      ]
    },
    {
      "meaning_id": "cm_ujjal_foodcake",
      "headword_arabic": "عُجَّالٌ",
      "definition": "A hand-sized cake or portion of dates, dates mixed with parched meal, or dates mixed with dried curd, eaten in haste.",
      "usage_conditions": "The plural عَجَاجِيلُ is also used for elongated portions of dried curd or similar food.",
      "source_refs": [
        "lane:entry:2289"
      ]
    },
    {
      "meaning_id": "cm_ajil_ready",
      "headword_arabic": "عَاجِلٌ",
      "definition": "Present, ready, or not delayed.",
      "usage_conditions": "Especially applied to a price, hire, payment, or merchandise, in contrast with something deferred.",
      "source_refs": [
        "lane:entry:2292"
      ]
    },
    {
      "meaning_id": "cm_ajlal_comparative",
      "headword_arabic": "أَعْجَلُ",
      "definition": "More or most hasty, speedy, or short-lived.",
      "usage_conditions": "A comparative or superlative adjective describing rapidity or brief duration.",
      "source_refs": [
        "lane:entry:2293"
      ]
    },
    {
      "meaning_id": "cm_ajaajil_littleones",
      "headword_arabic": "أَعَاجِلُ",
      "definition": "Little ones.",
      "usage_conditions": "Reported as a plural related to عِجْلٌ; the derivation is attributed rather than universally established.",
      "source_refs": [
        "lane:entry:2295"
      ]
    },
    {
      "meaning_id": "cm_mujal_camel",
      "headword_arabic": "مُعْجَلٌ",
      "definition": "A young camel born before completion of the year and still living.",
      "usage_conditions": "The description concerns premature birth with survival of the young.",
      "source_refs": [
        "lane:entry:2296"
      ]
    },
    {
      "meaning_id": "cm_mujil_premature",
      "headword_arabic": "مُعْجِلٌ",
      "definition": "An animal that gives birth before the full term, or a female camel or cow with its young.",
      "usage_conditions": "The word may refer to a prematurely delivering female or, in a related usage, a cow accompanied by her calf.",
      "source_refs": [
        "lane:entry:2297"
      ]
    },
    {
      "meaning_id": "cm_mujil_cameleap",
      "headword_arabic": "مُعْجِلٌ",
      "definition": "A camel that leaps up when the rider mounts.",
      "usage_conditions": "Also used of a camel that rises before the rider is settled.",
      "source_refs": [
        "lane:entry:2297"
      ]
    },
    {
      "meaning_id": "cm_mujil_palm",
      "headword_arabic": "مُعْجِلٌ",
      "definition": "A palm tree that matures its fruit on its first bearing.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:2297"
      ]
    },
    {
      "meaning_id": "cm_muajjil_provider",
      "headword_arabic": "مُعَجِّلٌ",
      "definition": "One who brings an early provision or milk from animals at pasture to his family.",
      "usage_conditions": "Also used of a pastor who brings such provision or milks the camels once while they are at pasture.",
      "source_refs": [
        "lane:entry:2298"
      ]
    },
    {
      "meaning_id": "cm_muajjil_milker",
      "headword_arabic": "مُعَجِّلٌ",
      "definition": "A pastor who milks camels once while they remain at pasture.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:2298"
      ]
    },
    {
      "meaning_id": "cm_mijal_shortcuts",
      "headword_arabic": "مِعْجَالٌ",
      "definition": "A short cut or one of the nearer routes.",
      "usage_conditions": "The associated plural denotes roads characterized by nearness and shortness.",
      "source_refs": [
        "lane:entry:2299"
      ]
    },
    {
      "meaning_id": "cm_mustaajila_plant",
      "headword_arabic": "مُسْتَعْجِلَةٌ",
      "definition": "A named plant said to fatten women.",
      "usage_conditions": "Also called العُرُوقُ البِيضُ.",
      "source_refs": [
        "lane:entry:2302"
      ]
    }
  ],
