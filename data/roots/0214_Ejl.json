  "other_classical_meanings": [
    {
      "meaning_id": "cm_ajila_present",
      "headword_arabic": "عَجِلَ",
      "definition": "To be present or ready, especially of a price, payment, hire, or similar due.",
      "usage_conditions": "A Classical usage contrasted with being deferred.",
      "source_refs": [
        "lane:entry:2266"
      ]
    },
    {
      "meaning_id": "cm_ajila_turnaside",
      "headword_arabic": "عَجِلَ",
      "definition": "To turn aside from someone or something.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:2266"
      ]
    },
    {
      "meaning_id": "cm_ajjal_advancepay",
      "headword_arabic": "عَجَّلَ",
      "definition": "To give, pay, or bring something promptly or in advance.",
      "usage_conditions": "Especially used of payment, price, hire, or property made ready for the recipient.",
      "source_refs": [
        "lane:entry:2267"
      ]
    },
    {
      "meaning_id": "cm_ajjal_earlyfood",
      "headword_arabic": "عَجَّلَ",
      "definition": "To supply or feed people with an early portion of food.",
      "usage_conditions": "A provision supplied before the ordinary meal is ready.",
      "source_refs": [
        "lane:entry:2267"
      ]
    },
    {
      "meaning_id": "cm_ajjal_quickprep",
      "headword_arabic": "عَجَّلَ",
      "definition": "To prepare or arrange something hastily, including cooking meat quickly or hastening a marriage.",
      "usage_conditions": "These are conventional applications of making an action occur quickly.",
      "source_refs": [
        "lane:entry:2267"
      ]
    },
    {
      "meaning_id": "cm_ajjal_curd",
      "headword_arabic": "عَجَّلَ",
      "definition": "To form dried curd into elongated portions called عَجَاجِيل.",
      "usage_conditions": "A technical food-preparation usage.",
      "source_refs": [
        "lane:entry:2267"
      ]
    },
    {
      "meaning_id": "cm_aajala_compete",
      "headword_arabic": "عَاجَلَ",
      "definition": "To hasten with someone, vie with him in being first, or anticipate him in doing or obtaining something.",
      "usage_conditions": "The construction expresses competing or striving to get ahead in an action or attainment.",
      "source_refs": [
        "lane:entry:2268"
      ]
    },
    {
      "meaning_id": "cm_aajala_punish",
      "headword_arabic": "عَاجَلَ",
      "definition": "To punish someone for an offense without granting delay.",
      "usage_conditions": "Literally, to deal with him hastily in consequence of his sin.",
      "source_refs": [
        "lane:entry:2268"
      ]
    },
    {
      "meaning_id": "cm_aajala_preempt",
      "headword_arabic": "أَعْجَلَ",
      "definition": "To hurry something before its proper time or preempt someone so that an action cannot be completed.",
      "usage_conditions": "The result may be preventing maturation, completion, or payment by acting or causing action too soon.",
      "source_refs": [
        "lane:entry:2269"
      ]
    },
    {
      "meaning_id": "cm_aajala_prematurebirth",
      "headword_arabic": "أَعْجَلَ",
      "definition": "To cause a pregnant animal to give birth before its offspring is mature.",
      "usage_conditions": "Used of a pregnant woman or female camel and the premature delivery of its young.",
      "source_refs": [
        "lane:entry:2269"
      ]
    },
    {
      "meaning_id": "cm_aajala_earlyfruit",
      "headword_arabic": "أَعْجَلَ",
      "definition": "To produce ripe fruit before the usual time.",
      "usage_conditions": "Used of palm trees that mature their fruit early.",
      "source_refs": [
        "lane:entry:2269"
      ]
    },
    {
      "meaning_id": "cm_aajala_cameleap",
      "headword_arabic": "أَعْجَلَ",
      "definition": "To leap up before a rider is firmly seated.",
      "usage_conditions": "Used of a camel that rises or jumps as the rider mounts.",
      "source_refs": [
        "lane:entry:2269"
      ]
    },
    {
      "meaning_id": "cm_taajala_prompt",
      "headword_arabic": "تَعَجَّلَ",
      "definition": "To come quickly or become ready promptly.",
      "usage_conditions": "Used of such things as heat or a price becoming immediately available.",
      "source_refs": [
        "lane:entry:2270"
      ]
    },
    {
      "meaning_id": "cm_taajala_early",
      "headword_arabic": "تَعَجَّلَ",
      "definition": "To occur or come before its proper time.",
      "usage_conditions": "The subject may be an event or thing rather than a person.",
      "source_refs": [
        "lane:entry:2270"
      ]
    },
    {
      "meaning_id": "cm_taajala_advance_receipt",
