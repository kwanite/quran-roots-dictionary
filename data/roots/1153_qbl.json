  "other_classical_meanings": [
    {
      "meaning_id": "cm_qabala_face",
      "headword_arabic": "قَبَلَ",
      "definition": "to face or turn toward, opposite to turning away",
      "usage_conditions": "A Classical verb distinct in vocalization and lexical identity from قَبِلَ, to accept.",
      "source_refs": [
        "lane:entry:20801"
      ]
    },
    {
      "meaning_id": "cm_qabala_requite",
      "headword_arabic": "قَابَلَ",
      "definition": "to requite, return, or compensate one thing with another",
      "usage_conditions": "May describe good for good, evil for evil, or another reciprocal exchange.",
      "source_refs": [
        "lane:entry:20802"
      ]
    },
    {
      "meaning_id": "cm_qabala_compare",
      "headword_arabic": "قَابَلَ",
      "definition": "to compare one thing with another",
      "usage_conditions": "A comparative or contrastive use, distinct from returning or compensating one thing with another.",
      "source_refs": [
        "lane:entry:20802"
      ]
    },
    {
      "meaning_id": "cm_qabala_noble",
      "headword_arabic": "قُوبِلَ",
      "definition": "said of a horse, generous or excellent on both sides of its parentage",
      "usage_conditions": "A specialized description of a horse considered good with respect to both parents.",
      "source_refs": [
        "lane:entry:20802"
      ]
    },
    {
      "meaning_id": "cm_aqbala_causeface",
      "headword_arabic": "أَقْبَلَ",
      "definition": "to make something face or be turned toward something",
      "usage_conditions": "Transitive Form IV construction.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_iqbal_fortune",
      "headword_arabic": "إِقْبَال",
      "definition": "advancing fortune, prosperity, favor, or increasing might",
      "usage_conditions": "Used figuratively of worldly circumstances or good fortune, as opposed to decline or turning away.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_aqbala_favor",
      "headword_arabic": "أَقْبَلَ عَلَيْهِ",
      "definition": "to favor someone or present a favorable aspect to him",
      "usage_conditions": "A conventional interpersonal use implying kind reception or favorable attention.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_aqbala_begin",
      "headword_arabic": "أَقْبَلَ عَلَى",
      "definition": "to set about, take up, or commence an activity",
      "usage_conditions": "Constructed with the object or activity toward which one turns one’s attention.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_aqbala_attack",
      "headword_arabic": "أَقْبَلَ عَلَيْهِ",
      "definition": "to advance against or set upon someone with a weapon or implement",
      "usage_conditions": "The instrument may be expressed with بِـ, as in advancing with a sword, staff, or whip.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_aqbala_apply",
      "headword_arabic": "أَقْبِلْ عَلَى",
      "definition": "to apply or betake oneself to a person, matter, or one’s own affairs",
      "usage_conditions": "An imperative or directive use of turning one’s attention toward something.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_aqbala_recover",
      "headword_arabic": "أَقْبَلَ",
      "definition": "to recover or regain health after emaciation",
      "usage_conditions": "A specialized Classical use describing renewed bodily strength.",
      "source_refs": [
        "lane:entry:20803"
      ]
    },
    {
      "meaning_id": "cm_iqtabala_begin",
      "headword_arabic": "اِقْتَبَلَ",
      "definition": "to begin or commence an affair",
      "usage_conditions": "The object is an affair or undertaking; this is the Form VIII verb, not the Form IV verb.",
      "source_refs": [
        "lane:entry:20805"
      ]
    },
    {
      "meaning_id": "cm_istiqbala_face",
      "headword_arabic": "اِسْتَقْبَلَ",
      "definition": "to face or turn one’s face toward someone or something",
      "usage_conditions": "Includes coming before the face or positioning oneself toward an object.",
      "source_refs": [
        "lane:entry:20806"
      ]
    },
    {
      "meaning_id": "cm_istiqbala_meet",
      "headword_arabic": "اِسْتَقْبَلَ",
      "definition": "to go to meet, encounter, or receive someone or something",
      "usage_conditions": "May take a person, affair, action, or circumstance as its object.",
      "source_refs": [
        "lane:entry:20806"
      ]
    },
    {
      "meaning_id": "cm_istiqbala_anticipate",
      "headword_arabic": "اِسْتَقْبَلَ",
      "definition": "to anticipate, look forward to, or know beforehand",
      "usage_conditions": "Includes anticipating a time or event before its commencement.",
      "source_refs": [
        "lane:entry:20806"
      ]
    },
    {
      "meaning_id": "cm_istiqbala_confront",
      "headword_arabic": "اِسْتَقْبَلَ بِـ",
      "definition": "to confront someone with something, including an accusation or harsh speech",
      "usage_conditions": "The construction بِـ introduces what is presented directly to the person.",
      "source_refs": [
        "lane:entry:20806"
      ]
    },
    {
      "meaning_id": "cm_qabl_spatial_rank",
      "headword_arabic": "قَبْل",
      "definition": "before in place, rank, station, or ordered precedence",
      "usage_conditions": "A broader Classical extension beyond simple temporal precedence.",
      "source_refs": [
        "lane:entry:20807"
      ]
    },
    {
      "meaning_id": "cm_qabal_watering",
      "headword_arabic": "قَبَل",
      "definition": "bringing water over camels’ mouths while they drink",
      "usage_conditions": "A specialized watering practice in which water is drawn over the animals while they are drinking.",
      "source_refs": [
        "lane:entry:20808"
      ]
    },
    {
      "meaning_id": "cm_qabal_manifest",
      "headword_arabic": "بِقَبَل",
      "definition": "manifest, plainly visible, or immediately apparent",
      "usage_conditions": "Used in the expression for truth that is evident to one who sees it.",
      "source_refs": [
        "lane:entry:20808"
      ]
    },
    {
      "meaning_id": "cm_qibala_face_to_face",
      "headword_arabic": "قِبَلًا",
      "definition": "face-to-face or directly encountered",
      "usage_conditions": "A construction describing meeting someone directly.",
      "source_refs": [
        "lane:entry:20809"
      ]
    },
    {
      "meaning_id": "cm_qibala_recent_time",
      "headword_arabic": "ذُو قِبَل",
      "definition": "a time newly begun or a future time about to commence",
      "usage_conditions": "Used in temporal expressions for what is now beginning or is next.",
      "source_refs": [
        "lane:entry:20809"
      ]
    },
    {
      "meaning_id": "cm_qibal_adjacent",
      "headword_arabic": "قِبَل",
      "definition": "the part next to or adjoining a thing",
      "usage_conditions": "A spatial use distinct from directional towardness.",
      "source_refs": [
        "lane:entry:20809"
      ]
    },
    {
      "meaning_id": "cm_qibal_due",
      "headword_arabic": "قِبَل",
      "definition": "property or a claim held by or owing from someone",
      "usage_conditions": "The expression لِي قِبَلَهُ مَالٌ means that property is due to or held with him.",
      "source_refs": [
        "lane:entry:20809"
      ]
    },
    {
      "meaning_id": "cm_qibal_from_side",
      "headword_arabic": "مِنْ قِبَل",
      "definition": "from the side, agency, or source of someone or something",
      "usage_conditions": "May mean from someone’s direction or provenance, or through a bodily side such as the nose.",
      "source_refs": [
        "lane:entry:20809"
      ]
    },
    {
      "meaning_id": "cm_qubul_anatomy",
      "headword_arabic": "قُبُل",
      "definition": "the anterior pudendum or front sexual organ",
      "usage_conditions": "An anatomical term, opposite دُبُر, the posterior part.",
      "source_refs": [
        "lane:entry:20810"
      ]
    },
    {
      "meaning_id": "cm_qibal_sandal",
      "headword_arabic": "قِبَال",
      "definition": "the strap or front fastening of a sandal",
      "usage_conditions": "Also used for the corresponding strap of a shoe or related fastening.",
      "source_refs": [
        "lane:entry:20801",
        "lane:entry:20813"
      ]
    },
    {
      "meaning_id": "cm_qabul_beauty",
      "headword_arabic": "قَبُول",
      "definition": "beauty, grace, comeliness, or pleasing appearance",
      "usage_conditions": "Describes an attractive aspect, appearance, or garment rather than acceptance as an act.",
      "source_refs": [
        "lane:entry:20814"
      ]
    },
    {
      "meaning_id": "cm_qabil_kind",
      "headword_arabic": "قَبِيل",
      "definition": "kind, species, class, or race",
      "usage_conditions": "A classificatory noun distinct from the Quranic social-group use.",
      "source_refs": [
        "lane:entry:20815"
      ]
    },
    {
      "meaning_id": "cm_qubayla_recent",
      "headword_arabic": "قُبَيْل",
      "definition": "a little while ago; shortly before",
      "usage_conditions": "A diminutive temporal expression meaning recently or just previously.",
      "source_refs": [
        "lane:entry:20816"
      ]
    },
    {
      "meaning_id": "cm_qubala_opposite",
      "headword_arabic": "قُبَالَة",
      "definition": "opposite, facing, or in the direction directly before something",
      "usage_conditions": "Includes the place, point, or tract in front of an object.",
      "source_refs": [
        "lane:entry:20817"
      ]
    },
    {
      "meaning_id": "cm_qabila_wellrock",
      "headword_arabic": "قَبِيلَة",
      "definition": "a mass of stone or rock at the mouth of a well",
      "usage_conditions": "A specialized nominal use unrelated to the social-group sense.",
      "source_refs": [
        "lane:entry:20818"
      ]
    },
    {
      "meaning_id": "cm_qabil_nextcoming",
      "headword_arabic": "قَابِل",
      "definition": "nextcoming or following",
      "usage_conditions": "Used of the coming year or the coming night.",
      "source_refs": [
        "lane:entry:20819"
      ]
    },
    {
      "meaning_id": "cm_qabil_susceptible",
      "headword_arabic": "قَابِل",
      "definition": "susceptible to or capable of receiving something",
      "usage_conditions": "The complement introduced by لِـ specifies what can be received or admitted.",
      "source_refs": [
        "lane:entry:20819"
      ]
    },
    {
      "meaning_id": "cm_qabil_winning_arrow",
      "headword_arabic": "قَابِل",
      "definition": "an arrow that wins in the game of maysir",
      "usage_conditions": "A technical gaming term contrasted with the corresponding losing or rearward designation.",
      "source_refs": [
        "lane:entry:20819"
      ]
    },
    {
      "meaning_id": "cm_qabila_wife",
      "headword_arabic": "قَابِلَة",
      "definition": "wife",
      "usage_conditions": "A specialized feminine nominal use.",
      "source_refs": [
        "lane:entry:20819"
      ]
    },
    {
      "meaning_id": "cm_qabiliyya_susceptibility",
      "headword_arabic": "قَابِلِيَّة",
      "definition": "the quality of admitting, receiving, or being susceptible",
      "usage_conditions": "An abstract noun for receptivity or capacity to receive an effect.",
      "source_refs": [
        "lane:entry:20820"
      ]
    },
    {
      "meaning_id": "cm_aqbal_comparative",
      "headword_arabic": "أَقْبَل",
      "definition": "more or most inclined to accept admonition",
      "usage_conditions": "A comparative or superlative adjective with لِـ introducing what is accepted.",
      "source_refs": [
        "lane:entry:20821"
      ]
    },
    {
      "meaning_id": "cm_muqbil_youth",
      "headword_arabic": "مُقْبِل",
      "definition": "in the fresh or advancing period of youth",
      "usage_conditions": "Describes a person or youth not yet marked by the effects of old age.",
      "source_refs": [
        "lane:entry:20823"
      ]
    },
    {
      "meaning_id": "cm_muqabbal_mouth",
      "headword_arabic": "مُقَبَّل",
      "definition": "the part of the mouth or front teeth that is kissed",
      "usage_conditions": "A specialized description of the front of the mouth or teeth.",
      "source_refs": [
        "lane:entry:20824"
      ]
    },
    {
      "meaning_id": "cm_muqabal_opposite_houses",
      "headword_arabic": "مُقَابَل",
      "definition": "opposite or facing, as of houses or dwellings",
      "usage_conditions": "Used of things positioned front-to-front rather than back-to-back.",
      "source_refs": [
        "lane:entry:20825"
      ]
    },
    {
      "meaning_id": "cm_muqabal_noble",
      "headword_arabic": "مُقَابَل",
      "definition": "noble on both the father’s and mother’s side",
      "usage_conditions": "A genealogical or evaluative description of excellence from both parental lines.",
      "source_refs": [
        "lane:entry:20825"
      ]
    },
    {
      "meaning_id": "cm_muqabala_comparison",
      "headword_arabic": "مُقَابَلَة",
      "definition": "comparison with or juxtaposition against something",
      "usage_conditions": "The phrase فِي مُقَابَلَةِ كَذَا means in comparison with or in relation to such a thing.",
      "source_refs": [
        "lane:entry:20825"
      ]
    },
    {
      "meaning_id": "cm_mustaqbal_anticipated",
      "headword_arabic": "مُسْتَقْبَل",
      "definition": "anticipated, looked forward to, or begun",
      "usage_conditions": "A distinct nominal/adjectival form with fatḥ on the ب, not the active participle مُسْتَقْبِل.",
      "source_refs": [
