{
  "root": "sdd",
  "arabic": "سدد",
  "root_idea": {
    "summary": "The root centers on closing or filling a gap and thereby making something firm, complete, and properly aligned.",
    "development": "From sealing a breach, the root develops meanings of barrier, stopper, and obstruction; figuratively it extends to supplying a lack and to rightness or sound direction, as though there were no defect or gap.",
    "source_refs": [
      "maqayis:row:2390",
      "mufradat:row:673"
    ]
  },
  "qac_form_accounting": [
    {
      "form_group_id": "qac-form:sdd:sadiyd:nominal:-",
      "disposition": "DISPLAY",
      "target_public_form_id": "sdd-sadiyd",
      "reason": "The Quranic adjective سَدِيد is a distinct lexical form meaning right, sound, or properly directed speech."
    },
    {
      "form_group_id": "qac-form:sdd:sad~:nominal:-",
      "disposition": "DISPLAY",
      "target_public_form_id": "sdd-sadd",
      "reason": "The Quranic noun سَدّ is a distinct lexical form denoting a barrier or obstruction."
    }
  ],
  "quranic_forms": [
    {
      "public_form_id": "sdd-sadiyd",
      "form_group_ids": [
        "qac-form:sdd:sadiyd:nominal:-"
      ],
      "headword_arabic": "سَدِيد",
      "public_pos_label": "Adjective",
      "verb_form": null,
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "sdd-sadiyd-1",
          "definition": "Right, sound, and properly directed; specifically, of speech, correct and appropriate.",
          "usage_conditions": "In the Quran, the adjective qualifies قول, meaning speech that is right, sound, or appropriate.",
          "source_refs": [
            "lane:entry:40639"
          ]
        }
      ],
      "quran_examples": [
