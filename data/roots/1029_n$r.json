  "other_classical_meanings": [
    {
      "meaning_id": "cm_nashara_publish_news",
      "headword_arabic": "نَشَرَ",
      "definition": "To spread or publish news.",
      "usage_conditions": "A conventional figurative use with news or reports as the object.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_scatter_people",
      "headword_arabic": "نَشَرَ",
      "definition": "To scatter or disperse people or livestock.",
      "usage_conditions": "Especially used of releasing people, sheep, goats, or camels after they had been confined.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_sprinkle_mist",
      "headword_arabic": "نَشَرَ",
      "definition": "To sprinkle water; of wind, to disperse mist or clouds.",
      "usage_conditions": "These are related weather and water uses of the Form I verb.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_charm_away",
      "headword_arabic": "نَشَرَ",
      "definition": "To charm away sickness, madness, or demonic possession.",
      "usage_conditions": "Used with عن and associated with a نُشْرَة, a charm or amulet.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_strengthen_bone",
      "headword_arabic": "نَشَرَ",
      "definition": "Of nursing, to strengthen a bone.",
      "usage_conditions": "A specialized construction describing the effect of suckling on the bone.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_regrow_herbage",
      "headword_arabic": "نَشَرَ",
      "definition": "Of herbage or a plant, to revive and grow again after rain.",
      "usage_conditions": "Includes the greening of dried pasture and the putting forth of leaves or new growth.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_saw_wood",
      "headword_arabic": "نَشَرَ",
      "definition": "To saw or cut wood.",
      "usage_conditions": "The action is performed with a مِنْشَار, a saw.",
      "source_refs": [
        "lane:entry:43722"
      ]
    },
    {
      "meaning_id": "cm_nashara_with_someone",
      "headword_arabic": "نَاشَرَ",
      "definition": "To spread or unfold garments together with someone.",
      "usage_conditions": "A Form III construction expressing shared participation in spreading the garments.",
      "source_refs": [
        "lane:entry:43724"
      ]
    },
    {
      "meaning_id": "cm_tanashara_clothes",
      "headword_arabic": "تَنَاشَرَ",
      "definition": "To spread or unfold garments mutually.",
      "usage_conditions": "A reciprocal Form VI construction.",
      "source_refs": [
        "lane:entry:43727"
      ]
    },
    {
      "meaning_id": "cm_intashara_news",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of news, to spread or become public.",
      "usage_conditions": "A figurative Form VIII use with news spreading among people.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_odor",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of an odor, to diffuse or spread.",
      "usage_conditions": "A figurative Form VIII use describing diffusion through an area.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_day_extend",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of the day or another extended thing, to lengthen or extend.",
      "usage_conditions": "A figurative extension of outward or longitudinal spreading.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_tendon_swelling",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of an animal’s sinew or tendon, to swell or become inflated from fatigue.",
      "usage_conditions": "A technical veterinary use; the condition may involve injury or displacement of the tendon.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_lust",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "To become sexually aroused; of the penis, to become erect.",
      "usage_conditions": "An anatomical and sexual use of the Form VIII verb.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_water",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of water, to become sprinkled or dispersed.",
      "usage_conditions": "A water-related use of the intransitive Form VIII.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_livestock",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of sheep, goats, or camels, to become scattered after confinement.",
      "usage_conditions": "The scattering may result from the animals being released or from the negligence of their herder.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_affairs_disordered",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of affairs or circumstances, to become disorganized or unsettled.",
      "usage_conditions": "A figurative use equivalent to becoming broken up or dispersed.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_journey",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "To set out and proceed on a journey.",
      "usage_conditions": "A conventional Form VIII use in which movement outward is foregrounded.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_intashara_wolf_incursion",
      "headword_arabic": "اِنْتَشَرَ",
      "definition": "Of a wolf, to make an incursion among sheep or goats.",
      "usage_conditions": "A specialized construction describing movement into a flock.",
      "source_refs": [
        "lane:entry:43728"
      ]
    },
    {
      "meaning_id": "cm_istanshara_request_unfolding",
      "headword_arabic": "اِسْتَنْشَرَ",
      "definition": "To ask someone to unfold or explain something.",
      "usage_conditions": "The person asked is the source from whom the thing is to be unfolded or made clear.",
      "source_refs": [
        "lane:entry:43729"
      ]
    },
    {
      "meaning_id": "cm_nashr_odor",
      "headword_arabic": "نَشْر",
      "definition": "Odor or scent, especially a pleasant scent.",
      "usage_conditions": "The term may also denote odor generally, including bodily odor in specified expressions.",
      "source_refs": [
        "lane:entry:43730"
      ]
    },
    {
      "meaning_id": "cm_nashr_regrown_herbage",
      "headword_arabic": "نَشْر",
      "definition": "Herbage that revives after drying when rain falls.",
      "usage_conditions": "This may refer to regrown pasture or to the plant growth produced by seasonal rain; some descriptions note its harmfulness to livestock when it first appears.",
      "source_refs": [
        "lane:entry:43730"
      ]
    },
    {
      "meaning_id": "cm_nashr_life",
      "headword_arabic": "نَشْر",
      "definition": "Life.",
      "usage_conditions": "A lexical noun meaning attested independently of the Quranic noun نُشُور for resurrection.",
      "source_refs": [
        "lane:entry:43730"
      ]
    },
    {
      "meaning_id": "cm_nashar_spread_state",
      "headword_arabic": "نَشَر",
      "definition": "A spread, unfolded, or scattered state; something spread out.",
      "usage_conditions": "This noun can function as a passive-like form and is explicitly associated with مَنْشُور and مُنْتَشِر.",
      "source_refs": [
        "lane:entry:43731"
      ]
    },
    {
      "meaning_id": "cm_nashar_sprinkled_water",
      "headword_arabic": "نَشَر",
      "definition": "Sprinkled water.",
      "usage_conditions": "A noun for water dispersed in the course of ablution or a similar act.",
      "source_refs": [
        "lane:entry:43731"
      ]
    },
    {
      "meaning_id": "cm_nashar_discomposed_affairs",
      "headword_arabic": "نَشَر",
      "definition": "A discomposed or disorganized state of affairs.",
      "usage_conditions": "A figurative use in which what has been unfolded is restored to order.",
      "source_refs": [
        "lane:entry:43731"
      ]
    },
    {
      "meaning_id": "cm_nushra_charm",
      "headword_arabic": "نُشْرَة",
      "definition": "A charm, amulet, or ritual recitation used to cure sickness or possession.",
      "usage_conditions": "The term describes a treatment understood as dispersing the malady; the sources also report criticism of or disagreement about this practice.",
      "source_refs": [
