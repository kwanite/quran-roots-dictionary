    {
      "public_form_id": "form_istaghsha",
      "form_group_ids": [
        "qac-form:g$w:{sotago$a:verb:X"
      ],
      "headword_arabic": "اِسْتَغْشَى",
      "public_pos_label": "Verb · Form X",
      "verb_form": "X",
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "form_istaghsha_s1",
          "definition": "To cover oneself with a garment, especially over the ears, in order not to see or hear.",
          "usage_conditions": "The Quranic construction denotes self-covering as a sign of refusing to listen or attend.",
          "source_refs": [
            "lane:entry:29349",
            "mufradat:row:1052"
          ]
        },
        {
          "sense_id": "form_istaghsha_s2",
          "definition": "To set off or run away, by an idiomatic allusion to throwing on or taking up one's garment.",
          "usage_conditions": "An alternative interpretation reported for the Quranic expression; it is distinct from the literal self-covering interpretation.",
          "source_refs": [
            "lane:entry:29349",
            "mufradat:row:1052"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "11:5",
          "word_location": "11:5:9",
          "sense_ids": [
            "form_istaghsha_s1",
            "form_istaghsha_s2"
          ]
        },
        {
          "verse_key": "71:7",
          "word_location": "71:7:10",
          "sense_ids": [
            "form_istaghsha_s1",
            "form_istaghsha_s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "form_ghashiya",
      "form_group_ids": [
        "qac-form:g$w:ga`$iyap:nominal:-"
      ],
      "headword_arabic": "غَاشِيَةٌ",
      "public_pos_label": "Active participle (substantivized)",
      "verb_form": null,
      "occurrence_count": 3,
      "senses": [
        {
          "sense_id": "form_ghashiya_s1",
          "definition": "A covering, or that which covers; coverings.",
          "usage_conditions": "The Quranic plural غَوَاشٍ denotes coverings, while the singular is also used substantively for something that comes over and covers.",
          "source_refs": [
            "lane:entry:29359",
            "mufradat:row:1052"
          ]
        },
        {
          "sense_id": "form_ghashiya_s2",
          "definition": "An overwhelming event, calamity, or general affliction; specifically, the Resurrection in al-Ghāshiyah.",
          "usage_conditions": "The name can refer to the Resurrection because it overwhelms and encompasses creation; an interpretation referring to Hellfire is also reported. It can likewise denote punishment or calamity of universal extent.",
          "source_refs": [
            "lane:entry:29359",
            "mufradat:row:1052"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "7:41",
          "word_location": "7:41:7",
          "sense_ids": [
            "form_ghashiya_s1"
          ]
        },
        {
          "verse_key": "12:107",
          "word_location": "12:107:4",
          "sense_ids": [
            "form_ghashiya_s2"
          ]
        },
        {
          "verse_key": "88:1",
          "word_location": "88:1:4",
          "sense_ids": [
            "form_ghashiya_s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "form_ghishawa",
      "form_group_ids": [
        "qac-form:g$w:gi$a`wap:nominal:-"
      ],
      "headword_arabic": "غِشَاوَةٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "form_ghishawa_s1",
          "definition": "A covering, veil, or film over the eyes or heart.",
          "usage_conditions": "The Quranic usage refers to a covering over the eyes and, figuratively, a covering or rust-like barrier over the heart.",
          "source_refs": [
            "lane:entry:29357",
            "mufradat:row:1052"
          ]
        }
      ],
      "quran_examples": [
        {
