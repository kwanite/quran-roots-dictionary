  "other_classical_meanings": [
    {
      "meaning_id": "cm_approach",
      "headword_arabic": "غَشِيَ",
      "definition": "To come to, visit, or approach someone or a place; euphemistically, to have sexual intercourse.",
      "usage_conditions": "The sexual use is a metonymic extension of coming to or approaching, and is distinct from the Quranic Form V construction listed above.",
      "source_refs": [
        "lane:entry:29345"
      ]
    },
    {
      "meaning_id": "cm_engage",
      "headword_arabic": "غَشِيَ",
      "definition": "To engage in, occupy oneself with, personally undertake, or conduct a matter; extended to undertaking forbidden acts, ruling with equity or injustice, and plunging into wars.",
      "usage_conditions": "These are extended uses of coming into direct contact or involvement with a thing or activity.",
      "source_refs": [
        "lane:entry:29345"
      ]
    },
    {
      "meaning_id": "cm_light",
      "headword_arabic": "غَشِيَ / غَشَّى",
      "definition": "Of light, to come upon or overspread with an overpowering effect, obscuring or dazzling the sight.",
      "usage_conditions": "A specialized use describing the effect of light on a person or the eye.",
      "source_refs": [
        "lane:entry:29345",
        "lane:entry:29346"
      ]
    },
    {
      "meaning_id": "cm_strike",
      "headword_arabic": "غَشِيَ / غَشَّى",
      "definition": "To strike someone with a whip; to flog.",
      "usage_conditions": "Used with the whip as the instrument.",
      "source_refs": [
        "lane:entry:29345",
        "lane:entry:29346"
      ]
    },
    {
      "meaning_id": "cm_swoon",
      "headword_arabic": "غُشِيَ عَلَيْهِ / غَشْيَةٌ",
      "definition": "A swoon or state of being senseless, involving suspension or clouding of the faculties; also a clouding of understanding at death or a slight attack of fever.",
      "usage_conditions": "The nominal forms غَشْيَةٌ and غُشْيَةٌ describe the state or its occurrence, including specialized expressions for death and fever.",
      "source_refs": [
        "lane:entry:29345",
        "lane:entry:29353"
      ]
    },
    {
      "meaning_id": "cm_equip",
      "headword_arabic": "غَشَّى",
      "definition": "To equip or furnish someone with a sword or whip, as one puts such an item upon him.",
      "usage_conditions": "A clothing-like extension of the covering sense.",
      "source_refs": [
        "lane:entry:29346"
      ]
    },
    {
      "meaning_id": "cm_causative_come",
      "headword_arabic": "أَغْشَى",
      "definition": "To cause a person or thing to come to another.",
      "usage_conditions": "This is distinct from the causative covering and overwhelming construction attested in Quranic usage.",
      "source_refs": [
        "lane:entry:29347"
      ]
    },
    {
      "meaning_id": "cm_ghishaa",
      "headword_arabic": "غِشَاءٌ",
      "definition": "A cover or covering, including the covering of the heart, the skin-like covering around it, a saddle covering, or a sword cover or sheath.",
      "usage_conditions": "A general noun for an enclosing cover, with anatomical and equipment-related applications.",
      "source_refs": [
        "lane:entry:29356"
      ]
    },
    {
      "meaning_id": "cm_ghashiya_technical",
      "headword_arabic": "غَاشِيَةٌ",
      "definition": "A covering-piece for a saddle or sword; technically, the iron fitting above the rear part of a camel saddle, and also a skin or other covering of a sword.",
      "usage_conditions": "These are specialized object-related applications of the covering noun and are not the Quranic overwhelming-event sense.",
      "source_refs": [
        "lane:entry:29359"
      ]
    },
    {
      "meaning_id": "cm_ghashiya_disease",
      "headword_arabic": "غَاشِيَةٌ",
      "definition": "A particular disease attacking the interior of the body, especially the belly or chest.",
      "usage_conditions": "A technical medical use.",
      "source_refs": [
        "lane:entry:29359"
      ]
    },
    {
      "meaning_id": "cm_ghashiya_visitors",
      "headword_arabic": "غَاشِيَةٌ",
      "definition": "Petitioners, visitors, friends, guests, dependants, or other people who come repeatedly to someone seeking gifts, favor, or hospitality.",
      "usage_conditions": "A collective substantive use for people who habitually resort to a person.",
      "source_refs": [
        "lane:entry:29359"
      ]
    },
    {
      "meaning_id": "cm_gashaa_whiteness",
      "headword_arabic": "غَشًا",
      "definition": "The whiteness of the head or face of a horse or other animal.",
      "usage_conditions": "A descriptive nominal use, especially of an animal's coloring.",
      "source_refs": [
        "lane:entry:29350"
      ]
    },
    {
      "meaning_id": "cm_gashw_lote",
      "headword_arabic": "غَشْوٌ",
      "definition": "The fruit of the lote tree; in a related usage, a lote tree itself.",
      "usage_conditions": "The singular noun غَشْوَةٌ can denote a lote tree.",
      "source_refs": [
        "lane:entry:29351"
      ]
    },
    {
      "meaning_id": "cm_aghshe_adjective",
      "headword_arabic": "أَغْشَى",
      "definition": "Having the whole head or face white, or having a broad white blaze covering the face, said of a horse or another animal.",
      "usage_conditions": "An adjectival description of animal coloring, with a feminine form reported for a goat.",
      "source_refs": [
        "lane:entry:29360"
      ]
    }
  ],
