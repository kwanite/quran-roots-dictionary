          "sense_ids": [
            "form_ghishawa_s1"
          ]
        },
        {
          "verse_key": "45:23",
          "word_location": "45:23:17",
          "sense_ids": [
            "form_ghishawa_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "form_maghsiyy",
      "form_group_ids": [
        "qac-form:g$w:mago$iY~:nominal:-"
      ],
      "headword_arabic": "مَغْشِيٌّ",
      "public_pos_label": "Passive participle",
