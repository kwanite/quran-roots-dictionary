  "quranic_forms": [
    {
      "public_form_id": "form_gashiya",
      "form_group_ids": [
        "qac-form:g$w:ga$iya:verb:I"
      ],
      "headword_arabic": "غَشِيَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 13,
      "senses": [
        {
          "sense_id": "form_gashiya_s1",
          "definition": "To cover, conceal, or overspread.",
          "usage_conditions": "Used of a thing, force, or phenomenon that comes over another and covers it; this includes the spreading darkness of night and the covering of a visible object.",
          "source_refs": [
            "lane:entry:29345",
            "mufradat:row:1052"
          ]
        },
        {
          "sense_id": "form_gashiya_s2",
          "definition": "To come upon, overtake, or overwhelm.",
          "usage_conditions": "Used of an event, force, or condition that descends upon or overtakes someone or something, often with an overpowering result.",
          "source_refs": [
            "lane:entry:29345",
            "mufradat:row:1052"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "20:78",
          "word_location": "20:78:8",
          "sense_ids": [
            "form_gashiya_s2"
