      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "form_maghsiyy_s1",
          "definition": "Swooning or rendered senseless; overcome by faintness.",
          "usage_conditions": "Used in the Quranic phrase مَغْشِيٌّ عَلَيْهِ مِنَ الْمَوْتِ, describing one affected by a swoon or loss of consciousness associated with death.",
          "source_refs": [
            "lane:entry:29361",
            "mufradat:row:1052"
          ]
        }
      ],
      "quran_examples": [
