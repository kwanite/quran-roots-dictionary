      "senses": [
        {
          "sense_id": "form_agsha_s1",
          "definition": "To cause something to cover or enshroud something else.",
          "usage_conditions": "A causative construction in which one thing is made to cover, veil, or overspread another; Quranic voice and aspect vary by occurrence.",
          "source_refs": [
            "lane:entry:29347"
          ]
        },
        {
          "sense_id": "form_agsha_s2",
          "definition": "To cause an event or condition to come upon, overtake, or overwhelm.",
          "usage_conditions": "A causative construction for an event or force descending upon someone or something, including the Quranic reading tradition associated with this usage.",
          "source_refs": [
            "lane:entry:29347"
          ]
        }
