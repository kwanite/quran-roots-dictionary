      "senses": [
        {
          "sense_id": "form_gashsha_s1",
          "definition": "To cover something or place a covering over it.",
          "usage_conditions": "A causative/intensive covering construction, including putting a covering over the eyes or over a group of people.",
          "source_refs": [
