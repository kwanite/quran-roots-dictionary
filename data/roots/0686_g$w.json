{
  "root": "g$w",
  "arabic": "غشو",
  "root_idea": {
    "summary": "The root centers on something coming upon another as a covering: concealment, envelopment, or being overtaken.",
    "development": "The covering image extends to events that overwhelm, coverings placed over eyes or ears, causal and reflexive covering, sexual approach as a euphemism for coming to, and things or persons that repeatedly come upon others.",
    "source_refs": [
      "mufradat:row:1052"
    ]
  },
