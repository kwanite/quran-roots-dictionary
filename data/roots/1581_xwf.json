  "quranic_forms": [
    {
      "public_form_id": "xwf_f1_khafa",
      "form_group_ids": [
        "qac-form:xwf:xaAfa:verb:I"
      ],
      "headword_arabic": "خَافَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 83,
      "senses": [
        {
          "sense_id": "xwf_f1_s1",
          "definition": "To fear, be afraid of, or be concerned about; to fear for someone or something.",
          "usage_conditions": "May take a direct object for what is feared, مِنْ for the source or circumstance feared, and عَلَى for concern on behalf of someone or something. In reference to God, the fear is presented as reverent apprehension expressed through avoiding disobedience and choosing obedience rather than mere panic.",
          "source_refs": [
            "lane:entry:20289",
            "mufradat:row:444"
          ]
        },
        {
          "sense_id": "xwf_f1_s2",
          "definition": "To know, recognize, or judge from indications that a harmful or improper condition exists.",
          "usage_conditions": "Especially attested in conditional constructions such as “if you fear,” where the verb can mean recognizing or becoming aware of a likely problem rather than experiencing fright.",
          "source_refs": [
            "lane:entry:20289",
            "mufradat:row:444"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:229",
          "word_location": "2:229:18",
          "sense_ids": [
            "xwf_f1_s1"
          ]
        },
        {
          "verse_key": "3:175",
          "word_location": "3:175:8",
          "sense_ids": [
            "xwf_f1_s1"
          ]
        },
        {
          "verse_key": "4:3",
          "word_location": "4:3:2",
          "sense_ids": [
            "xwf_f1_s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "xwf_f2_khawwafa",
      "form_group_ids": [
        "qac-form:xwf:yuxaw~ifu:verb:II"
      ],
      "headword_arabic": "خَوَّفَ",
      "public_pos_label": "Verb · Form II",
      "verb_form": "II",
      "occurrence_count": 4,
      "senses": [
        {
          "sense_id": "xwf_f2_s1",
          "definition": "To put fear into someone, frighten or threaten them, or make someone or something a source of fear to others.",
          "usage_conditions": "The causative relation may be understood as directly frightening someone or as causing people to fear through another person or thing. In divine discourse, the action may function as a warning intended to urge precaution.",
          "source_refs": [
            "lane:entry:20290",
            "mufradat:row:444"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "3:175",
