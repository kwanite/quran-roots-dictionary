{
  "root": "xwf",
  "arabic": "خوف",
  "root_idea": {
    "summary": "The root centers on dread, fright, and apprehension in response to a feared possibility or danger.",
    "development": "From this core, the lexicon develops uses for apprehending a harmful possibility, reverent fear expressed through obedient restraint, causing fear, and warning. The Form V branch also has a distinct sense of diminishing or taking away little by little; this is treated as a consonantal development related to تنقّص.",
    "source_refs": [
      "maqayis:row:1674"
    ]
  },
