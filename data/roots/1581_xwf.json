          "word_location": "17:60:20",
          "sense_ids": [
            "xwf_f2_s1"
          ]
        },
        {
          "verse_key": "39:16",
          "word_location": "39:16:11",
          "sense_ids": [
            "xwf_f2_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "xwf_takhawwuf",
      "form_group_ids": [
        "qac-form:xwf:taxaw~uf:nominal:-"
      ],
      "headword_arabic": "تَخَوُّف",
      "public_pos_label": "Verbal noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "xwf_takhawwuf_s1",
          "definition": "Gradual diminution, wasting, or taking away little by little.",
          "usage_conditions": "Describes loss occurring progressively, including the reduction of bodies, possessions, livestock, or produce by stages.",
          "source_refs": [
            "lane:entry:20293"
          ]
        },
        {
          "sense_id": "xwf_takhawwuf_s2",
          "definition": "The emergence or outward manifestation of fear in a person.",
          "usage_conditions": "A Quran-attested interpretation of the verbal noun distinct from the sense of gradual diminution.",
          "source_refs": [
            "mufradat:row:444"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "16:47",
          "word_location": "16:47:4",
          "sense_ids": [
            "xwf_takhawwuf_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "xwf_takhwif",
      "form_group_ids": [
        "qac-form:xwf:taxowiyf:nominal:-"
      ],
      "headword_arabic": "تَخْوِيف",
      "public_pos_label": "Verbal noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "xwf_takhwif_s1",
          "definition": "The putting of someone into fear: frightening, threatening, or warning.",
          "usage_conditions": "In divine usage, the warning is intended to prompt people to guard themselves against danger or wrongdoing.",
          "source_refs": [
            "lane:entry:20290",
            "mufradat:row:444"
          ]
        }
      ],
      "quran_examples": [
