      "headword_arabic": "خِيفَة",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 6,
      "senses": [
        {
          "sense_id": "xwf_khifa_s1",
          "definition": "A state or condition of fear; a felt or abiding fear.",
          "usage_conditions": "Names the state in which a person remains fearful and can be used for reverent fear or fear directed toward a perceived danger.",
          "source_refs": [
            "lane:entry:20298",
            "mufradat:row:444"
          ]
        }
      ],
