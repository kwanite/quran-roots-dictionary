    },
    {
      "public_form_id": "xwf_khawf",
      "form_group_ids": [
        "qac-form:xwf:xawof:nominal:-"
      ],
      "headword_arabic": "خَوْف",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 26,
      "senses": [
        {
          "sense_id": "xwf_khawf_s1",
          "definition": "Fear, dread, or apprehension of a feared harm or danger.",
          "usage_conditions": "Used for worldly and otherworldly fear. Fear of God is also construed as reverent apprehension manifested in restraint from wrongdoing and commitment to obedience.",
          "source_refs": [
            "lane:entry:20295",
            "mufradat:row:444"
          ]
        },
        {
          "sense_id": "xwf_khawf_s2",
          "definition": "Slaughter or killing, understood as a feared calamity.",
          "usage_conditions": "A Quran-attested extended interpretation in the expression describing trial by fear and slaughter.",
          "source_refs": [
            "lane:entry:20295"
          ]
        },
        {
          "sense_id": "xwf_khawf_s3",
          "definition": "Fighting or battle.",
          "usage_conditions": "A Quran-attested use in a construction referring to the onset of fighting.",
          "source_refs": [
            "lane:entry:20295"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "32:16",
          "word_location": "32:16:7",
          "sense_ids": [
            "xwf_khawf_s1"
          ]
        },
        {
