      "verb_form": null,
      "occurrence_count": 3,
      "senses": [
        {
          "sense_id": "xwf_khaif_s1",
          "definition": "Being afraid, fearful, frightened, or terrified.",
          "usage_conditions": "An active participle describing a person or group experiencing fear; the evidence does not impose a restriction on the type of object feared.",
          "source_refs": [
            "lane:entry:20303"
          ]
        }
      ],
