  "other_classical_meanings": [
    {
      "meaning_id": "xwf_cm_outfear",
      "headword_arabic": "خَافَ",
      "definition": "To exceed another in fear; to be more fearful than him.",
      "usage_conditions": "A comparative or reciprocal construction describing which party is the more fearful.",
      "source_refs": [
        "lane:entry:20289"
      ]
    },
    {
      "meaning_id": "xwf_cm_form2_diminish",
      "headword_arabic": "خَوَّفَ",
      "definition": "To diminish, lessen, or take something away.",
      "usage_conditions": "A Classical Form II usage distinct from the causative sense represented in the Quranic Form II form.",
      "source_refs": [
        "lane:entry:20290"
      ]
    },
    {
      "meaning_id": "xwf_cm_form2_sheep",
      "headword_arabic": "خَوَّفَ",
      "definition": "To send away sheep or goats flock by flock.",
      "usage_conditions": "A specialized livestock-related usage.",
      "source_refs": [
        "lane:entry:20290"
      ]
    },
    {
      "meaning_id": "xwf_cm_form4_causefear",
      "headword_arabic": "أَخَافَ",
      "definition": "To cause or make someone fear; to frighten or terrify, or to render a place or situation insecure.",
      "usage_conditions": "Can take a person as the one caused to fear, or describe a frontier, road, wall, or event that gives rise to fear. This Classical Form IV item is kept separate from the Quranic Form II headword.",
      "source_refs": [
        "lane:entry:20292"
      ]
    },
    {
      "meaning_id": "xwf_cm_fearful_man",
      "headword_arabic": "خَافٌ",
      "definition": "A very fearful or timid man.",
      "usage_conditions": "A lexical noun describing a person characterized by timidity.",
      "source_refs": [
        "lane:entry:20294"
      ]
    },
    {
      "meaning_id": "xwf_cm_hide",
      "headword_arabic": "خَوْفٌ",
      "definition": "A red hide cut into thong-like strips and ornamented; a dialectal form of حَوْفٌ.",
      "usage_conditions": "A rare material-culture noun, distinguished from the ordinary noun خَوْفٌ “fear.”",
      "source_refs": [
        "lane:entry:20295"
      ]
    },
    {
      "meaning_id": "xwf_cm_honey_container",
      "headword_arabic": "خَافَةٌ",
      "definition": "A hide garment or container used by a honey collector; also a hide basket or receptacle for gathered fruit.",
      "usage_conditions": "The term covers the protective garment worn among bees as well as associated hide containers.",
      "source_refs": [
        "lane:entry:20297"
      ]
    },
    {
      "meaning_id": "xwf_cm_grain_envelope",
      "headword_arabic": "خَافَةُ الزَّرْعِ",
      "definition": "The envelope or protective covering of a grain of seed-produce.",
      "usage_conditions": "A reported lexical use whose commonly known reading is elsewhere given as خَامَة.",
      "source_refs": [
        "lane:entry:20297"
      ]
    },
    {
      "meaning_id": "xwf_cm_noise",
      "headword_arabic": "خَوَافٌ",
      "definition": "Vociferation, clamour, or confused noise made by a company of men.",
      "usage_conditions": "A collective sound noun, not a synonym for ordinary fear.",
      "source_refs": [
        "lane:entry:20299"
      ]
    },
    {
      "meaning_id": "xwf_cm_black_bird",
      "headword_arabic": "خَوَّافٌ",
      "definition": "A certain black bird.",
      "usage_conditions": "The attestation is reported tentatively, with its naming left unexplained.",
      "source_refs": [
        "lane:entry:20302"
      ]
    },
    {
      "meaning_id": "xwf_cm_mukhaf_road",
      "headword_arabic": "طَرِيقٌ مُخَافٌ",
      "definition": "A road whose people or passengers are made afraid by robbers; an unsafe road.",
      "usage_conditions": "The epithet is used with the road understood through the people endangered on it.",
      "source_refs": [
        "lane:entry:20304"
      ]
    },
    {
      "meaning_id": "xwf_cm_makhuf",
      "headword_arabic": "مَخُوفٌ",
      "definition": "Feared or dangerous; something feared, including a dangerous road, animal, serpent, fire, wall, pain, or affair.",
      "usage_conditions": "With عَلَى, a person may be described as feared for another’s property because he may consume or misuse it.",
      "source_refs": [
        "lane:entry:20305"
      ]
    },
    {
      "meaning_id": "xwf_cm_mukhif",
      "headword_arabic": "مُخِيفٌ",
      "definition": "Causing fear or formidable to whoever encounters it; a frightening thing such as a lion.",
      "usage_conditions": "Describes the fear-producing rather than merely feared quality of a thing, event, pain, or animal.",
      "source_refs": [
        "lane:entry:20307"
      ]
    },
    {
      "meaning_id": "xwf_cm_akhwaf",
      "headword_arabic": "أَخْوَفٌ",
      "definition": "More or most formidable, fearful, or feared.",
      "usage_conditions": "An anomalous superlative adjective used with a following comparison or object of fear.",
      "source_refs": [
        "lane:entry:20308"
      ]
    },
    {
      "meaning_id": "xwf_cm_makhafa_extensions",
      "headword_arabic": "مَخَافَةٌ",
      "definition": "A cause of fear or a place of fear; plural مَخَاوِفُ.",
      "usage_conditions": "The ordinary infinitival use is not separated here from the Quranic fear branch; this entry records its independently attested extended nominal uses.",
      "source_refs": [
        "lane:entry:20309"
      ]
    }
  ],
