{
  "root": "rEb",
  "arabic": "رعب",
  "root_idea": {
    "summary": "The root expresses three attested semantic orientations: fear, filling, and cutting.",
    "development": "The fear branch is associated with being overcome by a fullness of fear; related Classical extensions describe filling a container or valley and cutting a mass into pieces. These root-level developments do not make the latter branches Quranic meanings of رُعْب.",
    "source_refs": [
      "maqayis:row:2065",
      "mufradat:row:559"
    ]
  },
