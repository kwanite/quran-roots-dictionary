  "other_classical_meanings": [
    {
      "meaning_id": "c-rhyme-easy",
      "headword_arabic": "ذَلَّ",
      "definition": "To come easily or readily, said of rhymes to a poet.",
      "usage_conditions": "A figurative literary use.",
      "source_refs": [
        "lane:entry:21637"
      ]
    },
    {
      "meaning_id": "c-trough-broken",
      "headword_arabic": "ذَلَّ",
      "definition": "To become much broken or demolished at the edge.",
      "usage_conditions": "Said of a watering-trough, tank, or its upper edge.",
      "source_refs": [
        "lane:entry:21637"
      ]
    },
    {
      "meaning_id": "c-formII-roadsmooth",
      "headword_arabic": "ذَلَّلَ",
      "definition": "To beat or tread a road so that it becomes even and easy to travel.",
      "usage_conditions": "A figurative extension of making tractable.",
      "source_refs": [
        "lane:entry:21638"
      ]
    },
    {
      "meaning_id": "c-formII-makeeasy",
      "headword_arabic": "ذَلَّلَ",
      "definition": "To make an affair easy for someone.",
      "usage_conditions": "Used with an affair or matter as object.",
      "source_refs": [
        "lane:entry:21638"
      ]
    },
    {
      "meaning_id": "c-formIV-lowcompanions",
      "headword_arabic": "أَذَلَّ",
      "definition": "To become a person whose companions are lowly or base.",
      "usage_conditions": "An intransitive Form IV usage.",
      "source_refs": [
        "lane:entry:21639"
      ]
    },
    {
      "meaning_id": "c-formIV-lowcondition",
      "headword_arabic": "أَذَلَّ",
      "definition": "To enter a low or base condition.",
      "usage_conditions": "An intransitive Form IV usage.",
      "source_refs": [
        "lane:entry:21639"
      ]
    },
    {
      "meaning_id": "c-formX-findlow",
      "headword_arabic": "اِسْتَذَلَّ",
      "definition": "To deem or find someone lowly or contemptible.",
      "usage_conditions": "Form X.",
      "source_refs": [
        "lane:entry:21641"
      ]
    },
    {
      "meaning_id": "c-formX-camelticks",
      "headword_arabic": "اِسْتَذَلَّ",
      "definition": "To remove ticks from a refractory camel in order to obtain relief and ease with it.",
      "usage_conditions": "A specialized camel-related expression.",
      "source_refs": [
        "lane:entry:21641"
      ]
    },
    {
      "meaning_id": "c-tadhaldhal",
      "headword_arabic": "تَذَلْذَلَ",
      "definition": "To be in commotion or agitation, and become lax, slack, or pendulous.",
      "usage_conditions": "A reduplicated quadriliteral form.",
      "source_refs": [
        "lane:entry:21643"
      ]
    },
    {
      "meaning_id": "c-dhill-trackcourse",
      "headword_arabic": "ذِلّ",
      "definition": "A beaten and level part of a road; figuratively, an easy or proper course in which affairs proceed.",
      "usage_conditions": "Also occurs in the plural أَذْلَال in sayings about letting matters take their fitting course.",
      "source_refs": [
        "lane:entry:21645"
      ]
    },
    {
      "meaning_id": "c-dhalul-spearheads",
      "headword_arabic": "ذُلُل",
      "definition": "Made easy to pierce, said of spearheads sharpened thin and slender.",
      "usage_conditions": "A poetic application of the plural.",
      "source_refs": [
        "lane:entry:21647"
      ]
    },
    {
      "meaning_id": "c-dhalil-lowly",
      "headword_arabic": "ذَلِيل",
      "definition": "Low, base, abased, humiliated, or weak.",
      "usage_conditions": "An adjective, with plurals including أَذِلَّة.",
      "source_refs": [
        "lane:entry:21648"
      ]
    },
    {
      "meaning_id": "c-dhalil-road",
      "headword_arabic": "ذَلِيل",
      "definition": "Even, smooth, beaten, and easy to travel.",
      "usage_conditions": "Said of a road, land, or ground.",
      "source_refs": [
        "lane:entry:21648"
      ]
    },
    {
      "meaning_id": "c-dhalil-lowphysical",
      "headword_arabic": "ذَلِيل",
      "definition": "Low; also low and thin, or short.",
      "usage_conditions": "Said, according to context, of a wall, building, mountain, or spear.",
      "source_refs": [
        "lane:entry:21648"
      ]
    },
    {
      "meaning_id": "c-dhalil-abasing",
      "headword_arabic": "ذَلِيل",
      "definition": "Intensely low or abasing; an intensive adjective that can mean one who lowers or abases.",
      "usage_conditions": "An intensive adjectival use.",
      "source_refs": [
        "lane:entry:21648"
      ]
    },
    {
      "meaning_id": "c-dhaluliy-goodnatured",
      "headword_arabic": "ذَلُولِيّ",
      "definition": "Good and easy in natural disposition.",
      "usage_conditions": "An adjective of character or temperament.",
      "source_refs": [
        "lane:entry:21649"
      ]
    },
    {
      "meaning_id": "c-dhuldhul-hems",
      "headword_arabic": "ذُلْذُل",
      "definition": "The lower trailing parts of a long shirt; figuratively, the last or lowest people.",
      "usage_conditions": "The figurative use can denote the baser or meaner among a group.",
      "source_refs": [
        "lane:entry:21651"
      ]
    },
    {
      "meaning_id": "c-madhalla-peg",
      "headword_arabic": "مَذَلَّة",
      "definition": "A wooden pin, peg, or stake.",
      "usage_conditions": "An idiomatic nominal use, associated with a battered or broken head.",
      "source_refs": [
        "lane:entry:21657"
      ]
    },
    {
      "meaning_id": "c-mudhalla-palms",
      "headword_arabic": "مُذَلَّل",
      "definition": "Having fruit-racemes bent down so that the fruit may be easily gathered.",
      "usage_conditions": "Especially said of palm-trees; also discussed in relation to making access easy.",
      "source_refs": [
        "lane:entry:21658"
      ]
    }
