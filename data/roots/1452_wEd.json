{
  "root": "wEd",
  "arabic": "وعد",
  "root_idea": {
    "summary": "A verbal expression of expectation raised by speech: a stated promise or threat concerning a future outcome.",
    "development": "The root develops from verbally holding out a good or bad prospect to promises, threats, mutual appointments, appointed times or places, and things regarded as promising a future result.",
