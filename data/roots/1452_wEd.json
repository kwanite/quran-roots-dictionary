  "quranic_forms": [
    {
      "public_form_id": "wEd-waada",
      "form_group_ids": [
        "qac-form:wEd:waEada:verb:I"
      ],
      "headword_arabic": "وَعَدَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 70,
      "senses": [
        {
          "sense_id": "wEd-waada-s1",
          "definition": "To promise or hold out a future outcome, whether beneficial or harmful.",
          "usage_conditions": "The object may be the person promised and the promised matter; the form is used for promises of good and, in context, announcements of harm.",
          "source_refs": [
            "lane:entry:45451",
            "mufradat:row:1591"
          ]
        },
        {
          "sense_id": "wEd-waada-s2",
          "definition": "To threaten or menace with evil.",
          "usage_conditions": "This threatening use is determined by the harmful object or context; it is distinct from the specialized noun وَعِيدٌ, which denotes a threat.",
          "source_refs": [
            "lane:entry:45451",
            "mufradat:row:1591"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:268",
          "word_location": "2:268:2",
          "sense_ids": [
            "wEd-waada-s1"
          ]
        },
        {
          "verse_key": "11:32",
          "word_location": "11:32:9",
          "sense_ids": [
            "wEd-waada-s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "wEd-waacada",
      "form_group_ids": [
        "qac-form:wEd:wa`Eado:verb:III"
