      "headword_arabic": "وَاعَدَ",
      "public_pos_label": "Verb · Form III",
      "verb_form": "III",
      "occurrence_count": 4,
      "senses": [
        {
          "sense_id": "wEd-waacada-s1",
          "definition": "To make a mutual promise, each party promising the other.",
          "usage_conditions": "The construction is reciprocal; in the Quran it includes making an agreement or promise with another party.",
          "source_refs": [
            "lane:entry:45452",
            "mufradat:row:1591"
          ]
        },
        {
          "sense_id": "wEd-waacada-s2",
          "definition": "To arrange a mutually agreed time or place with another.",
          "usage_conditions": "The second participant and the agreed time or place may be expressed in the construction.",
          "source_refs": [
            "lane:entry:45452",
            "mufradat:row:1591"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:235",
