  "other_classical_meanings": [
    {
      "meaning_id": "wEd-cl-wa3d-convention",
      "headword_arabic": "وَعْدٌ",
      "definition": "In conventional usage, failure to perform a promise is treated as lying, whereas failure to carry out a threat is not termed a breach in the same way.",
      "usage_conditions": "A statement about the social and rhetorical treatment of promises and threats, not a separate grammatical form.",
      "source_refs": [
        "lane:entry:45457"
      ]
    },
    {
      "meaning_id": "wEd-cl-wa3d-thing",
      "headword_arabic": "وَعْدٌ",
      "definition": "A thing promised.",
      "usage_conditions": "A nominal use referring to the promised object or outcome rather than to the act of promising.",
      "source_refs": [
        "lane:entry:45457"
      ]
    },
    {
      "meaning_id": "wEd-cl-wa3d-figurative",
      "headword_arabic": "وَعَدَ",
      "definition": "Of a day, land, or similar thing, to show promise of a coming condition or yield.",
      "usage_conditions": "A figurative extension in which the subject indicates likely cold, heat, produce, or another future result.",
      "source_refs": [
        "lane:entry:45451"
      ]
    },
    {
      "meaning_id": "wEd-cl-aw3ada-camel",
      "headword_arabic": "أَوْعَدَ",
      "definition": "Of a stallion-camel, to bray when preparing to attack or fight other camels.",
      "usage_conditions": "A specialized figurative use applied to the animal’s threatening sound before aggression.",
      "source_refs": [
        "lane:entry:45453"
      ]
    },
    {
      "meaning_id": "wEd-cl-wa3id-adj",
      "headword_arabic": "وَاعِدٌ",
      "definition": "Promising or showing favorable signs of a future result.",
      "usage_conditions": "Used of a horse expected to run repeatedly, a beast or tree expected to produce good, a cloud suggesting rain, a day suggesting heat or cold, or land whose emerging vegetation promises productivity.",
      "source_refs": [
        "lane:entry:45462"
      ]
    },
    {
      "meaning_id": "wEd-cl-tawa33ada",
      "headword_arabic": "تَوَعَّدَ",
      "definition": "To threaten or menace.",
      "usage_conditions": "The Form V threatening verb is attested in the broader lexical discussion even though this QAC packet contains no Quranic Form V group.",
      "source_refs": [
        "lane:entry:45451"
      ]
    },
    {
      "meaning_id": "wEd-cl-waacada-vie",
      "headword_arabic": "وَاعَدَ",
      "definition": "To vie with another in promising, surpassing the other by promising more.",
      "usage_conditions": "A specialized reciprocal construction concerning competing promises.",
      "source_refs": [
        "lane:entry:45452"
      ]
    },
    {
      "meaning_id": "wEd-cl-itt3ada",
      "headword_arabic": "اِتَّعَدَ",
      "definition": "To accept or rely on another’s promise.",
      "usage_conditions": "The derived verb describes accepting a promise and, by extension, confiding in or relying upon it.",
      "source_refs": [
        "lane:entry:45456"
      ]
    },
    {
      "meaning_id": "wEd-cl-3idiyy",
      "headword_arabic": "عِدِيٌّ",
      "definition": "Of or relating to a promise.",
      "usage_conditions": "A relational adjective derived from عِدَةٌ, with dialectal variation in its formation reported in the lexical evidence.",
      "source_refs": [
        "lane:entry:45459"
      ]
    },
    {
      "meaning_id": "wEd-cl-wa3iidiyya",
      "headword_arabic": "الوَعِيدِيَّةُ",
      "definition": "A sect of the Khawārij characterized in the lexical description by an extreme doctrine of threats and punishment.",
      "usage_conditions": "A technical sectarian designation, not a general meaning of وَعِيدٌ.",
      "source_refs": [
        "lane:entry:45461"
      ]
    }
  ],
