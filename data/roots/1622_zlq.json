{
  "root": "zlq",
  "arabic": "زلق",
  "root_idea": {
    "summary": "A core image of something sliding away from its station or losing a firm hold.",
    "development": "This image extends to slipping and dislodgement, slippery surfaces, smoothness, swift movement, and the expulsion of a fetus. These developments do not make every extension a meaning of every form.",
    "source_refs": [
      "maqayis:row:2283",
      "lane:entry:31474",
      "lane:entry:31479",
      "lane:entry:31476"
    ]
  },
  "qac_form_accounting": [
    {
      "form_group_id": "qac-form:zlq:yuzoliqu:verb:IV",
      "disposition": "DISPLAY",
      "target_public_form_id": "qf-zlq-azlaqa",
      "reason": "Displayed under the normalized Form IV perfect citation form."
    },
    {
      "form_group_id": "qac-form:zlq:zalaq:nominal:-",
      "disposition": "DISPLAY",
      "target_public_form_id": "qf-zlq-zalaq",
      "reason": "Displayed as the nominal citation form زَلَقٌ."
    }
  ],
  "quranic_forms": [
    {
      "public_form_id": "qf-zlq-azlaqa",
      "form_group_ids": [
        "qac-form:zlq:yuzoliqu:verb:IV"
      ],
      "headword_arabic": "أَزْلَقَ",
      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "qf-zlq-azlaqa-s1",
          "definition": "To cause someone or something to slip; to make a foot lose its firm hold and thereby cause a fall.",
          "usage_conditions": "In the Quranic occurrence, the hostile gaze is understood as nearly causing the addressee to fall.",
          "source_refs": [
            "lane:entry:31476",
            "mufradat:row:628"
          ]
        },
        {
          "sense_id": "qf-zlq-azlaqa-s2",
          "definition": "To dislodge someone from a position or station.",
          "usage_conditions": "In the Quranic construction involving the gaze, an alternative interpretation understands the action as nearly removing the addressee from the station in which he is established.",
          "source_refs": [
            "lane:entry:31474",
            "lane:entry:31476",
            "mufradat:row:628"
          ]
        },
        {
          "sense_id": "qf-zlq-azlaqa-s3",
          "definition": "To destroy.",
          "usage_conditions": "This meaning occurs in a reported non-canonical reading, where the form replaces the transmitted form أَزْلَفْنَا in another Quranic passage; it is not a canonical occurrence of this form in the supplied data.",
          "source_refs": [
            "mufradat:row:628"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "68:51",
          "word_location": "68:51:5",
          "sense_ids": [
            "qf-zlq-azlaqa-s1",
            "qf-zlq-azlaqa-s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "qf-zlq-zalaq",
      "form_group_ids": [
        "qac-form:zlq:zalaq:nominal:-"
      ],
      "headword_arabic": "زَلَقٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "qf-zlq-zalaq-s1",
          "definition": "Smooth, bare, slippery ground; a surface on which the feet do not hold firmly.",
          "usage_conditions": "In the Quranic phrase صَعِيدًا زَلَقًا, the description can emphasize ground stripped of vegetation or ground too slippery for firm footing.",
          "source_refs": [
            "lane:entry:31479",
            "mufradat:row:628"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "18:40",
          "word_location": "18:40:15",
          "sense_ids": [
            "qf-zlq-zalaq-s1"
          ]
        }
      ]
    }
  ],
  "other_classical_meanings": [
    {
      "meaning_id": "cm-zaliqa-slip",
      "headword_arabic": "زَلِقَ",
      "definition": "To slip or slide away; of a foot, to lose its firm footing; of an arrow, to slide along the ground.",
      "usage_conditions": "The form is also reported as زَلَقَ in some usages.",
      "source_refs": [
        "lane:entry:31474"
      ]
    },
    {
      "meaning_id": "cm-zaliqa-withdraw",
      "headword_arabic": "زَلِقَ بِمَكَانِهِ",
      "definition": "To become disgusted with a place, loathe it, and withdraw or retire from it.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31474"
      ]
    },
    {
      "meaning_id": "cm-zalaqa-camel",
      "headword_arabic": "زَلَقَ",
      "definition": "Of a she-camel, to be or become quick and swift.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31474"
      ]
    },
    {
      "meaning_id": "cm-zalaqa-shave",
      "headword_arabic": "زَلَقَ",
      "definition": "To shave the head.",
      "usage_conditions": "A related intensive form is also reported in this usage.",
      "source_refs": [
        "lane:entry:31474"
      ]
    },
    {
      "meaning_id": "cm-zallaqa-surface",
      "headword_arabic": "زَلَّقَ",
      "definition": "To make a place slippery, even without water.",
      "usage_conditions": "The resulting surface is compared with a مَزْلَقَة.",
      "source_refs": [
        "lane:entry:31475"
      ]
    },
    {
      "meaning_id": "cm-zallaqa-anoint",
      "headword_arabic": "زَلَّقَ",
      "definition": "To anoint the body with oil or a similar substance so that it becomes slippery.",
      "usage_conditions": "This is distinguished from making a place slippery.",
      "source_refs": [
        "lane:entry:31475"
      ]
    },
    {
      "meaning_id": "cm-zallaqa-sharpen",
      "headword_arabic": "زَلَّقَ",
      "definition": "To keep an iron object sharp.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31475"
      ]
    },
    {
      "meaning_id": "cm-zallaqa-gaze",
      "headword_arabic": "زَلَّقَ",
      "definition": "To look sharply or intently at someone or something.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31475"
      ]
    },
    {
      "meaning_id": "cm-azlaqa-abort",
      "headword_arabic": "أَزْلَقَ",
      "definition": "Of a female, to cast forth her young or fetus.",
      "usage_conditions": "The usage is reported especially of camels and mares, and authorities differ over whether the fetus is fully formed.",
      "source_refs": [
        "lane:entry:31476"
      ]
    },
    {
      "meaning_id": "cm-tazallaqa-slide",
      "headword_arabic": "تَزَلَّقَ",
      "definition": "To slip or slide along; also, to become smooth or slippery.",
      "usage_conditions": "The smoothness or slipperiness is a related state or result of the sliding sense.",
      "source_refs": [
        "lane:entry:31477"
      ]
    },
    {
      "meaning_id": "cm-tazallaqa-anoint",
      "headword_arabic": "تَزَلَّقَ",
      "definition": "To anoint one's body with oils or similar substances.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31477"
      ]
    },
    {
      "meaning_id": "cm-tazallaqa-adorn",
      "headword_arabic": "تَزَلَّقَ",
      "definition": "To ornament or adorn oneself; to live an easy, soft life associated with a shining or glistening exterior.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31477"
      ]
    },
    {
      "meaning_id": "cm-zalaq-rump",
      "headword_arabic": "زَلَقٌ",
      "definition": "The rump of a horse or similar beast.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31479"
      ]
    },
    {
      "meaning_id": "cm-zaliq-quickanger",
      "headword_arabic": "زَلِقٌ",
      "definition": "Quick to anger at what is said.",
      "usage_conditions": "Applied to a man.",
      "source_refs": [
        "lane:entry:31480"
      ]
    },
    {
      "meaning_id": "cm-zaliq-premature",
      "headword_arabic": "زَلِقٌ",
      "definition": "A man who emits semen before intercourse or upon speaking to a woman, without intercourse.",
      "usage_conditions": "The definition describes a premature or non-coital emission, not ordinary sexual intercourse.",
      "source_refs": [
        "lane:entry:31480"
      ]
    },
    {
      "meaning_id": "cm-zalaqa-rock",
      "headword_arabic": "زَلَقَةٌ",
      "definition": "A smooth rock.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31481"
      ]
    },
    {
      "meaning_id": "cm-zalaqa-mirror",
      "headword_arabic": "زَلَقَةٌ",
      "definition": "A mirror.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31481"
      ]
    },
    {
      "meaning_id": "cm-zaluq-camel",
      "headword_arabic": "زَلُوقٌ",
      "definition": "A quick or swift she-camel.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31482"
      ]
    },
    {
      "meaning_id": "cm-zaluq-stage",
      "headword_arabic": "زَلُوقٌ",
      "definition": "A far-extending stage of a journey.",
      "usage_conditions": "Used in the expression عُقْبَةٌ زَلُوقٌ.",
      "source_refs": [
        "lane:entry:31482"
      ]
    },
    {
      "meaning_id": "cm-zaliq-fetus",
      "headword_arabic": "زَلِيقٌ",
      "definition": "A young one or fetus expelled abortively, immature or dead but developed enough to have a recognizable form.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31483"
      ]
    },
    {
      "meaning_id": "cm-zullayq-peach",
      "headword_arabic": "زُلَّيْقٌ",
      "definition": "A smooth peach.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31485"
      ]
    },
    {
      "meaning_id": "cm-zaylaq-wind",
      "headword_arabic": "زَيْلَقٌ",
      "definition": "A wind swift in its passage.",
      "usage_conditions": "Used in the expression زِيحٌ زَيْلَقٌ.",
      "source_refs": [
        "lane:entry:31487"
      ]
    },
    {
      "meaning_id": "cm-zaluq-shield",
      "headword_arabic": "الزَّالُوقُ",
      "definition": "The name of a shield from which weapons slip off without wounding its bearer.",
      "usage_conditions": "This is a named object whose designation is explained by its protective property.",
      "source_refs": [
        "lane:entry:31488"
      ]
    },
    {
      "meaning_id": "cm-azlaq-hairless",
      "headword_arabic": "أَزْلَقُ",
      "definition": "Hairless and glistening in body.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31489"
      ]
    },
    {
      "meaning_id": "cm-mazlaqa-idiom",
      "headword_arabic": "مَزْلَقَةٌ",
      "definition": "A slippery path; figuratively, a perilous path such as a way of false religion.",
      "usage_conditions": "The figurative use occurs in the expression عَلَى مَزْلَقَةِ البَاطِلِ.",
      "source_refs": [
        "lane:entry:31491"
      ]
    },
    {
      "meaning_id": "cm-mizlaq-door",
      "headword_arabic": "مِزْلَاقٌ",
      "definition": "A dialectal variant of مِزْلَاجٌ: a device by which a door is fastened and which can be opened without a key.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:31492"
      ]
    },
    {
      "meaning_id": "cm-mizlaq-abort",
      "headword_arabic": "مِزْلَاقٌ",
      "definition": "A mare or other female that frequently casts her young; also applied to a camel.",
      "usage_conditions": "This is a habitual disposition, not a single act of casting young.",
      "source_refs": [
        "lane:entry:31492"
      ]
    }
  ],
