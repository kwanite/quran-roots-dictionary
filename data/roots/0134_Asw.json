{
  "root": "Asw",
  "arabic": "أسو",
  "root_idea": {
    "summary": "A root oriented toward mending and repair: treating a wound, repairing a breach, and relieving distress.",
    "development": "The lexical development extends from physical treatment to reconciliation, consolation in grief, taking another as an example, and sharing resources so as to equalize conditions.",
    "source_refs": [
      "maqayis:row:94",
      "mufradat:row:34"
    ]
  },
