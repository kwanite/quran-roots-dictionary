  "other_classical_meanings": [
    {
      "meaning_id": "Asw:cm:wound-treatment",
      "headword_arabic": "أَسَا",
      "definition": "To dress or treat a wound by curative or surgical means; figuratively, to remedy a damaging affair.",
      "usage_conditions": "The figurative use describes repairing or remedying an affair whose harm is likened to a wound.",
      "source_refs": [
        "lane:entry:6748"
      ]
    },
    {
      "meaning_id": "Asw:cm:reconcile",
      "headword_arabic": "أَسَا بَيْنَهُمْ",
      "definition": "To reconcile people, make peace between them, or settle a difference.",
      "usage_conditions": "Used with بَيْنَ for reconciliation between parties.",
      "source_refs": [
        "lane:entry:6748"
      ]
    },
    {
      "meaning_id": "Asw:cm:console",
      "headword_arabic": "أَسَّى",
      "definition": "To console someone or urge someone to be patient by recalling another person’s similar affliction and endurance.",
      "usage_conditions": "A causative construction: the person is consoled or encouraged to take patience through another’s example.",
      "source_refs": [
        "lane:entry:6749"
      ]
    },
    {
      "meaning_id": "Asw:cm:share-property",
      "headword_arabic": "آسَى",
      "definition": "To share property or means of subsistence with another, making the two conditions more equal.",
      "usage_conditions": "The usage includes giving from one’s own resources so as to share with or equalize oneself with another; it can concern what is sufficient for the other’s need rather than surplus.",
      "source_refs": [
        "lane:entry:6750"
      ]
    },
    {
      "meaning_id": "Asw:cm:mutual-sharing",
      "headword_arabic": "تَآسَوْا",
      "definition": "To share with one another and equalize their means or resources.",
      "usage_conditions": "A reciprocal construction describing mutual sharing, imitation in material conditions, or becoming equal in subsistence.",
      "source_refs": [
        "lane:entry:6753"
      ]
    },
    {
      "meaning_id": "Asw:cm:take-consolation",
      "headword_arabic": "تَأَسَّى",
      "definition": "To take patience or become consoled by another’s example after suffering a similar affliction.",
      "usage_conditions": "Used with بِهِ for taking another person or that person’s experience as a source of consolation or endurance.",
      "source_refs": [
        "lane:entry:6752"
      ]
    },
    {
      "meaning_id": "Asw:cm:follow-example",
      "headword_arabic": "اِئْتَسَى",
      "definition": "To imitate someone, follow his example, or take him as a model.",
      "usage_conditions": "Used with بِهِ for the person whose conduct is followed or made an object of imitation.",
      "source_refs": [
        "lane:entry:6754"
      ]
    },
    {
      "meaning_id": "Asw:cm:make-follow-example",
      "headword_arabic": "أَسْوَيْتُهُ بِهِ",
      "definition": "To make one person imitate another or follow another’s example.",
      "usage_conditions": "A causative construction in which one person is made an example or model for another.",
      "source_refs": [
        "lane:entry:6755"
      ]
    },
    {
      "meaning_id": "Asw:cm:grief-noun",
      "headword_arabic": "أَسًى",
      "definition": "Grief or mourning.",
      "usage_conditions": "A noun denoting the state of sorrow associated with grieving.",
      "source_refs": [
        "lane:entry:6756"
      ]
    },
    {
      "meaning_id": "Asw:cm:patience-noun",
      "headword_arabic": "أُسًى",
      "definition": "Patience or endurance.",
      "usage_conditions": "A noun associated with bearing an affliction patiently.",
      "source_refs": [
        "lane:entry:6758"
      ]
    },
    {
      "meaning_id": "Asw:cm:consolatory-example",
      "headword_arabic": "إِسْوَةٌ / أُسْوَةٌ",
      "definition": "A person or thing whose example consoles someone in grief.",
      "usage_conditions": "The consolatory force comes from recalling that another endured a similar affliction, especially when that person remained patient.",
      "source_refs": [
        "lane:entry:6761"
      ]
    },
    {
      "meaning_id": "Asw:cm:sorrowful-adjective",
      "headword_arabic": "أَسْوَانُ",
      "definition": "Grieving, mourning, or sorrowful.",
      "usage_conditions": "An adjective describing a person marked by grief or mourning.",
      "source_refs": [
        "lane:entry:6762"
      ]
    },
    {
      "meaning_id": "Asw:cm:medical-remedy",
      "headword_arabic": "أَسًا / إِسَاءٌ / أُسَاوَةٌ",
      "definition": "Curative, medical, or surgical treatment; a remedy, especially one for wounds.",
      "usage_conditions": "These nominal forms include the sense of a vulnerary or wound treatment.",
      "source_refs": [
        "lane:entry:6756",
        "lane:entry:6763",
        "lane:entry:6766"
      ]
    },
    {
      "meaning_id": "Asw:cm:treated-wound",
      "headword_arabic": "أَسِيٌّ / مَأْسُوٌّ",
      "definition": "Dressed or treated curatively, especially of a wound.",
      "usage_conditions": "A passive description of an injury that has received medical or surgical treatment.",
      "source_refs": [
        "lane:entry:6765"
      ]
    },
    {
      "meaning_id": "Asw:cm:physician",
      "headword_arabic": "آسٍ",
      "definition": "A physician or person skilled in medical, curative, or surgical treatment, especially of wounds.",
      "usage_conditions": "The associated plural forms include أُسَاةٌ and إِسَاءٌ.",
      "source_refs": [
        "lane:entry:6767"
      ]
    },
    {
      "meaning_id": "Asw:cm:female-circumciser",
      "headword_arabic": "آسِيَةٌ",
      "definition": "A female circumciser.",
      "usage_conditions": "A specialized usage reported among desert peoples.",
      "source_refs": [
        "lane:entry:6767"
      ]
    }
  ],
