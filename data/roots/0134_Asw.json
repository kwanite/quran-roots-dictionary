      "headword_arabic": "أَسِيَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 4,
      "senses": [
        {
          "sense_id": "Asw:verb:asi:s1",
          "definition": "To grieve, mourn, or feel sorrow.",
          "usage_conditions": "Used with عَلَى, عَلَيْهِ, or لِ for the person, thing, or affliction over which one grieves. The Quranic forms express sorrow over people or circumstances, including what has passed.",
