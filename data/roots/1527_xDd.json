{
  "root": "xDd",
  "arabic": "خضد",
  "root_idea": {
    "summary": "The root centers on bending or yielding in something soft, with extensions to breaking, removing thorns, and the resulting soft or broken material.",
    "development": "The primary orientation is bending a soft thing without fully breaking it. Related uses extend this to breaking or removing thorns, detached pieces of moist wood or plants, and figurative bodily weakness or languor.",
    "source_refs": [
      "maqayis:row:1601"
    ]
  },
  "qac_form_accounting": [
    {
      "form_group_id": "qac-form:xDd:m~axoDuwd:nominal:-",
      "disposition": "DISPLAY",
      "target_public_form_id": "xDd-makhdud",
      "reason": "Displayed under the normalized passive-participle citation form مَخْضُود."
    }
  ],
  "quranic_forms": [
    {
      "public_form_id": "xDd-makhdud",
      "form_group_ids": [
        "qac-form:xDd:m~axoDuwd:nominal:-"
      ],
      "headword_arabic": "مَخْضُود",
      "public_pos_label": "Passive participle",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "xDd-makhdud-s1",
          "definition": "Having its thorns broken off or removed; thornless, said of the lote-tree.",
          "usage_conditions": "The Quranic use describes the sidr or lote-trees of 56:28.",
          "source_refs": [
            "lane:entry:19370",
            "mufradat:row:414"
          ]
        },
        {
          "sense_id": "xDd-makhdud-s2",
          "definition": "Having its branches bent under the abundance of fruit.",
          "usage_conditions": "An alternative Quranic interpretation of مَخْضُود in 56:28; it describes the branches rather than the removal of thorns.",
          "source_refs": [
            "lane:entry:19370"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "56:28",
          "word_location": "56:28:3",
          "sense_ids": [
            "xDd-makhdud-s1"
          ]
        },
        {
          "verse_key": "56:28",
          "word_location": "56:28:3",
          "sense_ids": [
            "xDd-makhdud-s2"
          ]
        }
      ]
    }
  ],
  "other_classical_meanings": [
    {
      "meaning_id": "xDd-cm-01",
      "headword_arabic": "خَضَدَ",
      "definition": "To break wood, a branch, a twig, or another soft thing so that its parts do not separate.",
      "usage_conditions": "The corresponding intransitive use may describe wood or branches breaking while remaining connected.",
      "source_refs": [
        "lane:entry:19362"
      ]
    },
    {
      "meaning_id": "xDd-cm-02",
      "headword_arabic": "خَضَدَ",
      "definition": "To bend wood, a branch, or a twig without breaking it; in the camel-neck construction, to bend or break another camel’s neck, hence to engage it in such combat.",
      "usage_conditions": "The bending use is also attested in the corresponding intransitive form.",
      "source_refs": [
        "lane:entry:19362",
        "lane:entry:19365"
      ]
    },
    {
      "meaning_id": "xDd-cm-03",
      "headword_arabic": "خَضَدَ",
      "definition": "To break soft or moist fruit into pieces.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19362"
      ]
    },
    {
      "meaning_id": "xDd-cm-04",
      "headword_arabic": "خَضَدَ",
      "definition": "To cut off, pull off, or remove soft or supple material, especially the thorns of trees.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19362"
      ]
    },
    {
      "meaning_id": "xDd-cm-05",
      "headword_arabic": "خَضَدَ",
      "definition": "To eat vehemently, crunching moist or soft food.",
      "usage_conditions": "The usage is applied both to a person eating vigorously and to a horse eating in a coarse biting or crunching manner.",
      "source_refs": [
        "lane:entry:19362"
      ]
    },
    {
      "meaning_id": "xDd-cm-06",
      "headword_arabic": "خَضِدَ",
      "definition": "To become shrunken and shriveled, said of fruit.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19362"
      ]
    },
    {
      "meaning_id": "xDd-cm-07",
      "headword_arabic": "انْخَضَدَ",
      "definition": "To become broken into pieces or crushed, said of fresh or moist fruit.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19365"
      ]
    },
    {
      "meaning_id": "xDd-cm-08",
      "headword_arabic": "تَخَضَّدَ",
      "definition": "To sway or bend the body from side to side because of languor.",
      "usage_conditions": "The usage is associated with bodily weakness and is compared with تَثَنَّى.",
      "source_refs": [
        "lane:entry:19364"
      ]
    },
    {
      "meaning_id": "xDd-cm-09",
      "headword_arabic": "خَضَدٌ",
      "definition": "Feebleness or weakness in a plant.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19366"
      ]
    },
    {
      "meaning_id": "xDd-cm-10",
      "headword_arabic": "خَضَدٌ",
      "definition": "A bodily ailment affecting the limbs without amounting to a fracture, or bodily languor and pain accompanied by laziness.",
      "usage_conditions": "In خَضَدُ السَّفَرِ, it denotes the fatigue and weariness caused by travel.",
      "source_refs": [
        "lane:entry:19366"
      ]
    },
    {
      "meaning_id": "xDd-cm-11",
      "headword_arabic": "خَضَدٌ",
      "definition": "Detached or broken pieces of moist or soft wood, branches, twigs, papyrus, or similar soft plant material.",
      "usage_conditions": "The term may also be applied to broken pieces of soft produce such as cucumbers.",
      "source_refs": [
        "lane:entry:19366"
      ]
    },
    {
      "meaning_id": "xDd-cm-12",
      "headword_arabic": "خَضَدٌ",
      "definition": "A soft or flaccid plant or tree without thorns.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19366"
      ]
    },
    {
      "meaning_id": "xDd-cm-13",
      "headword_arabic": "خَضِدٌ",
      "definition": "Languid and unable to rise because of bodily pain and weakness.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19367"
      ]
    },
    {
      "meaning_id": "xDd-cm-14",
      "headword_arabic": "خَضَادٌ",
      "definition": "A soft or flaccid tree without thorns.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19368"
      ]
    },
    {
      "meaning_id": "xDd-cm-15",
      "headword_arabic": "خَضُودٌ",
      "definition": "A horse that eats by biting or crunching.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19369"
      ]
    },
    {
      "meaning_id": "xDd-cm-16",
      "headword_arabic": "خَضِيدٌ",
      "definition": "Broken, said of wood, a branch, or a twig whose parts remain connected.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19370"
      ]
    },
    {
      "meaning_id": "xDd-cm-17",
      "headword_arabic": "أَخْضَدُ",
      "definition": "Bent or inclined from side to side because of languor.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19371"
      ]
    },
    {
      "meaning_id": "xDd-cm-18",
      "headword_arabic": "مِخْضَدٌ",
      "definition": "A vehement eater, one who eats coarsely, quickly, or with rudeness.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:19372"
      ]
    }
  ],
