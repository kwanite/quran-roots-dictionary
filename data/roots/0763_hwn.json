    },
    {
      "meaning_id": "cm_hwn_hana_easy",
      "headword_arabic": "هَانَ",
      "definition": "To be easy, light, or gentle; to be lightly estimated by someone.",
      "usage_conditions": "With عَلَيْهِ, a thing is easy or light to someone; the verb may also describe something as gentle or easy in itself.",
      "source_refs": [
        "lane:entry:17187"
      ]
    },
    {
      "meaning_id": "cm_hwn_hawwana",
      "headword_arabic": "هَوَّنَ",
      "definition": "To make a matter easy or light for someone; to make light of it.",
      "usage_conditions": "A Form II causative construction, commonly used with عَلَيْهِ or with an object that is to be regarded lightly.",
      "source_refs": [
        "lane:entry:17188"
      ]
    },
    {
      "meaning_id": "cm_hwn_ahaan_contempt",
      "headword_arabic": "أَهَانَ",
      "definition": "To hold someone or something in little or mean estimation; to despise or make light of it.",
      "usage_conditions": "This is the contempt or slight-estimation branch of the Form IV verb, separate from actively lowering or humiliating someone.",
      "source_refs": [
        "lane:entry:17189"
      ]
    },
    {
