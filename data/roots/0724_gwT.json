      "verb_form": null,
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "sense:gwT:ghait:1",
          "definition": "A place for relieving oneself; euphemistically, a privy or toilet.",
          "usage_conditions": "In the Quranic construction of coming from the غائط, the noun refers to the place associated with relieving oneself rather than functioning as a general word for excrement.",
          "source_refs": [
            "lane:entry:30158"
          ]
        }
      ],
