      ]
    },
    {
      "meaning_id": "cm:gwT:ghat:group",
      "headword_arabic": "غَاطٌ",
      "definition": "The mass or main body of people; the group as opposed to factions.",
      "usage_conditions": "Also reflected in the idiomatic exhortation غُطْ غُطْ, meaning to remain with the main body or group.",
