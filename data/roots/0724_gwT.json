    },
    {
      "meaning_id": "cm:gwT:ghait:excrement",
      "headword_arabic": "غَائِطٌ",
      "definition": "Human excrement or ordure.",
      "usage_conditions": "A euphemistic extension from the place term for a location where bodily waste was deposited or where one went to relieve oneself.",
