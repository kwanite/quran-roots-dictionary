      "meaning_id": "cm:gwT:ghat:sink",
      "headword_arabic": "غَاطَ",
      "definition": "To enter or sink into something, to become hidden in the ground, or, of a place, to lie depressed; also to descend or slope into the ground.",
      "usage_conditions": "Used of a person, foot, or thing entering or sinking into sand, mud, water, a valley, or the ground; also of plaited straps sinking into an animal's side and leaving impressions.",
      "source_refs": [
        "lane:entry:30146"
      ]
    },
