  "other_classical_meanings": [
    {
      "meaning_id": "cm:mrj:maraja:pasture",
      "headword_arabic": "مَرَجَ",
      "definition": "To pasture a beast, send it to pasture, or leave it to roam and pasture freely.",
      "usage_conditions": "A use concerning a beast of carriage or other livestock.",
      "source_refs": [
        "lane:entry:12473"
      ]
    },
    {
      "meaning_id": "cm:mrj:maraja:mix",
      "headword_arabic": "مَرَجَ",
      "definition": "To mix one thing with another or mix two things together.",
      "usage_conditions": "A general transitive use, distinct from the Quranic construction concerning the two seas.",
      "source_refs": [
        "lane:entry:12473"
      ]
    },
    {
      "meaning_id": "cm:mrj:maraja:spoil",
      "headword_arabic": "مَرَجَ",
      "definition": "To mar, spoil, or impair an affair.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:12473"
      ]
    },
    {
      "meaning_id": "cm:mrj:marija:corrupt",
      "headword_arabic": "مَرِجَ",
      "definition": "To become corrupt, impaired, marred, or confused; of a covenant, to become disordered and little observed.",
      "usage_conditions": "Also used of people becoming confused.",
      "source_refs": [
        "lane:entry:12473"
      ]
    },
    {
      "meaning_id": "cm:mrj:marija:unsteady",
      "headword_arabic": "مَرِجَ",
      "definition": "To become unsteady, as a ring on the finger or an arrow.",
      "usage_conditions": "The lexical examples concern physical objects that are not steady in their position.",
      "source_refs": [
        "lane:entry:12473"
      ]
    },
    {
      "meaning_id": "cm:mrj:amraja:embryo",
      "headword_arabic": "أَمْرَجَ",
      "definition": "Of a she-camel, to eject her embryo or the stallion's seed as mucus-like matter and blood.",
      "usage_conditions": "A specialized use concerning a she-camel's reproductive discharge.",
      "source_refs": [
        "lane:entry:12474"
      ]
    },
    {
      "meaning_id": "cm:mrj:amraja:violate",
      "headword_arabic": "أَمْرَجَ",
      "definition": "To violate a covenant or religion.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:12474"
      ]
    },
    {
      "meaning_id": "cm:mrj:marj:pasture",
      "headword_arabic": "مَرْجٌ",
      "definition": "A pasture, pasturage, meadow, or open tract of land abounding in herbage.",
      "usage_conditions": "The noun may denote either the grazing place or a broad open grassy tract.",
      "source_refs": [
        "lane:entry:12475"
      ]
    },
    {
      "meaning_id": "cm:mrj:harjmarj:disorder",
      "headword_arabic": "هَرْجٌ وَمَرْجٌ",
      "definition": "Confusion, disturbance, intricate disorder, discord, or trouble.",
      "usage_conditions": "A conventional paired expression.",
      "source_refs": [
        "lane:entry:12476"
      ]
    },
    {
      "meaning_id": "cm:mrj:maraj:roamingcamel",
      "headword_arabic": "مَرَجٌ",
      "definition": "A camel or group of camels pasturing without a herder.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:12477"
      ]
    },
    {
      "meaning_id": "cm:mrj:marjan:marine",
      "headword_arabic": "مَرْجَانٌ",
      "definition": "Coral, a red gem or red beads; the term is also described as pearl-like material, including large pearls, or as red roots growing in the sea.",
      "usage_conditions": "These are alternative Classical identifications of the marine substance and should not be treated as separate lexical items.",
      "source_refs": [
        "lane:entry:12478"
      ]
    },
    {
      "meaning_id": "cm:mrj:marjan:plant",
      "headword_arabic": "مَرْجَانٌ",
      "definition": "A leguminous plant with red twigs and broad, juicy leaves, said to increase the milk of animals that feed on it.",
      "usage_conditions": "A botanical use distinct from the marine-gem noun.",
      "source_refs": [
        "lane:entry:12478"
      ]
    },
    {
      "meaning_id": "cm:mrj:mimraj:spoiler",
      "headword_arabic": "مِمْرَاجٌ",
      "definition": "A man who mars or spoils his affairs and does not execute them soundly.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:12482"
      ]
    },
    {
      "meaning_id": "cm:mrj:mumrij:embryoejector",
      "headword_arabic": "مُمْرِجٌ",
      "definition": "A she-camel that ejects her embryo or the stallion's seed as mucus-like matter and blood.",
      "usage_conditions": "A specialized active-participial description of a she-camel.",
      "source_refs": [
        "lane:entry:12483"
      ]
    },
    {
      "meaning_id": "cm:mrj:maarij:mixture",
      "headword_arabic": "مَارِجٌ",
      "definition": "A mixture; that which is mixed.",
      "usage_conditions": "A Classical nominal use of مَارِجٌ, distinct from the Quranic expression for a mixture or flame of fire.",
      "source_refs": [
        "lane:entry:12481"
      ]
    }
  ],
