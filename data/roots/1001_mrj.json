      "headword_arabic": "مَرَجَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "sense:mrj:maraja:mix",
          "definition": "To cause two seas to meet and mingle or interflow while remaining distinct.",
          "usage_conditions": "Used in the Quranic construction مَرَجَ الْبَحْرَيْنِ, with the sweet and salt waters meeting without one wholly overtaking the other.",
          "source_refs": [
            "lane:entry:12473"
          ]
        },
        {
          "sense_id": "sense:mrj:maraja:release",
          "definition": "To send forth or let flow two seas so that they meet.",
          "usage_conditions": "An alternative interpretation of the Quranic construction مَرَجَ الْبَحْرَيْنِ; the emphasis is on releasing or allowing the waters to flow.",
          "source_refs": [
            "lane:entry:12473"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "25:53",
          "word_location": "25:53:3",
          "sense_ids": [
            "sense:mrj:maraja:mix",
            "sense:mrj:maraja:release"
          ]
        },
        {
          "verse_key": "55:19",
          "word_location": "55:19:1",
          "sense_ids": [
            "sense:mrj:maraja:mix",
            "sense:mrj:maraja:release"
          ]
        }
      ]
    },
