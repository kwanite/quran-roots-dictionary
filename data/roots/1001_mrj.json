  "root_idea": {
    "summary": "A root centered on movement or coming-and-going that leads to agitation, mingling, or unsettledness.",
    "development": "The semantic range develops from animals moving freely in pasture to sending forth or letting flow, mixing, instability, and confused disorder.",
