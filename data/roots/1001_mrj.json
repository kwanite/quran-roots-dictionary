      "senses": [
        {
          "sense_id": "sense:mrj:marij:confused",
          "definition": "Confused, mixed, or disordered; hence erroneous.",
          "usage_conditions": "In the Quranic expression أَمْرٌ مَرِيجٌ, it describes an affair in a confused or erroneous state.",
          "source_refs": [
            "lane:entry:12479",
            "mufradat:row:1355"
          ]
        }
      ],
