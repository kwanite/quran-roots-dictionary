          ]
        },
        {
          "sense_id": "wqy_f8_s2",
          "definition": "To guard oneself from sin and what may harm one in the world to come; to be pious or God-fearing.",
          "usage_conditions": "A conventional religious use involving careful observance and avoidance of prohibited acts. Quranic translations may render it as fearing God, being righteous, or being conscious of God.",
