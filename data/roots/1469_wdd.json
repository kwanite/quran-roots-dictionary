  "other_classical_meanings": [
    {
      "meaning_id": "wdd_waddu_mutual",
      "headword_arabic": "وَادَّ",
      "definition": "To love or favor one another; to reciprocate affection.",
      "usage_conditions": "Form III reciprocal construction.",
      "source_refs": [
        "lane:entry:45094"
      ]
    },
    {
      "meaning_id": "wdd_tawaddada_attract",
      "headword_arabic": "تَوَدَّدَ",
      "definition": "To seek to attract another's love or affection.",
      "usage_conditions": "Form V causative or self-directed construction describing cultivation of another person's affection.",
      "source_refs": [
        "lane:entry:45096"
      ]
    },
    {
      "meaning_id": "wdd_tawaddada_show",
      "headword_arabic": "تَوَدَّدَ",
      "definition": "To show or manifest love or affection toward someone.",
      "usage_conditions": "Form V construction with إِلَى may mark the person toward whom affection is expressed.",
      "source_refs": [
        "lane:entry:45096"
      ]
    },
    {
      "meaning_id": "wdd_tawadda_mutual",
      "headword_arabic": "تَوَادَّ",
      "definition": "To love one another and reciprocate affection.",
      "usage_conditions": "Form VI reciprocal construction.",
      "source_refs": [
        "lane:entry:45097"
      ]
    },
    {
      "meaning_id": "wdd_widd_beloved",
      "headword_arabic": "وِدّ",
      "definition": "A beloved person, an object of love, or a friend.",
      "usage_conditions": "Used of one who is loved or regarded as a friend; the noun may also function directly as an epithet without an understood ذو.",
      "source_refs": [
        "lane:entry:45098"
      ]
    },
    {
      "meaning_id": "wdd_widd_loving",
      "headword_arabic": "وِدّ",
      "definition": "A loving or affectionate person.",
      "usage_conditions": "The term can describe one who loves or is affectionate, including emphatic use for someone possessing much love or affection; it is used alike of masculine and feminine referents.",
      "source_refs": [
        "lane:entry:45098"
      ]
    },
    {
      "meaning_id": "wdd_wadd_peg",
      "headword_arabic": "وَدّ",
      "definition": "A wooden pin, peg, or stake.",
      "usage_conditions": "A dialectal form identified with وَتِدٌ, especially associated with the dialects of Temeem or Nejd.",
      "source_refs": [
        "lane:entry:45099"
      ]
    },
    {
      "meaning_id": "wdd_wudd_wish",
      "headword_arabic": "وُدّ",
      "definition": "A wish or desire that something be or come to pass.",
      "usage_conditions": "Occurs in the construction بِوُدِّي أَنْ, meaning “I wish that …”; vowel lengthening in the cited poetic example is metrical.",
      "source_refs": [
        "lane:entry:45100"
      ]
    },
    {
      "meaning_id": "wdd_wadud_mare",
      "headword_arabic": "وَدُود",
      "definition": "A mare that exerts all her power in running.",
      "usage_conditions": "A rare specialized equine usage.",
      "source_refs": [
        "lane:entry:45102"
      ]
    },
    {
      "meaning_id": "wdd_awadd_comparative",
      "headword_arabic": "أَوَدُّ",
      "definition": "More loving or most loving; more or most affectionate.",
      "usage_conditions": "A comparative or superlative adjective, not a separate basic semantic branch from loving or affectionate.",
      "source_refs": [
        "lane:entry:45105"
      ]
    }
  ],
