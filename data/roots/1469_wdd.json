  "quranic_forms": [
    {
      "public_form_id": "wdd_formI_wadda",
      "form_group_ids": [
        "qac-form:wdd:wad~a:verb:I"
      ],
      "headword_arabic": "وَدَّ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 17,
      "senses": [
        {
          "sense_id": "wdd_formI_love",
          "definition": "To love, feel affection for, or favor a person or thing.",
          "usage_conditions": "The verb denotes affection or positive attachment toward its object. Voice, tense, and subject differences in the Quran do not create separate lexical meanings.",
          "source_refs": [
            "lane:entry:45093",
            "mufradat:row:1562"
          ]
        },
        {
          "sense_id": "wdd_formI_wish",
          "definition": "To wish for or desire that something happen or be the case.",
          "usage_conditions": "Frequently followed by لَوْ or أَنْ and directed toward a hoped-for, desired, or regretted outcome. This is the desiderative use of the verb, distinct from affection itself.",
          "source_refs": [
            "lane:entry:45093",
            "mufradat:row:1562"
          ]
        },
        {
          "sense_id": "wdd_formI_friendly_allegiance",
          "definition": "To show or maintain friendly affection toward someone, including friendly allegiance or supportive association.",
          "usage_conditions": "In the Quranic relational construction concerning those opposed to God and His Messenger, the verb expresses affiliating with or supporting them through the signs and causes of affection, rather than merely wishing for something.",
          "source_refs": [
            "mufradat:row:1562"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:96",
          "word_location": "2:96:9",
          "sense_ids": [
            "wdd_formI_love"
          ]
