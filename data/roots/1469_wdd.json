      "headword_arabic": "مَوَدَّة",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 8,
      "senses": [
        {
          "sense_id": "wdd_mawadda_affection",
          "definition": "Love, affection, or a bond of affection between persons.",
          "usage_conditions": "May denote affection itself or its expression and causes within a relationship, including friendly or supportive attachment. The Quran applies it to marital affection, kinship-related love, and expressed affiliation.",
          "source_refs": [
            "lane:entry:45107",
            "mufradat:row:1562"
          ]
        },
        {
          "sense_id": "wdd_mawadda_letter",
          "definition": "A letter or epistle.",
          "usage_conditions": "A rare and explicitly disputed interpretation reported for the first occurrence of مَوَدَّة in Quran 60:1; it is not the ordinary sense of the noun.",
          "source_refs": [
            "lane:entry:45107"
          ]
        }
      ],
