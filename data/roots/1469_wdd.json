{
  "root": "wdd",
  "arabic": "ودد",
  "root_idea": {
    "summary": "The root centers on love, affection, and positive attachment, with wishing understood as desiring what one loves.",
    "development": "The lexical tradition distinguishes affection itself from wishing for a desired outcome, and extends the root to mutual or expressed affection. A separate homonymous branch denotes a peg or stake.",
    "source_refs": [
      "maqayis:row:5061",
      "mufradat:row:1562"
    ]
  },
