      "senses": [
        {
          "sense_id": "myl_mala_s1",
          "definition": "To incline or turn aside from a middle course; figuratively, to deviate or show partiality.",
          "usage_conditions": "The Quranic uses include deviation toward an extreme and inclination in a matter of justice or equitable treatment.",
          "source_refs": [
            "lane:entry:5904",
            "mufradat:row:1401"
          ]
        },
        {
          "sense_id": "myl_mala_s2",
          "definition": "To bear down upon, oppress, or attack someone.",
          "usage_conditions": "Used with عَلَى; in the Quranic construction of 4:102, it describes a single assaulting movement against the addressed group.",
          "source_refs": [
            "mufradat:row:1401"
          ]
        }
      ],
