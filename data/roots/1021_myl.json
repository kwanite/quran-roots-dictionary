  "root": "myl",
  "arabic": "ميل",
  "root_idea": {
    "summary": "The root denotes departing from the middle or straight position toward one side.",
    "development": "The central image extends from physical leaning and inherent crookedness to directional or figurative inclination, deviation, partiality, reciprocal alignment, and causative attraction. Related derivatives also designate swaying movement and distance.",
    "source_refs": [
      "maqayis:row:4501",
      "mufradat:row:1401"
    ]
  },
