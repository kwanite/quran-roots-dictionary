        "lane:entry:35017"
      ]
    },
    {
      "meaning_id": "cm:fnn:densebranch",
      "headword_arabic": "أُفْنُونٌ",
      "definition": "A tangled, luxuriant, or dense branch.",
      "usage_conditions": "",
