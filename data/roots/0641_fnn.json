        "lane:entry:35018"
      ]
    },
    {
      "meaning_id": "cm:fnn:calamity",
      "headword_arabic": "أُفْنُونٌ",
      "definition": "A calamity, misfortune, or comparable grave occurrence.",
      "usage_conditions": "Reported as equivalent to دَاهِيَةٌ.",
      "source_refs": [
        "lane:entry:35018"
      ]
