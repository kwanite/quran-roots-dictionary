    {
      "meaning_id": "cm:fnn:baddisposition",
      "headword_arabic": "مُفَنَّنٌ",
      "definition": "Old and evil in disposition, as an epithet for a man or woman.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35020"
      ]
    },
    {
      "meaning_id": "cm:fnn:pregnantlookingcamel",
      "headword_arabic": "مُفَنَّنٌ",
      "definition": "A she-camel that appears to have been ten months pregnant but subsequently proves otherwise.",
      "usage_conditions": "A specialized and somewhat obscure description of a she-camel.",
