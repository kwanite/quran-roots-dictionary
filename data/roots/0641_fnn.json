        "lane:entry:35018"
      ]
    },
    {
      "meaning_id": "cm:fnn:clouds",
      "headword_arabic": "أُفْنُونٌ",
      "definition": "Clouds.",
      "usage_conditions": "A separately reported nominal use.",
