{
  "root": "fnn",
  "arabic": "فنن",
  "root_idea": {
    "summary": "The root has two principal lexical orientations: forceful driving away or causing difficulty, and branching into distinct kinds, modes, or forms.",
    "development": "The branch sense extends to varieties, kinds, diversified speech, and differing forms, while a separate orientation denotes driving away, delaying, defrauding, or troubling.",
    "source_refs": [
      "maqayis:row:3653"
    ]
  },
  "qac_form_accounting": [
    {
      "form_group_id": "qac-form:fnn:>afonaAn:nominal:-",
      "disposition": "DISPLAY",
      "target_public_form_id": "qform:fnn:fanan",
      "reason": "The attested plural أَفْنَانٍ is presented under the supported singular dictionary citation form فَنَنٌ."
    }
  ],
  "quranic_forms": [
    {
      "public_form_id": "qform:fnn:fanan",
      "form_group_ids": [
        "qac-form:fnn:>afonaAn:nominal:-"
      ],
      "headword_arabic": "فَنَنٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "qsense:fnn:1",
          "definition": "A branch of a tree.",
          "usage_conditions": "In ذَوَاتَا أَفْنَانٍ, the plural أَفْنَانٌ is understood as branches or boughs.",
          "source_refs": [
            "lane:entry:35013",
            "mufradat:row:1137"
          ]
        },
        {
          "sense_id": "qsense:fnn:2",
          "definition": "A kind, sort, or variety; alternatively, differing colors or forms.",
          "usage_conditions": "An alternative interpretation of ذَوَاتَا أَفْنَانٍ treats أَفْنَانٌ as referring to kinds or varieties, or to differing colors, rather than tree branches.",
          "source_refs": [
            "lane:entry:35013",
            "mufradat:row:1137"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "55:48",
          "word_location": "55:48:2",
          "sense_ids": [
            "qsense:fnn:1"
          ]
        }
      ]
    }
  ],
  "other_classical_meanings": [
    {
      "meaning_id": "cm:fnn:driveaway",
      "headword_arabic": "فَنَّ",
      "definition": "To drive away a person or camels.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35003"
      ]
    },
    {
      "meaning_id": "cm:fnn:delay",
      "headword_arabic": "فَنَّ",
      "definition": "To delay or defer payment, repeatedly putting a creditor off with promises of later payment.",
      "usage_conditions": "Used with a person in the matter of a debt.",
      "source_refs": [
        "lane:entry:35003"
      ]
    },
    {
      "meaning_id": "cm:fnn:defraud",
      "headword_arabic": "فَنَّ",
      "definition": "To cheat, deceive, overreach, or defraud; to cause loss or damage.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35003"
      ]
    },
    {
      "meaning_id": "cm:fnn:distress",
      "headword_arabic": "فَنَّ",
      "definition": "To cause difficulty, distress, trouble, fatigue, or weariness.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35003"
      ]
    },
    {
      "meaning_id": "cm:fnn:adorn",
      "headword_arabic": "فَنَّ",
      "definition": "To adorn or decorate a person or thing.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35003"
      ]
    },
    {
      "meaning_id": "cm:fnn:makevaried",
      "headword_arabic": "فَنَّنَ",
      "definition": "To make people consist of different sorts or form a medley rather than one tribe.",
      "usage_conditions": "Causative use with people or men.",
      "source_refs": [
        "lane:entry:35004"
      ]
    },
    {
      "meaning_id": "cm:fnn:diversifyspeech",
      "headword_arabic": "فَنَّنَ",
      "definition": "To diversify discourse or speech, branch into different modes of expression, or vary one's opinion.",
      "usage_conditions": "Used with narrative, speech, language, or opinion.",
      "source_refs": [
        "lane:entry:35004"
      ]
    },
    {
      "meaning_id": "cm:fnn:clothvariation",
      "headword_arabic": "تَفْنِينٌ",
      "definition": "Mixing or confusing things; variation, disunion, or nonuniformity in a garment's make or texture.",
      "usage_conditions": "The textile use includes uneven thin and thick places or parts becoming separated as a garment wears.",
      "source_refs": [
        "lane:entry:35004"
      ]
    },
    {
      "meaning_id": "cm:fnn:seekvariety",
      "headword_arabic": "فَنَّنَ",
      "definition": "To seek many or various things.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35004"
      ]
    },
    {
      "meaning_id": "cm:fnn:becomevaried",
      "headword_arabic": "تَفَنَّنَ",
      "definition": "To be or become various in sorts, modes, or manners; to diversify one's speech or possess varied acquirements.",
      "usage_conditions": "Used of modes of speech and of varied knowledge or accomplishments.",
      "source_refs": [
        "lane:entry:35005"
      ]
    },
    {
      "meaning_id": "cm:fnn:commotion",
      "headword_arabic": "تَفَنَّنَ",
      "definition": "To be or become in a state of commotion.",
      "usage_conditions": "A separately reported use of the verb.",
      "source_refs": [
        "lane:entry:35005"
      ]
    },
    {
      "meaning_id": "cm:fnn:variedspeech",
      "headword_arabic": "اِفْتَنَّ",
      "definition": "To enter upon or produce various sorts and modes of speech; to use versatility in disputation or litigation.",
      "usage_conditions": "Used with narration, discourse, or argument.",
      "source_refs": [
        "lane:entry:35006"
      ]
    },
    {
      "meaning_id": "cm:fnn:donkeymovement",
      "headword_arabic": "اِفْتَنَّ",
      "definition": "Of a male donkey, to drive the she-asses in varied directions and courses.",
      "usage_conditions": "The reported construction describes movement to the right and left and by direct and indirect routes.",
      "source_refs": [
        "lane:entry:35006"
      ]
    },
    {
      "meaning_id": "cm:fnn:variedpacing",
      "headword_arabic": "اِسْتَفَنَّ",
      "definition": "To incite or urge someone to practise various modes of pacing.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35007"
      ]
    },
    {
      "meaning_id": "cm:fnn:dispersecamels",
      "headword_arabic": "فَنْفَنَ",
      "definition": "To cause one's camels to become dispersed through indolence or remissness.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35008"
      ]
    },
    {
      "meaning_id": "cm:fnn:kindmode",
      "headword_arabic": "فَنٌّ",
      "definition": "A kind, sort, species, state, mode, or manner; also a medley of people of different kinds.",
      "usage_conditions": "The plural forms include فُنُونٌ and أَفْنَانٌ; the lexical item can describe kinds of things, modes of conduct, or people not belonging to one tribe.",
      "source_refs": [
        "lane:entry:35009"
      ]
    },
    {
      "meaning_id": "cm:fnn:wonder",
      "headword_arabic": "فَنٌّ",
      "definition": "A wonderful thing, affair, or case.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35009"
      ]
    },
    {
      "meaning_id": "cm:fnn:scienceexpert",
      "headword_arabic": "فِنُّ",
      "definition": "A person who occupies himself well with science; a good student of a science.",
      "usage_conditions": "Used in the expression هُوَ فِنُّ عِلْمٍ.",
      "source_refs": [
        "lane:entry:35010"
      ]
    },
    {
      "meaning_id": "cm:fnn:period",
      "headword_arabic": "فَنَّةٌ",
      "definition": "A particular period or time.",
      "usage_conditions": "Used with مِنَ الدَّهْرِ to denote a particular time or period.",
      "source_refs": [
        "lane:entry:35011"
      ]
    },
    {
      "meaning_id": "cm:fnn:herbageabundance",
      "headword_arabic": "فُنَّةٌ",
      "definition": "Much or abundant herbage.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35012"
      ]
    },
    {
      "meaning_id": "cm:fnn:darknessshelter",
      "headword_arabic": "فَنَنٌ",
      "definition": "A branch-like shelter or covering; poetically, darkness that shelters a fugitive.",
      "usage_conditions": "A figurative use based on the sheltering quality of a branch.",
      "source_refs": [
        "lane:entry:35013"
      ]
    },
    {
      "meaning_id": "cm:fnn:hairlocks",
      "headword_arabic": "فَنَنٌ",
      "definition": "Locks of hair, likened to branches.",
      "usage_conditions": "A figurative plural use in descriptions of hair.",
      "source_refs": [
        "lane:entry:35013"
      ]
    },
    {
      "meaning_id": "cm:fnn:camelgrowth",
      "headword_arabic": "فَنِينٌ",
      "definition": "A painful swelling or tumor in a camel's armpit; also, a camel bearing such a tumor.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35014"
      ]
    },
    {
      "meaning_id": "cm:fnn:branchedtree",
      "headword_arabic": "فَنَّاءُ",
      "definition": "A tree having branches, especially long or numerous branches.",
      "usage_conditions": "The form فَنْوَاءُ is also reported, though identified as anomalous in the source discussion.",
      "source_refs": [
        "lane:entry:35015"
      ]
    },
    {
      "meaning_id": "cm:fnn:hairyepithet",
      "headword_arabic": "فَنْوَاءُ",
      "definition": "Having much hair, especially as an epithet for a woman.",
      "usage_conditions": "A figurative extension from a tree having many branches; the source also notes فَنَّاءُ as the regular form.",
      "source_refs": [
        "lane:entry:35015"
      ]
    },
    {
      "meaning_id": "cm:fnn:wildassrunning",
      "headword_arabic": "فَنَّانٌ",
      "definition": "A wild ass characterized by various modes of running.",
