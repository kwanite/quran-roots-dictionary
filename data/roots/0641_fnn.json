      "source_refs": [
        "lane:entry:35018"
      ]
    },
    {
      "meaning_id": "cm:fnn:serpent",
      "headword_arabic": "أُفْنُونٌ",
      "definition": "A serpent.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:35018"
      ]
    },
    {
      "meaning_id": "cm:fnn:oldwoman",
      "headword_arabic": "أُفْنُونٌ",
      "definition": "An old or aged woman; some explanations add the sense of one who is flaccid or flabby.",
      "usage_conditions": "The lexical sources report differing explanations of this application.",
