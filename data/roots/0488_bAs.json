      ],
      "headword_arabic": "بَأْسٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 25,
      "senses": [
        {
          "sense_id": "qform_bas_s1",
          "definition": "Might, strength, or force, especially the force exercised in war or fighting.",
          "usage_conditions": "Depending on context, this martial force may be rendered as might, power, violence, battle, or the strength of a fighting group.",
          "source_refs": [
            "lane:entry:35450",
            "mufradat:row:84"
          ]
        },
        {
          "sense_id": "qform_bas_s2",
          "definition": "Punishment, torment, or severe punitive force inflicted upon someone.",
          "usage_conditions": "In Quranic contexts it can refer to divine punishment, wrath, or torment as an affliction imposed upon a people, rather than to their own military strength.",
          "source_refs": [
            "lane:entry:35450",
            "mufradat:row:84"
          ]
        }
      ],
