{
  "root": "bAs",
  "arabic": "بأس",
  "root_idea": {
    "summary": "A root of severity, force, and what approaches hardship or affliction; it extends from martial strength to distress, punishment, and severe blame.",
    "development": "The core orientation is intensity or harsh force: بَأْسٌ is strength in war, while related forms describe hardship in living, calamity, inflicted punishment, and inward grief. بِئْسَ develops as the conventional verb of emphatic dispraise.",
    "source_refs": [
      "maqayis:row:671",
      "mufradat:row:84"
    ]
  },
