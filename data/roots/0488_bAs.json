  "quranic_forms": [
    {
      "public_form_id": "qform_bisa",
      "form_group_ids": [
        "qac-form:bAs:bi}osa:verb:I"
      ],
      "headword_arabic": "بِئْسَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 40,
      "senses": [
        {
          "sense_id": "qform_bisa_s1",
          "definition": "To be utterly bad or wretched; an emphatic verb of dispraise or blame.",
          "usage_conditions": "A defective, conventionally inflected verb used for emphatic condemnation. With مَا it condemns an action or thing; with a definite noun it takes the praised or blamed subject in the usual بِئْسَ construction, while an indefinite noun may function as a specification.",
          "source_refs": [
            "lane:entry:35445",
            "mufradat:row:84"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:90",
          "word_location": "2:90:1",
          "sense_ids": [
            "qform_bisa_s1"
          ]
        },
        {
          "verse_key": "18:29",
          "word_location": "18:29:25",
          "sense_ids": [
            "qform_bisa_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "qform_ibtasa",
      "form_group_ids": [
        "qac-form:bAs:tabota}iso:verb:VIII"
      ],
      "headword_arabic": "اِبْتَأَسَ",
      "public_pos_label": "Verb · Form VIII",
      "verb_form": "VIII",
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "qform_ibtasa_s1",
          "definition": "To be distressed or grieved by something.",
          "usage_conditions": "Used with بِهِ or مِنْهُ for distress at an unwelcome matter. The lexical description includes humbling or abasing oneself in grief; it does not simply mean disliking or hating something.",
          "source_refs": [
            "lane:entry:35449",
            "lane:entry:35466",
            "mufradat:row:84"
          ]
        }
      ],
      "quran_examples": [
