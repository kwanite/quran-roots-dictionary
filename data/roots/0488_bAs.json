  "other_classical_meanings": [
    {
      "meaning_id": "cl_bawusa_war",
      "headword_arabic": "بَؤُسَ",
      "definition": "To be or become mighty or strong in war; to be courageous, valiant, or powerful in fighting.",
      "usage_conditions": "A Form I verbal usage distinct from the conventional dispraise verb بِئْسَ.",
      "source_refs": [
        "lane:entry:35445"
      ]
    },
    {
      "meaning_id": "cl_baisa_distress",
      "headword_arabic": "بَئِسَ، بَؤُسَ",
      "definition": "To be or become distressed, poor, in pressing want, or afflicted.",
      "usage_conditions": "Describes a state of poverty, misfortune, trial, or affliction, and may also describe distress befalling someone.",
      "source_refs": [
        "lane:entry:35445"
      ]
    },
    {
      "meaning_id": "cl_tabaasa_poverty",
      "headword_arabic": "تَبَاءَسَ",
      "definition": "To feign or display the lowliness and submissiveness of poverty, humbling or abasing oneself before people.",
      "usage_conditions": "A conventional Form VI usage involving affected poverty or self-abasement.",
      "source_refs": [
        "lane:entry:35448"
      ]
    },
    {
      "meaning_id": "cl_bas_valour",
      "headword_arabic": "بَأْسٌ",
      "definition": "Courage, valour, or prowess.",
      "usage_conditions": "A Classical Arabic characterization of a person’s bravery, especially in fighting, distinct from the noun’s force or punishment senses.",
      "source_refs": [
        "lane:entry:35450"
      ]
    },
    {
      "meaning_id": "cl_bas_fear",
      "headword_arabic": "بَأْسٌ",
      "definition": "Fear or danger in the idiom لَا بَأْسَ عَلَيْكَ; by extension, the idiom can convey security or protection.",
      "usage_conditions": "An idiomatic, figurative development of the notion of war or danger.",
      "source_refs": [
        "lane:entry:35450"
      ]
    },
    {
      "meaning_id": "cl_bas_harm",
      "headword_arabic": "بَأْسٌ",
      "definition": "Harm, injury, or adverse consequence.",
      "usage_conditions": "Used especially in لَا بَأْسَ and لَا بَأْسَ بِكَذَا or فِي كَذَا, meaning that there is no harm in something.",
      "source_refs": [
        "lane:entry:35450"
      ]
    },
    {
      "meaning_id": "cl_bus_distress",
      "headword_arabic": "بُؤْسٌ",
      "definition": "Distress, poverty, pressing want, misfortune, or calamity.",
      "usage_conditions": "A noun for hardship in livelihood or circumstances, including a state of severe affliction; it is also used in imprecations such as بُؤْسًا لَهُ.",
      "source_refs": [
        "lane:entry:35451"
      ]
    },
    {
      "meaning_id": "cl_banat_bis",
      "headword_arabic": "بَنَاتُ بِئْسٍ",
      "definition": "Calamities or misfortunes.",
      "usage_conditions": "A fixed idiomatic expression referring collectively to adverse events.",
      "source_refs": [
        "lane:entry:35452"
      ]
    },
    {
      "meaning_id": "cl_basaa_beating",
      "headword_arabic": "بَأْسَاءُ",
      "definition": "The act of beating or striking.",
      "usage_conditions": "A rare Classical Arabic nominal usage, distinct from the Quranic sense of adversity.",
      "source_refs": [
        "lane:entry:35455"
      ]
    },
    {
      "meaning_id": "cl_baus_manifest_distress",
      "headword_arabic": "بَؤُوسٌ",
      "definition": "One in whom distress is apparent or manifest.",
      "usage_conditions": "An adjective describing the visible manifestation of بُؤْسٌ.",
      "source_refs": [
        "lane:entry:35456"
      ]
    },
    {
      "meaning_id": "cl_bayis_valour",
      "headword_arabic": "بَئِيسٌ",
      "definition": "Mighty or strong in war; courageous or valiant.",
      "usage_conditions": "A Classical adjective for martial strength or bravery, distinct from the Quran-attested use describing severe punishment.",
      "source_refs": [
        "lane:entry:35458"
      ]
    },
    {
      "meaning_id": "cl_bayas_strong",
      "headword_arabic": "بَيْئَسٌ",
      "definition": "Strong or powerful.",
      "usage_conditions": "A rare adjectival usage.",
      "source_refs": [
        "lane:entry:35463"
      ]
    },
    {
      "meaning_id": "cl_bayas_lion",
      "headword_arabic": "البَيْئَسُ",
      "definition": "The lion.",
      "usage_conditions": "A figurative or conventional designation based on strength.",
      "source_refs": [
        "lane:entry:35463"
      ]
    },
    {
      "meaning_id": "cl_abas_refusal",
      "headword_arabic": "الأَبْأَسُ",
      "definition": "The most vehement refusal.",
      "usage_conditions": "A superlative expression for extreme refusal or rejection.",
      "source_refs": [
        "lane:entry:35464"
      ]
    }
  ],
