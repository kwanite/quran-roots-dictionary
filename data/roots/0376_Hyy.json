      "usage_conditions": "A Form-I usage related to the shame branch of the root.",
      "source_refs": [
        "lane:entry:16247"
      ]
    },
    {
      "meaning_id": "c_agefifty",
      "headword_arabic": "حَيَّى",
      "definition": "To approach the age of fifty.",
      "usage_conditions": "Used with fifty as the age approached.",
      "source_refs": [
        "lane:entry:16248"
      ]
    },
    {
      "meaning_id": "c_writeletter",
      "headword_arabic": "حَيَّى",
      "definition": "To write the letter ḥāʾ.",
      "usage_conditions": "Used of writing a well-formed ḥāʾ.",
      "source_refs": [
        "lane:entry:16248"
      ]
    },
    {
      "meaning_id": "c_fireenliven",
      "headword_arabic": "حَايَى",
      "definition": "To enliven or revive a fire by blowing on it.",
      "usage_conditions": "Also associated with nourishment sustaining a child's life.",
      "source_refs": [
        "lane:entry:16249"
      ]
    },
    {
      "meaning_id": "c_landcultivation",
      "headword_arabic": "أَحْيَا",
      "definition": "To bring uncultivated land into productive use by cultivation, enclosure, building, or similar improvement.",
      "usage_conditions": "A technical use concerning unused land.",
      "source_refs": [
        "lane:entry:16250"
      ]
    },
    {
      "meaning_id": "c_fruitfulland",
      "headword_arabic": "أَحْيَا / حَيّ",
      "definition": "To find land fruitful or rich in fresh herbage; fruitful land.",
      "usage_conditions": "Also used of abundance of pasture and herbage.",
      "source_refs": [
        "lane:entry:16250",
        "lane:entry:16255"
      ]
    },
    {
      "meaning_id": "c_nightvigil",
      "headword_arabic": "أَحْيَا",
      "definition": "To spend the night awake, especially in worship or devotion.",
      "usage_conditions": "Used with night or one's night.",
      "source_refs": [
        "lane:entry:16250"
      ]
    },
    {
      "meaning_id": "c_cameloffspring",
      "headword_arabic": "أَحْيَتْ / مُحْيٍ",
      "definition": "To have living offspring that seldom or never die.",
      "usage_conditions": "Said of a she-camel.",
      "source_refs": [
        "lane:entry:16250",
        "lane:entry:16278"
      ]
    },
    {
      "meaning_id": "c_pastoralplenty",
      "headword_arabic": "أَحْيَا",
      "definition": "To enjoy abundant pasture, rain, or cattle in good condition.",
      "usage_conditions": "Said of a people or company.",
      "source_refs": [
        "lane:entry:16250"
      ]
    },
    {
      "meaning_id": "c_shrink",
      "headword_arabic": "تَحَيَّى",
      "definition": "To shrink back from something.",
      "usage_conditions": "A figurative Form-V use.",
      "source_refs": [
        "lane:entry:16251"
      ]
    },
    {
      "meaning_id": "c_selfrevive",
      "headword_arabic": "تَحَايَا",
      "definition": "To revive or enliven oneself.",
      "usage_conditions": "Quasi-passive of the Form-III sense.",
      "source_refs": [
        "lane:entry:16252"
      ]
    },
    {
      "meaning_id": "c_disdain",
      "headword_arabic": "اِسْتَحْيَا",
