  "other_classical_meanings": [
    {
      "meaning_id": "c_goodcondition",
      "headword_arabic": "حَيِيَ",
      "definition": "To become well-conditioned or prosperous; to grow fat after leanness.",
      "usage_conditions": "Said of a people or company.",
      "source_refs": [
        "lane:entry:16247"
      ]
    },
    {
      "meaning_id": "c_burningfire",
      "headword_arabic": "حَيِيَ / حَيّ",
      "definition": "To burn brightly; burning or live.",
      "usage_conditions": "Said of fire.",
      "source_refs": [
        "lane:entry:16247",
        "lane:entry:16255"
      ]
    },
    {
      "meaning_id": "c_apparentroad",
      "headword_arabic": "حَيِيَ / حَيّ",
      "definition": "To become apparent or distinct.",
      "usage_conditions": "Said of a road or way.",
      "source_refs": [
        "lane:entry:16247",
        "lane:entry:16255"
      ]
    },
    {
