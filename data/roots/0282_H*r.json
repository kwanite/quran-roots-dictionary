      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "H_r_hadhir_s1",
          "definition": "Being on guard, prepared, or fully equipped against danger.",
          "usage_conditions": "The Quranic plural in 26:56 occurs in a context of military preparedness and may convey being equipped with arms.",
          "source_refs": [
            "lane:entry:13861",
            "mufradat:row:304"
          ]
        }
      ],
