{
  "root": "H*r",
  "arabic": "حذر",
  "root_idea": {
    "summary": "The root centers on guarding oneself through alertness, caution, and vigilance against feared harm.",
    "development": "From this basic orientation develop meanings of fearing, taking precautions, being prepared, warning others, and designating a feared thing or danger.",
    "source_refs": [
      "maqayis:row:1322",
      "mufradat:row:304"
    ]
  },
