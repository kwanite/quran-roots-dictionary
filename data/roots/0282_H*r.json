      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "H_r_hadhar_s1",
          "definition": "Caution or fear expressed as guarding against something feared.",
          "usage_conditions": "A verbal noun or simple substantive; context may foreground fear, vigilance, or guardedness.",
          "source_refs": [
            "lane:entry:13859",
            "mufradat:row:304"
          ]
        }
      ],
      "quran_examples": [
