      "public_pos_label": "Verbal noun",
      "verb_form": null,
      "occurrence_count": 3,
      "senses": [
        {
          "sense_id": "H_r_hidhr_s1",
          "definition": "Precautionary readiness or the means of guarding against danger, including protective equipment or weapons.",
          "usage_conditions": "In the Quranic construction خُذُوا حِذْرَكُمْ, it denotes taking or using one's precautions.",
          "source_refs": [
            "lane:entry:13859",
            "mufradat:row:304"
          ]
        }
      ],
