  "quranic_forms": [
    {
      "public_form_id": "H_r_form1_hadhira",
      "form_group_ids": [
        "qac-form:H*r:yaHo*aru:verb:I"
      ],
      "headword_arabic": "حَذِرَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 12,
      "senses": [
        {
          "sense_id": "H_r_form1_s1",
          "definition": "To beware of, guard against, or take precautions against a danger, person, thing, or event.",
          "usage_conditions": "Used transitively and also with مِنْ or عَلَيْهِ; Quranic imperatives express the command to beware.",
          "source_refs": [
            "lane:entry:13853",
            "mufradat:row:304"
          ]
        },
        {
          "sense_id": "H_r_form1_s2",
          "definition": "To fear or be apprehensive of something.",
          "usage_conditions": "The feared object may be an anticipated matter or consequence; the Quranic use includes fearing the Hereafter.",
          "source_refs": [
            "lane:entry:13853",
            "mufradat:row:304"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "63:4",
          "word_location": "63:4:18",
          "sense_ids": [
            "H_r_form1_s1"
          ]
        },
        {
          "verse_key": "39:9",
          "word_location": "39:9:8",
          "sense_ids": [
            "H_r_form1_s2"
          ]
        }
      ]
    },
    {
      "public_form_id": "H_r_form2_hadhdhara",
      "form_group_ids": [
        "qac-form:H*r:yuHa*~iru:verb:II"
      ],
      "headword_arabic": "حَذَّرَ",
      "public_pos_label": "Verb · Form II",
      "verb_form": "II",
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "H_r_form2_s1",
          "definition": "To warn or caution someone against a thing, person, or event; to make someone fear it.",
          "usage_conditions": "The verb may take the person warned and the feared matter as objects, or may be used with مِنْ for the matter against which someone is warned.",
          "source_refs": [
            "lane:entry:13854",
            "mufradat:row:304"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "3:28",
          "word_location": "3:28:22",
          "sense_ids": [
            "H_r_form2_s1"
          ]
        }
      ]
    },
    {
