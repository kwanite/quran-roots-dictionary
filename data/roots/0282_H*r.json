  "other_classical_meanings": [
    {
      "meaning_id": "cm_hadhar_mutual",
      "headword_arabic": "حَاذَرَ",
      "definition": "To be mutually cautious or fearful; for each of two parties to be on guard against the other.",
      "usage_conditions": "A reciprocal Form III construction.",
      "source_refs": [
        "lane:entry:13855"
      ]
    },
    {
      "meaning_id": "cm_ahdarra",
      "headword_arabic": "احدارّ",
      "definition": "To become angry or enraged, draw oneself together, and prepare to do mischief.",
      "usage_conditions": "A rare derived usage.",
      "source_refs": [
        "lane:entry:13857"
      ]
    },
    {
      "meaning_id": "cm_ibn_ahdhar",
      "headword_arabic": "ابْنُ أَحْذَارٍ",
      "definition": "A person of resolve or determination combined with caution and wariness.",
      "usage_conditions": "Used in the idiomatic expression ابن أحذار.",
      "source_refs": [
        "lane:entry:13859"
      ]
    },
    {
      "meaning_id": "cm_abu_hadhar",
      "headword_arabic": "أَبُو حَذَرٍ",
      "definition": "The male chameleon.",
      "usage_conditions": "A specialized animal name.",
      "source_refs": [
        "lane:entry:13859"
      ]
    },
    {
      "meaning_id": "cm_hadhir_adj",
      "headword_arabic": "حَذِرٌ",
      "definition": "Cautious, wary, vigilant, careful, or fearful.",
      "usage_conditions": "An adjectival description of a person; the form may also convey being in a state of preparation.",
      "source_refs": [
        "lane:entry:13861"
      ]
    },
    {
      "meaning_id": "cm_hadhur_adj",
      "headword_arabic": "حَذُرٌ",
      "definition": "Very fearful and cautious, wary, or vigilant.",
      "usage_conditions": "An adjectival variant with an intensified sense of fear or caution.",
      "source_refs": [
        "lane:entry:13861"
      ]
    },
    {
      "meaning_id": "cm_hidhriya_ground",
      "headword_arabic": "حِذْرِيَةٌ",
      "definition": "Rugged or rough ground; a hard, level summit or rugged hill.",
      "usage_conditions": "A topographical noun.",
      "source_refs": [
        "lane:entry:13862"
      ]
    },
    {
      "meaning_id": "cm_hidhriya_cock",
      "headword_arabic": "حِذْرِيَةٌ",
      "definition": "The feathers at the back of a cock's neck.",
      "usage_conditions": "A specialized anatomical noun.",
      "source_refs": [
        "lane:entry:13862"
      ]
    },
    {
      "meaning_id": "cm_hudhura_false",
      "headword_arabic": "الحُذُرَّى",
      "definition": "What is false, vain, or ineffectual.",
      "usage_conditions": "Synonymous with الباطل.",
      "source_refs": [
        "lane:entry:13865"
      ]
    },
    {
      "meaning_id": "cm_hadhar_imperative",
      "headword_arabic": "حَذَارِ",
      "definition": "Beware; be cautious, wary, or on one's guard.",
      "usage_conditions": "An imperative verbal noun, also used with an object of caution and with the vocative suffix in حَذَارِكَ.",
      "source_refs": [
        "lane:entry:13866"
      ]
    },
    {
      "meaning_id": "cm_hadhir_cautioner",
      "headword_arabic": "حَذِيرٌ",
      "definition": "A cautioner or one who warns another against a person or thing.",
      "usage_conditions": "A rare noun for a person who gives a warning.",
      "source_refs": [
        "lane:entry:13867"
      ]
    },
    {
      "meaning_id": "cm_hudhariyat",
      "headword_arabic": "حُذَارِيَاتٌ",
      "definition": "Persons who make others fear; warners or cautioners.",
      "usage_conditions": "The term is explained both causatively and as a designation for warners.",
      "source_refs": [
        "lane:entry:13868"
      ]
    },
    {
      "meaning_id": "cm_ahdhar_comparative",
      "headword_arabic": "أَحْذَرُ",
      "definition": "More or most cautious, wary, vigilant, careful, or fearful.",
      "usage_conditions": "A comparative or superlative adjective.",
      "source_refs": [
        "lane:entry:13871"
      ]
    },
    {
      "meaning_id": "cm_mahduura_calamity",
      "headword_arabic": "مَحْذُورَةٌ",
      "definition": "A calamity or circumstance feared or regarded with caution.",
      "usage_conditions": "A feminine noun for something apprehended as harmful or dangerous.",
      "source_refs": [
        "lane:entry:13873"
      ]
    },
    {
      "meaning_id": "cm_mahduura_incursion",
      "headword_arabic": "مَحْذُورَةٌ",
      "definition": "A hostile troop's attack or incursion, or war.",
      "usage_conditions": "Lexicographical explanations also relate the term to a sudden cry or attack and to punishment; the precise application is variable.",
      "source_refs": [
        "lane:entry:13873"
      ]
    }
  ],
