      "headword_arabic": "أَزْلَفَ",
      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 4,
      "senses": [
        {
          "sense_id": "zlf-azlafa-s1",
          "definition": "To bring or draw near.",
          "usage_conditions": "A causative construction; in the Quranic passive occurrences, Paradise is brought near to the pious or made near for viewing and entrance.",
          "source_refs": [
            "lane:entry:31458",
            "mufradat:row:627"
          ]
        },
        {
          "sense_id": "zlf-azlafa-s2",
          "definition": "To gather or bring together.",
          "usage_conditions": "Used in the Quranic active construction of bringing a group together at a place.",
          "source_refs": [
            "lane:entry:31458",
            "mufradat:row:627"
          ]
        }
      ],
