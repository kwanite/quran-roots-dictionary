  "other_classical_meanings": [
    {
      "meaning_id": "zlf-zallafa-prior",
      "headword_arabic": "زَلَّفَ",
      "definition": "To do, put, or send something forward beforehand; to advance it or perform it previously.",
      "usage_conditions": "A Form II transitive usage, including advancing an action such as an evil deed.",
      "source_refs": [
        "lane:entry:31457"
      ]
    },
    {
      "meaning_id": "zlf-zallafa-agitate",
      "headword_arabic": "زَلَّفَ",
      "definition": "To disquiet or agitate people progressively, step by step.",
      "usage_conditions": "Reported especially of a guide or one who moves people onward in stages.",
      "source_refs": [
        "lane:entry:31457"
      ]
    },
    {
      "meaning_id": "zlf-zallafa-exaggerate",
      "headword_arabic": "زَلَّفَ",
      "definition": "To add to or exaggerate a discourse or narration.",
      "usage_conditions": "A conventional usage concerning speech or reported accounts.",
      "source_refs": [
        "lane:entry:31457"
      ]
    },
    {
      "meaning_id": "zlf-azlafa-destruction",
      "headword_arabic": "أَزْلَفَ",
      "definition": "To bring someone or something near destruction.",
      "usage_conditions": "A Classical resultative construction in which being brought near means being brought close to ruin or death.",
      "source_refs": [
        "lane:entry:31458"
      ]
    },
    {
      "meaning_id": "zlf-izdalafa-approach",
      "headword_arabic": "اِزْدَلَفَ",
      "definition": "To approach, draw near, advance, or go forward toward someone or something.",
      "usage_conditions": "The object may be introduced with إِلَى or مِنْهُ; the usage also describes an arrow or a person moving nearer.",
      "source_refs": [
        "lane:entry:31460"
      ]
    },
    {
      "meaning_id": "zlf-zalf-advance-noun",
      "headword_arabic": "زَلْفٌ، زَلَفٌ",
      "definition": "Advancing or going forward from place to place.",
      "usage_conditions": "Nominal expressions for the act of progressing or moving nearer.",
      "source_refs": [
        "lane:entry:31460"
      ]
    },
    {
      "meaning_id": "zlf-zilf-meadow",
      "headword_arabic": "زِلْفٌ",
      "definition": "A meadow or green tract.",
      "usage_conditions": "A Classical nominal usage, also reported in an interpretation of a traditional expression.",
      "source_refs": [
        "lane:entry:31463"
      ]
    },
    {
      "meaning_id": "zlf-zalafa-reservoir",
      "headword_arabic": "زَلَفَةٌ",
      "definition": "A full reservoir or watering-trough.",
      "usage_conditions": "A vessel or basin filled with water.",
      "source_refs": [
        "lane:entry:31467"
      ]
    },
    {
      "meaning_id": "zlf-zalafa-bowl",
      "headword_arabic": "زَلَفَةٌ",
      "definition": "A bowl or serving dish, especially when full.",
      "usage_conditions": "A Classical vessel term for a ṣaḥفة-like bowl.",
      "source_refs": [
        "lane:entry:31467"
      ]
    },
    {
      "meaning_id": "zlf-zalafa-vessel",
      "headword_arabic": "زَلَفَةٌ",
      "definition": "A green vessel or basin.",
      "usage_conditions": "A Classical usage for an ijjānah-type vessel; the associated plural or collective forms are also reported.",
      "source_refs": [
        "lane:entry:31467"
      ]
    },
    {
      "meaning_id": "zlf-zalafa-shell",
      "headword_arabic": "زَلَفَةٌ",
      "definition": "A mother-of-pearl shell, oyster shell, or similar shell.",
      "usage_conditions": "A Classical interpretation of the term in a traditional expression.",
      "source_refs": [
        "lane:entry:31467"
      ]
    },
    {
      "meaning_id": "zlf-zalafa-terrain",
      "headword_arabic": "زَلَفَةٌ",
      "definition": "A smooth rock or a tract of ground, including rugged, swept, or even ground on a soft mountain.",
      "usage_conditions": "The term is reported for several kinds of rock or terrain surface.",
      "source_refs": [
        "lane:entry:31467"
      ]
    },
    {
      "meaning_id": "zlf-zalafa-mirror",
      "headword_arabic": "زَلَفَةٌ",
      "definition": "A mirror or its face.",
      "usage_conditions": "A Classical nominal usage associated with a smooth, clean surface.",
      "source_refs": [
        "lane:entry:31467"
      ]
    },
    {
      "meaning_id": "zlf-zaluf-journey",
      "headword_arabic": "زَلُوفٌ",
      "definition": "Far-extending or long-reaching, said of a stage of a journey.",
      "usage_conditions": "An attributive description of a journey stage or travel distance.",
      "source_refs": [
        "lane:entry:31469"
      ]
    },
    {
      "meaning_id": "zlf-zalif-advance",
      "headword_arabic": "زَلِيفٌ",
      "definition": "Advancing or going forward.",
      "usage_conditions": "An adjectival or descriptive form for one that advances or progresses.",
      "source_refs": [
        "lane:entry:31470"
      ]
    },
    {
      "meaning_id": "zlf-mazlafa-town",
      "headword_arabic": "مَزْلَفَةٌ",
      "definition": "A town or settlement between the desert and cultivated land, or between the desert and a sea or great river.",
      "usage_conditions": "A geographical term for an intermediate settlement or borderland town; its plural is مَزَالِفُ.",
      "source_refs": [
        "lane:entry:31473"
      ]
    },
    {
      "meaning_id": "zlf-mazalif-steps",
      "headword_arabic": "مَزَالِفُ",
      "definition": "Places of ascent, steps, or stairs by which one approaches a higher destination.",
      "usage_conditions": "A plural usage motivated by the idea of bringing a person nearer to the place ascended to.",
      "source_refs": [
        "lane:entry:31473"
      ]
    }
  ],
