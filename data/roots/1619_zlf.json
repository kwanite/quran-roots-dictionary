{
  "root": "zlf",
  "arabic": "زلف",
  "root_idea": {
    "summary": "The root denotes advancing or pressing forward toward something in proximity, and hence drawing near or bringing near.",
    "development": "From this central notion of approach, the lexicon develops meanings of causative bringing near, nearness in rank or favor, portions of time approaching one another, and places or stages that bring a person nearer to a destination.",
    "source_refs": [
      "maqayis:row:2282",
      "mufradat:row:627"
    ]
  },
