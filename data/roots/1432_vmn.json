      "headword_arabic": "ثَمَنٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 11,
      "senses": [
        {
          "sense_id": "s_vmn_thaman_price",
          "definition": "The price or consideration received in exchange for something sold, whether money or a commodity.",
          "usage_conditions": "In ordinary exchange, it is what the seller receives for the thing sold; Quranic usage includes the consideration associated with buying or selling.",
          "source_refs": [
            "lane:entry:27561",
            "mufradat:row:211"
          ]
        },
        {
          "sense_id": "s_vmn_thaman_substitute",
          "definition": "A substitute or compensation accepted in exchange, including a figurative price or gain.",
          "usage_conditions": "In Quranic figurative constructions, the price need not be money: divine signs or covenantal obligations may be exchanged for a small worldly substitute or benefit.",
          "source_refs": [
            "lane:entry:27561",
            "mufradat:row:211"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "12:20",
          "word_location": "12:20:2",
          "sense_ids": [
            "s_vmn_thaman_price"
          ]
        },
