{
  "root": "lqy",
  "arabic": "لقي",
  "root_idea": {
    "summary": "The root expresses encounter or convergence, casting or placing something, and a separate archaic branch associated with curvature.",
    "development": "Its principal semantic developments are coming face to face or finding, and throwing or placing something where it may be encountered. Derived forms extend these ideas to reciprocal meeting, receiving, conveying, bestowing, and casting.",
    "source_refs": [
      "maqayis:row:4210",
      "mufradat:row:1319"
    ]
  },
