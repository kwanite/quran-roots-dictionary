      "headword_arabic": "لَقِيَ",
      "definition": "To come near someone or come to face him.",
      "usage_conditions": "A conventional use emphasizing proximity and facing rather than merely finding or meeting.",
      "source_refs": [
        "lane:entry:20693"
      ]
    },
    {
      "meaning_id": "lqy_lqiya_disliked",
      "headword_arabic": "لَقِيَ",
      "definition": "To confront or treat someone with something disliked or harmful.",
      "usage_conditions": "The object is a person confronted with an unwelcome act or treatment.",
      "source_refs": [
        "lane:entry:20693"
      ]
    },
    {
      "meaning_id": "lqy_laqqa_evil",
      "headword_arabic": "لَقَّى",
      "definition": "To make someone experience evil treatment.",
      "usage_conditions": "A causative Form II construction in which the person is subjected to an adverse experience.",
      "source_refs": [
        "lane:entry:20694"
      ]
    },
    {
      "meaning_id": "lqy_laqa_pain",
      "headword_arabic": "لَاقَى",
      "definition": "To experience pain or hardship.",
      "usage_conditions": "This Form III specialization describes undergoing an adverse condition.",
      "source_refs": [
        "lane:entry:20695"
      ]
    },
    {
      "meaning_id": "lqy_laqa_join",
      "headword_arabic": "لَاقَى",
      "definition": "To make two ends meet and tie them together.",
      "usage_conditions": "Used of bringing the two ends of a garment or similar object together.",
      "source_refs": [
        "lane:entry:20695"
      ]
    },
    {
      "meaning_id": "lqy_liqa_battle",
      "headword_arabic": "لِقَاء",
      "definition": "An encounter in the sense of conflict, fight, battle, or war.",
      "usage_conditions": "This is a conventional military or combative application of لقاء, including the day of battle.",
      "source_refs": [
        "lane:entry:20701"
      ]
    },
    {
      "meaning_id": "lqy_alqa_suggest",
      "headword_arabic": "أَلْقَى",
      "definition": "To put an idea into someone's mind or suggest it to them.",
      "usage_conditions": "A figurative construction with the idea or suggestion as the thing placed in the person's mind.",
      "source_refs": [
        "lane:entry:20696"
      ]
    },
    {
      "meaning_id": "lqy_alqa_dictate",
      "headword_arabic": "أَلْقَى",
      "definition": "To dictate writing to a writer.",
      "usage_conditions": "Used when the conveyed material is a text dictated for writing.",
      "source_refs": [
        "lane:entry:20696"
      ]
    },
    {
      "meaning_id": "lqy_alqa_reveal",
      "headword_arabic": "أَلْقَى",
      "definition": "To communicate or reveal a secret to someone.",
      "usage_conditions": "The construction presents a concealed matter as conveyed to a recipient.",
      "source_refs": [
        "lane:entry:20696"
      ]
    },
    {
      "meaning_id": "lqy_alqa_disregard",
      "headword_arabic": "أَلْقَى",
      "definition": "To pay no attention to someone or something.",
      "usage_conditions": "An idiomatic negative construction meaning to give no consideration or heed.",
      "source_refs": [
        "lane:entry:20696"
      ]
    },
    {
      "meaning_id": "lqy_alqa_night_settle",
      "headword_arabic": "أَلْقَى",
      "definition": "Of night, to settle or lie down.",
      "usage_conditions": "An idiomatic use applied to the onset or settling of night.",
      "source_refs": [
        "lane:entry:20696"
      ]
    },
    {
      "meaning_id": "lqy_talaqqa_learn",
      "headword_arabic": "تَلَقَّى",
      "definition": "To receive by instruction or learn by rote.",
      "usage_conditions": "This use is synonymous with taking in learned material through instruction and is distinct from merely encountering it.",
      "source_refs": [
        "lane:entry:20697"
      ]
    },
    {
      "meaning_id": "lqy_iltaqa_anatomical",
