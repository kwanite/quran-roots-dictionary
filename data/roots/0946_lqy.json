        "lane:entry:20698"
      ]
    },
    {
      "meaning_id": "lqy_istalqa",
      "headword_arabic": "اِسْتَلْقَى",
      "definition": "To lie on one's back, or to lie extended as though thrown down.",
      "usage_conditions": "The Form X construction describes a person reclining or a thing lying extended.",
      "source_refs": [
        "lane:entry:20699"
      ]
    },
    {
      "meaning_id": "lqy_laqa_muscles",
      "headword_arabic": "لَقًى",
