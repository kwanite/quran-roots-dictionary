      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 71,
      "senses": [
        {
          "sense_id": "lqy_alqa_s1",
          "definition": "To throw, cast, put, place, or cause to fall.",
          "usage_conditions": "The object may be cast down, out, into a place, or onto something; active and passive constructions express the corresponding placing or being cast.",
          "source_refs": [
            "lane:entry:20696",
            "mufradat:row:1319"
          ]
        },
        {
          "sense_id": "lqy_alqa_s2",
          "definition": "To convey, present, offer, or address something to another.",
          "usage_conditions": "The construction with إِلَى or عَلَى is used for words, a message, salutation or submission, affection, and other things presented or communicated to a recipient.",
          "source_refs": [
            "lane:entry:20696",
            "mufradat:row:1319"
          ]
        },
        {
          "sense_id": "lqy_alqa_s3",
          "definition": "To listen attentively or lend an ear.",
          "usage_conditions": "This specialized Quranic construction has the ear or hearing as its object, as in أَلْقَى السَّمْعَ.",
          "source_refs": [
            "mufradat:row:1319"
          ]
        },
        {
          "sense_id": "lqy_alqa_s4",
          "definition": "To cast someone into a prostrate or compelled state.",
          "usage_conditions": "In the Quranic account of the magicians, the passive form describes their being overwhelmed and made to fall prostrate, rather than an ordinary voluntary act of throwing.",
          "source_refs": [
            "mufradat:row:1319"
          ]
        }
      ],
