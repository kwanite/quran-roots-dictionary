      "headword_arabic": "لَقِيَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 14,
      "senses": [
        {
          "sense_id": "lqy_laqiya_s1",
          "definition": "To meet, encounter, come upon, or find someone or something.",
          "usage_conditions": "Used for direct encounter and for finding or coming upon an object; tense and grammatical voice do not create separate lexical senses.",
          "source_refs": [
            "lane:entry:20693",
            "mufradat:row:1319"
          ]
        },
        {
          "sense_id": "lqy_laqiya_s2",
          "definition": "To experience or undergo something that befalls one, including hardship, good, or evil.",
          "usage_conditions": "The object may be an experience or condition rather than a person; the Quran explicitly applies the usage to experiencing fatigue.",
          "source_refs": [
            "mufradat:row:1319"
          ]
        }
      ],
      "quran_examples": [
