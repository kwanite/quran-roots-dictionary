        {
          "sense_id": "qf-njd-najd-s1",
          "definition": "An elevated or conspicuous way; in the dual expression النَّجْدَيْنِ, the two ways, figuratively the paths of right and wrong.",
          "usage_conditions": "Quranic use in 90:10. The figurative contrast extends to right and wrong in belief, truth and falsehood in speech, and good and evil in action.",
          "source_refs": [
            "lane:entry:43272",
            "mufradat:row:1413"
          ]
        },
        {
          "sense_id": "qf-njd-najd-s2",
          "definition": "The two breasts, as an alternative interpretation of النَّجْدَيْنِ.",
          "usage_conditions": "An alternative Quranic interpretation of the dual expression in 90:10; it is not the contextual rendering represented by the supplied Quran Foundation gloss.",
          "source_refs": [
            "lane:entry:43272"
          ]
        }
      ],
