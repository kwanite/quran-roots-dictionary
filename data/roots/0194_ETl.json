  "quranic_forms": [
    {
      "public_form_id": "qform-etl-attala",
      "form_group_ids": [
        "qac-form:ETl:EuT~ilato:verb:II"
      ],
      "headword_arabic": "عَطَّلَ",
      "public_pos_label": "Verb · Form II",
      "verb_form": "II",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "qform-etl-attala-s1",
          "definition": "To leave untended or without a herder; to abandon the normal care of something.",
          "usage_conditions": "Quranically attested in the passive form for the pregnant she-camels left without their customary attendant amid the terrors of the Last Hour.",
          "source_refs": [
            "lane:entry:3765",
            "mufradat:row:991"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "81:4",
          "word_location": "81:4:3",
          "sense_ids": [
            "qform-etl-attala-s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "qform-etl-muattal",
      "form_group_ids": [
        "qac-form:ETl:m~uEaT~alap:nominal:-"
      ],
      "headword_arabic": "مُعَطَّلٌ",
      "public_pos_label": "Passive participle",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "qform-etl-muattal-s1",
          "definition": "Left untended, neglected, or unused; of a well, one from which water is no longer drawn or whose use has lapsed.",
          "usage_conditions": "Quranically used as a feminine passive participle for a well abandoned through neglect, including neglect resulting from the loss of its owners.",
          "source_refs": [
            "lane:entry:3780",
            "mufradat:row:991"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "22:45",
          "word_location": "22:45:12",
          "sense_ids": [
            "qform-etl-muattal-s1"
          ]
        }
      ]
    }
  ],
  "other_classical_meanings": [
    {
      "meaning_id": "cm-atila-devoid",
      "headword_arabic": "عَطِلَ",
      "definition": "To be devoid or destitute of something, especially women's adornment; also to be without occupation or, of camels, without a herder.",
      "usage_conditions": "The absence may concern ornaments, property, discipline or good qualities, work, or attendance.",
      "source_refs": [
        "lane:entry:3764"
      ]
    },
    {
      "meaning_id": "cm-atila-large",
      "headword_arabic": "عَطِلَ",
      "definition": "To be or become large in body.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3764"
      ]
    },
    {
      "meaning_id": "cm-attala-strip",
      "headword_arabic": "عَطَّلَ",
      "definition": "To strip something of its adornment or attached equipment, such as ornaments from a woman or the string from a bow.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3765"
      ]
    },
    {
      "meaning_id": "cm-attala-vacant",
      "headword_arabic": "عَطَّلَ",
      "definition": "To render or leave a place, frontier, people, land, or animals vacant, unprotected, unguided, uncultivated, or neglected.",
      "usage_conditions": "The construction can describe a frontier without defenders, subjects without governance, land left uncultivated, or animals left without an attendant.",
      "source_refs": [
        "lane:entry:3765"
      ]
    },
    {
      "meaning_id": "cm-attala-idle",
      "headword_arabic": "عَطَّلَ",
      "definition": "To make someone or something free from work or service; to leave a hired worker idle or horses out of military use.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3765"
      ]
    },
    {
      "meaning_id": "cm-attala-hudud",
      "headword_arabic": "عَطَّلَ",
      "definition": "To refrain from imposing a prescribed legal punishment.",
      "usage_conditions": "Used in the conventional expression تَعْطِيلُ الحُدُودِ.",
      "source_refs": [
        "lane:entry:3765"
      ]
    },
    {
      "meaning_id": "cm-taattala-inactive",
      "headword_arabic": "تَعَطَّلَ",
      "definition": "To remain or become without work, inactive, unused, or vacant.",
      "usage_conditions": "Applied to a person without occupation, a bucket no longer used for drawing water, or a tent that has become vacant.",
      "source_refs": [
        "lane:entry:3767"
      ]
    },
    {
      "meaning_id": "cm-itaallat-luxuriant",
      "headword_arabic": "اِعْطَأَلَّتِ",
      "definition": "Of a tree, to become many-branched, tangled, luxuriant, or dense.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3769"
      ]
    },
    {
      "meaning_id": "cm-atal-body",
      "headword_arabic": "عَطَلٌ",
      "definition": "The denuded or unclad parts of the body; also the body or person, especially the neck, with reference to bodily form and beauty.",
      "usage_conditions": "The usage may refer specifically to the neck or more generally to a person's stature and physical perfection.",
      "source_refs": [
        "lane:entry:3771"
      ]
    },
    {
      "meaning_id": "cm-atal-palmstalk",
      "headword_arabic": "عَطَلٌ",
      "definition": "The stalk of a palm raceme, especially the male palm stalk used in pollination.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3771"
      ]
    },
    {
      "meaning_id": "cm-atila-beautiful",
      "headword_arabic": "عَطِلَةٌ",
      "definition": "Goodly, beautiful, or well formed in body.",
      "usage_conditions": "Applied especially to a woman or a she-camel; for a she-camel it may include perfection of body and tallness.",
      "source_refs": [
        "lane:entry:3772"
      ]
    },
    {
      "meaning_id": "cm-atila-milking",
      "headword_arabic": "عَطِلَةٌ",
      "definition": "Abounding in milk.",
      "usage_conditions": "Applied to a she-camel, ewe, or she-goat; the quality may be recognized from the appearance of the neck.",
      "source_refs": [
        "lane:entry:3772"
      ]
    },
    {
      "meaning_id": "cm-atil-bucket",
      "headword_arabic": "عَطِلٌ",
      "definition": "Of a leather bucket, rendered unusable by broken thongs or handles, or left unused for a time.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3772"
      ]
    },
    {
      "meaning_id": "cm-utul-unequipped",
      "headword_arabic": "عُطُلٌ",
      "definition": "Without customary adornment, attachments, or equipment.",
      "usage_conditions": "Applied to a woman without ornaments, animals without halters, collars, or brands, men without weapons, and a bow without a string.",
      "source_refs": [
        "lane:entry:3773"
      ]
    },
    {
      "meaning_id": "cm-utul-destitute",
      "headword_arabic": "عُطُلٌ",
      "definition": "Destitute of property or of discipline and other good qualities of mind.",
      "usage_conditions": "Applied to a man.",
      "source_refs": [
        "lane:entry:3773"
      ]
    },
    {
      "meaning_id": "cm-utla-idleness",
      "headword_arabic": "عُطْلَةٌ",
      "definition": "The state of being or remaining without work or occupation.",
      "usage_conditions": "It may also describe having no estate on which to labor.",
      "source_refs": [
        "lane:entry:3774"
      ]
    },
    {
      "meaning_id": "cm-atil-unpointed",
      "headword_arabic": "عَاطِلٌ",
      "definition": "Without diacritical points or vowel marks.",
      "usage_conditions": "In the expression عبارات or verses described as عَوَاطِلُ, the writing lacks the distinguishing marks found in pointed text.",
      "source_refs": [
        "lane:entry:3777"
      ]
    },
    {
      "meaning_id": "cm-aytal-tall",
      "headword_arabic": "عَيْطَلٌ",
      "definition": "Tall or long, especially long in the neck, with an implication of beauty or fine bodily form.",
      "usage_conditions": "Applied to a woman, she-camel, horse, or other animal, and also to a hill or mountain.",
      "source_refs": [
        "lane:entry:3778"
      ]
    },
    {
      "meaning_id": "cm-aytal-tender",
      "headword_arabic": "عَيْطَلٌ",
      "definition": "Soft or tender, of trees.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:3778"
      ]
    },
    {
      "meaning_id": "cm-muattil-doctrine",
      "headword_arabic": "مُعَطِّلٌ",
      "definition": "One who asserts that the universe is without a creator or artificer, or who denies one or more aspects of creation, resurrection, revelation, or divine agency.",
      "usage_conditions": "The term covers historically distinct doctrinal positions, including denial of the Creator, resurrection, apostles, or divine agency.",
      "source_refs": [
        "lane:entry:3765",
        "lane:entry:3781"
      ]
    },
    {
      "meaning_id": "cm-maatil-ornamentplaces",
      "headword_arabic": "مَعَاطِلُ",
      "definition": "The parts of the body that serve as places for a woman's ornaments.",
      "usage_conditions": "A plural form whose singular is not specified in the cited entry.",
      "source_refs": [
        "lane:entry:3783"
      ]
    }
  ],
