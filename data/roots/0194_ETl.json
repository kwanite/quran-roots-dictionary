{
  "root": "ETl",
  "arabic": "عطل",
  "root_idea": {
    "summary": "The root centers on emptiness, vacancy, and deprivation: being without adornment, occupation, equipment, attendance, or use.",
    "development": "The core idea extends from being empty or devoid to leaving things unguarded, unoccupied, unused, or neglected. A separate lexical branch describes height and beauty in عَيْطَلٌ.",
    "source_refs": [
      "maqayis:row:3242",
      "mufradat:row:991",
      "lane:entry:3778"
    ]
  },
