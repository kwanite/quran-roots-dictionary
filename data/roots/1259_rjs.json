  "other_classical_meanings": [
    {
      "meaning_id": "cm_rjs_noise_verb",
      "headword_arabic": "رَجَسَ",
      "definition": "To thunder vehemently or make a loud, confused noise.",
      "usage_conditions": "Said of the sky, a camel, or a great confused thing such as an army or torrent.",
      "source_refs": [
        "lane:entry:22576"
      ]
    },
    {
      "meaning_id": "cm_rjs_measure_well",
      "headword_arabic": "رَجَسَ",
      "definition": "To measure the water or depth of a well with a مِرْجَاس.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:22576"
      ]
    },
    {
      "meaning_id": "cm_rjs_hinder",
      "headword_arabic": "رَجَسَ",
      "definition": "To hinder, withhold, or prevent someone from doing something.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:22576"
      ]
    },
    {
      "meaning_id": "cm_rjis_unclean",
      "headword_arabic": "رَجِسَ / رَجُسَ",
      "definition": "To be or become unclean, dirty, filthy, stinking, or disliked because of uncleanness.",
      "usage_conditions": "This is the verbal state or change-of-state usage, distinct from the Quranic noun.",
      "source_refs": [
        "lane:entry:22576"
      ]
    },
    {
      "meaning_id": "cm_rjis_foul_action",
      "headword_arabic": "رَجِسَ / رَجُسَ",
      "definition": "To commit a bad, evil, abominable, or foul action.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:22576"
      ]
    },
    {
      "meaning_id": "cm_irtajas_building_noise",
      "headword_arabic": "اِرْتَجَسَ",
      "definition": "To become agitated or commotional so as to make a sound or noise.",
      "usage_conditions": "Said of a building.",
      "source_refs": [
        "lane:entry:22578"
      ]
    },
    {
      "meaning_id": "cm_rijs_malediction",
      "headword_arabic": "رِجْسٌ",
      "definition": "Malediction or execration.",
      "usage_conditions": "A further Classical Arabic use, distinct from the Quran-attested punishment-and-anger interpretation.",
      "source_refs": [
        "lane:entry:22579"
      ]
    },
    {
      "meaning_id": "cm_rijs_motion",
      "headword_arabic": "رِجْسٌ",
      "definition": "A light or slight motion.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:22579"
      ]
    },
    {
      "meaning_id": "cm_rijs_devilsuggestion",
      "headword_arabic": "رِجْسٌ",
      "definition": "A suggestion of the devil.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:22579"
      ]
    },
    {
      "meaning_id": "cm_raajis_noise",
      "headword_arabic": "رَاجِسٌ",
      "definition": "A loud-thundering or vehemently noisy thing.",
      "usage_conditions": "Applied to a cloud or thunder, to a camel that brays vehemently, and to the sea because of the sound or commotion of its waves.",
      "source_refs": [
        "lane:entry:22584"
      ]
    },
    {
      "meaning_id": "cm_raajis_mirjas_thrower",
      "headword_arabic": "رَاجِسٌ",
      "definition": "The thrower of a مِرْجَاس.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:22584"
      ]
    },
    {
      "meaning_id": "cm_mirjas",
      "headword_arabic": "مِرْجَاسٌ",
      "definition": "A stone attached to a rope and lowered or thrown into a well.",
      "usage_conditions": "It may be used to stir up mud so the well can be cleaned, or to determine the well's depth or whether it contains water by the sound of the stone.",
      "source_refs": [
        "lane:entry:22588"
      ]
    },
    {
      "meaning_id": "cm_marjuusa_confusion",
      "headword_arabic": "مَرْجُوسَةٌ",
      "definition": "A state of confusion and perturbation.",
      "usage_conditions": "Used with reference to a person's affair or circumstances.",
      "source_refs": [
        "lane:entry:22590"
      ]
    },
    {
      "meaning_id": "cm_nargis",
      "headword_arabic": "نَرْجِسٌ",
      "definition": "Narcissus, a sweet-smelling flower.",
      "usage_conditions": "A borrowed botanical noun whose etymological relationship to the root is not established by the lexical meaning itself.",
      "source_refs": [
        "lane:entry:22593"
      ]
    }
  ],
