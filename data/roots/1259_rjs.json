{
  "root": "rjs",
  "arabic": "رجس",
  "root_idea": {
    "summary": "The root centers on commotion or admixture, extending to resonant noise and to defiling impurity.",
    "development": "Classical usage connects mixing and tumult with thunderous or reverberant sound, while the impurity branch treats filth as a polluting mixture; Quranic usage develops this into physical, legal, and moral abomination.",
    "source_refs": [
      "maqayis:row:1974",
      "mufradat:row:533"
    ]
  },
  "qac_form_accounting": [
    {
      "form_group_id": "qac-form:rjs:rijos:nominal:-",
      "disposition": "DISPLAY",
      "target_public_form_id": "qform_rijs",
      "reason": "The canonical Quranic nominal group is displayed under the normalized citation form رِجْسٌ."
    }
  ],
  "quranic_forms": [
    {
      "public_form_id": "qform_rijs",
      "form_group_ids": [
        "qac-form:rjs:rijos:nominal:-"
      ],
      "headword_arabic": "رِجْسٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 10,
      "senses": [
        {
          "sense_id": "qform_rijs_s1",
          "definition": "Filth or polluting abomination: something regarded as unclean or prohibited.",
          "usage_conditions": "This branch concerns impurity recognized through physical or normative grounds, including legally forbidden substances or practices; it is not limited to a literal physical substance.",
          "source_refs": [
            "lane:entry:22579",
            "mufradat:row:533"
          ]
        },
        {
          "sense_id": "qform_rijs_s2",
          "definition": "Moral or religious corruption: a sinful or forbidden act, unbelief, doubt, or another spiritually repugnant state.",
          "usage_conditions": "Used of blameworthy acts or conditions, including shirk, unbelief, doubt, and an increase of such corruption; the sense may be rendered as evil, impurity, or abomination according to construction.",
          "source_refs": [
            "lane:entry:22579",
            "mufradat:row:533"
          ]
        },
        {
          "sense_id": "qform_rijs_s3",
          "definition": "Punishment or divine anger inflicted as the consequence of evil.",
          "usage_conditions": "A Quran-attested interpretive branch, especially reported for the construction in 10:100; it should not be generalized to occurrences where the noun denotes filth or moral corruption.",
          "source_refs": [
            "lane:entry:22579",
            "mufradat:row:533"
          ]
        }
      ],
