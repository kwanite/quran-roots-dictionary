  "other_classical_meanings": [
    {
      "meaning_id": "cm-sjn-sajan-split",
      "headword_arabic": "سَجَّنَ",
      "definition": "To cut, split, or cleave lengthwise.",
      "usage_conditions": "A Form II derived-verb usage.",
      "source_refs": [
        "lane:entry:40333"
      ]
    },
    {
      "meaning_id": "cm-sjn-sajan-palmtrenches",
      "headword_arabic": "سَجَّنَ",
      "definition": "To trench around palm trees so as to channel water to their roots when it does not reach them.",
      "usage_conditions": "A specialized derived-verb construction concerning the treatment of palm trees.",
      "source_refs": [
        "lane:entry:40333"
      ]
    },
    {
      "meaning_id": "cm-sjn-sajan-restraint",
      "headword_arabic": "سَجَنَ",
      "definition": "To restrain or hold back; figuratively, to suppress or conceal anxiety.",
      "usage_conditions": "The figurative application includes restraining the tongue and keeping inward anxiety from being expressed.",
      "source_refs": [
        "lane:entry:40332"
      ]
    },
    {
      "meaning_id": "cm-sjn-sajin-hard",
      "headword_arabic": "سِجِّينٌ",
      "definition": "Hard, vehement, or severe.",
      "usage_conditions": "The evidence specifically applies this description to a forceful or severe beating.",
      "source_refs": [
        "lane:entry:40337"
      ]
    },
    {
      "meaning_id": "cm-sjn-sijin-lasting",
      "headword_arabic": "سِجِّينٌ",
      "definition": "Continuing, lasting, or everlasting.",
      "usage_conditions": "A Classical Arabic adjectival usage synonymous with دوام or permanence.",
      "source_refs": [
        "lane:entry:40337"
      ]
    },
    {
      "meaning_id": "cm-sjn-sijin-openly",
      "headword_arabic": "سِجِّينٌ",
      "definition": "Openly or publicly.",
      "usage_conditions": "Used in the expression عَمِلَ ذٰلِكَ سِجِّينًا, 'he did that openly.'",
      "source_refs": [
        "lane:entry:40337"
      ]
    },
    {
      "meaning_id": "cm-sjn-sijin-palms",
      "headword_arabic": "سِجِّينٌ",
      "definition": "A designation for palm trees whose roots have trenches dug around them to channel water.",
      "usage_conditions": "A dialectal usage reported for the people of Bahrain and associated with the term سِلْتِين.",
      "source_refs": [
        "lane:entry:40337"
      ]
    },
    {
      "meaning_id": "cm-sjn-sajjan-keeper",
      "headword_arabic": "سَجَّانٌ",
      "definition": "A keeper or guard of a prison.",
      "usage_conditions": "An occupational noun derived from the prison-related branch of the root.",
      "source_refs": [
        "lane:entry:40336"
      ]
    },
    {
      "meaning_id": "cm-sjn-masjana-cause",
      "headword_arabic": "مَسْجَنَةٌ",
      "definition": "A cause or occasion of imprisonment.",
      "usage_conditions": "One reported gloss takes it as the act of imprisoning, but the lexical discussion favors the sense 'cause of imprisonment.'",
      "source_refs": [
        "lane:entry:40339"
      ]
    },
    {
      "meaning_id": "cm-sjn-saajun-softiron",
      "headword_arabic": "سَاجُونٌ",
      "definition": "A soft kind of iron.",
      "usage_conditions": "The description uses the expression 'female iron' for iron regarded as soft.",
      "source_refs": [
        "lane:entry:40338"
      ]
    }
  ],
