      "headword_arabic": "سِجِّينٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 2,
      "senses": [
        {
          "sense_id": "sjn-sijjin-n-s1",
          "definition": "A record or register containing the deeds of the wicked.",
          "usage_conditions": "In the Quranic passage of 83:7–8, this is one established interpretation of what سِجِّين denotes; the record may be described as the written register or its repository.",
          "source_refs": [
            "lane:entry:40337",
            "mufradat:row:664"
          ]
        },
        {
          "sense_id": "sjn-sijjin-n-s2",
          "definition": "A named place or realm associated with the wicked, described as beneath or within Hell and, in some accounts, as Hell itself.",
          "usage_conditions": "Explanations of the Quranic term variously identify it with a valley, a stone or rock, the seventh earth, or a place in Hell. These are variant identifications of the named place or realm.",
          "source_refs": [
            "lane:entry:40337",
            "mufradat:row:664"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "83:7",
