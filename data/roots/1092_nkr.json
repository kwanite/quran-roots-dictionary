      "senses": [
        {
          "sense_id": "nkr_munkir_s1",
          "definition": "One who does not recognize or is unacquainted with someone or something.",
          "usage_conditions": "The active participle may describe failure to recognize a person, not merely opposition to a proposition.",
          "source_refs": [
