      "senses": [
        {
          "sense_id": "nkr_nakir_s1",
          "definition": "Denial or disavowal.",
          "usage_conditions": "It can denote denial made in response to an accusation or claim.",
          "source_refs": [
            "lane:entry:44514"
          ]
        },
        {
          "sense_id": "nkr_nakir_s2",
          "definition": "Manifestation of disapproval, especially through a punitive change or reversal of conditions.",
          "usage_conditions": "In the Quranic expression concerning divine action, the disapproval is manifested by changing favor into trial, life into destruction, or prosperity into ruin; it is consequently rendered in context as rejection or punishment.",
          "source_refs": [
