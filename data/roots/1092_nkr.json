  "other_classical_meanings": [
    {
      "meaning_id": "cm_nakura_cunning",
      "headword_arabic": "نَكُرَ",
      "definition": "To possess cunning, sagacity, or skill joined with craft and foresight.",
      "usage_conditions": "A Classical Form-I branch concerning intelligence or strategic cleverness.",
      "source_refs": [
        "lane:entry:44498"
      ]
    },
    {
      "meaning_id": "cm_nakur_bad",
      "headword_arabic": "نَكُرَ",
      "definition": "To become disapproved, bad, evil, abominable, or disallowed.",
      "usage_conditions": "Used of a thing or affair that comes to be regarded as objectionable.",
      "source_refs": [
        "lane:entry:44498"
      ]
    },
    {
      "meaning_id": "cm_nakur_difficult",
      "headword_arabic": "نَكُرَ",
      "definition": "To become difficult, hard, arduous, or severe.",
      "usage_conditions": "A Form-I verbal branch describing an affair's increasing difficulty or severity.",
      "source_refs": [
        "lane:entry:44498"
      ]
    },
    {
      "meaning_id": "cm_nakara_mutual_guile",
      "headword_arabic": "نَاكَرَ",
      "definition": "To engage in mutual guile, outwitting, deception, or circumvention; by extension, to contend in hostility or fight.",
      "usage_conditions": "The hostile sense is an extended use of reciprocal guile and contest.",
      "source_refs": [
        "lane:entry:44500"
      ]
    },
    {
      "meaning_id": "cm_inkar_change",
      "headword_arabic": "إِنْكَار",
      "definition": "Changing or altering a thing, especially changing what is regarded as objectionable.",
      "usage_conditions": "This verbal-noun branch is distinct from denial and from the Quranic punitive manifestation denoted by نَكِير.",
      "source_refs": [
        "lane:entry:44501"
      ]
    },
    {
      "meaning_id": "cm_ankara_cunning",
      "headword_arabic": "أَنْكَرَ",
      "definition": "To be extraordinarily cunning or intelligent, with craft and foresight.",
      "usage_conditions": "Occurs in the idiomatic exclamation مَا أَنْكَرَهُ and related expressions.",
      "source_refs": [
        "lane:entry:44501"
      ]
    },
    {
      "meaning_id": "cm_tanakkara_change",
      "headword_arabic": "تَنَكَّرَ",
      "definition": "To change or alter oneself or one's appearance into an unknown state; to disguise oneself.",
      "usage_conditions": "The change may be outward, in countenance or clothing, or inwardly a change from a pleasing to a disliked condition; a morose manner is also included.",
      "source_refs": [
        "lane:entry:44502",
        "lane:entry:44519"
      ]
    },
    {
      "meaning_id": "cm_tanaakara_feign",
      "headword_arabic": "تَنَاكَرَ",
      "definition": "To feign ignorance or pretend not to know.",
      "usage_conditions": "A reciprocal Form-VI construction of affected non-recognition.",
      "source_refs": [
        "lane:entry:44503"
      ]
    },
    {
      "meaning_id": "cm_tanaakara_hostility",
      "headword_arabic": "تَنَاكَرَ",
      "definition": "To act with mutual hostility.",
      "usage_conditions": "A reciprocal hostile-use branch, distinct from merely feigning ignorance.",
      "source_refs": [
        "lane:entry:44503"
      ]
    },
    {
      "meaning_id": "cm_istinkar_inquiry",
      "headword_arabic": "اِسْتَنْكَرَ",
      "definition": "To inquire about or seek to understand something that one disapproves.",
      "usage_conditions": "The inquiry may challenge, confirm, or reject an opinion expressed by another person.",
      "source_refs": [
        "lane:entry:44504"
      ]
    },
    {
      "meaning_id": "cm_nukr_cunning",
      "headword_arabic": "نُكْر",
      "definition": "Cunning or sagacity, especially intelligence mixed with craft and foresight.",
      "usage_conditions": "A Classical nominal branch, distinct from the Quranic adjective meaning terrible or severe.",
      "source_refs": [
        "lane:entry:44506"
      ]
    },
    {
      "meaning_id": "cm_nakar_difficulty",
      "headword_arabic": "نَكَر",
      "definition": "Difficulty, hardness, arduousness, or severity.",
      "usage_conditions": "A noun derived from the Form-I branch meaning to become difficult.",
      "source_refs": [
        "lane:entry:44507"
      ]
    },
    {
      "meaning_id": "cm_nakir_cunning",
      "headword_arabic": "نَكِر",
      "definition": "Cunning, intelligent, skilful, or knowing.",
      "usage_conditions": "Applied as an epithet to a person possessing intelligence with craft and foresight.",
      "source_refs": [
        "lane:entry:44509"
      ]
    },
    {
      "meaning_id": "cm_nakir_disapprover",
      "headword_arabic": "نَكِر",
      "definition": "One who disapproves of what is bad, evil, abominable, or foul.",
      "usage_conditions": "This is an agent-noun use of the lexical branch, not the Quranic active participle headword مُنْكِر.",
      "source_refs": [
        "lane:entry:44509"
      ]
    },
    {
      "meaning_id": "cm_nakara_ignorance",
      "headword_arabic": "نَكَرَة",
      "definition": "Ignorance, denial, or disapproval.",
      "usage_conditions": "A verbal noun associated with إِنْكَار and used for a condition of non-recognition or rejection.",
      "source_refs": [
        "lane:entry:44511"
      ]
    },
    {
      "meaning_id": "cm_nakira_noun_ignorance",
      "headword_arabic": "نَكِرَة",
      "definition": "Ignorance of a thing; lack of knowledge, the opposite of معرفة.",
      "usage_conditions": "The grammatical sense of an indefinite noun is a separate technical use and is not included here.",
      "source_refs": [
        "lane:entry:44512"
      ]
    },
    {
      "meaning_id": "cm_nakraa_calamity",
      "headword_arabic": "نَكْرَاء",
      "definition": "A calamity or a severe and rigorous turn of fortune.",
      "usage_conditions": "A feminine nominal branch describing adversity or severity of circumstances.",
      "source_refs": [
        "lane:entry:44513"
      ]
    },
    {
      "meaning_id": "cm_nakir_fortress",
      "headword_arabic": "نَكِير",
      "definition": "A strong fortress.",
      "usage_conditions": "A separate Classical noun from the denial and punitive-change senses of نَكِير.",
      "source_refs": [
        "lane:entry:44514"
      ]
    },
    {
      "meaning_id": "cm_munkar_angel",
      "headword_arabic": "مُنْكَر",
      "definition": "The name of one of the two angels said to question the dead in the grave.",
      "usage_conditions": "A proper-name use in traditional religious terminology, distinct from the common noun مُنْكَر.",
      "source_refs": [
        "lane:entry:44517"
      ]
    },
    {
      "meaning_id": "cm_yankur_wrong_direction",
      "headword_arabic": "يَنْكُور",
      "definition": "Wrong-directed or deviating, as of a road or way.",
      "usage_conditions": "Used in the expression طَرِيقٌ يَنْكُورٌ.",
      "source_refs": [
        "lane:entry:44521"
      ]
    }
  ],
