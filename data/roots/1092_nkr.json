  "quranic_forms": [
    {
      "public_form_id": "nkr_nakira",
      "form_group_ids": [
        "qac-form:nkr:nakira:verb:I"
      ],
      "headword_arabic": "نَكِرَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "nkr_nakira_s1",
          "definition": "To fail to recognize; to find someone or something unfamiliar.",
          "usage_conditions": "In the Quranic scene, the visitors are not recognized or accepted as familiar. The sense concerns unfamiliarity and lack of recognition, rather than necessarily a deliberate verbal denial.",
          "source_refs": [
            "mufradat:row:1484",
            "lane:entry:44498"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "11:70",
          "word_location": "11:70:7",
          "sense_ids": [
            "nkr_nakira_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "nkr_nakkara",
      "form_group_ids": [
        "qac-form:nkr:nak~iru:verb:II"
      ],
      "headword_arabic": "نَكَّرَ",
      "public_pos_label": "Verb · Form II",
      "verb_form": "II",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "nkr_nakkara_s1",
          "definition": "To alter or disguise something so that it is not recognized.",
          "usage_conditions": "The Quranic construction concerns changing an object into an unfamiliar or unrecognizable state; it does not mean merely grammatical indefiniteness.",
          "source_refs": [
            "lane:entry:44499",
            "mufradat:row:1484"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "27:41",
          "word_location": "27:41:2",
          "sense_ids": [
            "nkr_nakkara_s1"
          ]
        }
      ]
    },
    {
      "public_form_id": "nkr_ankara",
      "form_group_ids": [
        "qac-form:nkr:yunkiru:verb:IV"
      ],
      "headword_arabic": "أَنْكَرَ",
      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 3,
      "senses": [
        {
          "sense_id": "nkr_ankara_s1",
          "definition": "To fail to recognize or know; to be unacquainted with someone or something.",
          "usage_conditions": "This is the recognition-based sense, contrasted with knowing or recognizing. It can describe an object of perception or an object held in the mind.",
          "source_refs": [
            "lane:entry:44501",
            "mufradat:row:1484"
          ]
        },
        {
          "sense_id": "nkr_ankara_s2",
          "definition": "To deny, disavow, or refuse to acknowledge something.",
          "usage_conditions": "The denial may be verbal or inward. The sources distinguish genuine lack of recognition from a tongue's denial of something already present in the mind, in which case the denial is false.",
          "source_refs": [
            "lane:entry:44501",
            "mufradat:row:1484"
          ]
        },
        {
          "sense_id": "nkr_ankara_s3",
          "definition": "To regard something as strange, extraordinary, improbable, or unacceptable.",
          "usage_conditions": "This shade can involve regarding conduct as strange or disapproved, rather than simply failing to identify it.",
          "source_refs": [
            "lane:entry:44501"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "13:36",
          "word_location": "13:36:11",
          "sense_ids": [
            "nkr_ankara_s2"
          ]
        },
        {
          "verse_key": "16:83",
          "word_location": "16:83:5",
          "sense_ids": [
            "nkr_ankara_s2"
          ]
        },
        {
          "verse_key": "40:81",
          "word_location": "40:81:6",
          "sense_ids": [
            "nkr_ankara_s2"
          ]
        }
      ]
    },
    {
