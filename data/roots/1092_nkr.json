      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "nkr_ankaru_s1",
          "definition": "More or most evil, abominable, or objectionable.",
          "usage_conditions": "An elative adjective comparing the reprehensibility of things; in the Quranic expression it marks the extreme degree.",
          "source_refs": [
            "lane:entry:44516"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "31:19",
          "word_location": "31:19:8",
