          ]
        }
      ]
    },
    {
      "public_form_id": "nkr_munkar",
      "form_group_ids": [
        "qac-form:nkr:munkar:nominal:-"
      ],
      "headword_arabic": "مُنْكَر",
      "public_pos_label": "Passive participle · substantivized",
      "verb_form": null,
      "occurrence_count": 18,
      "senses": [
        {
          "sense_id": "nkr_munkar_s1",
          "definition": "Something rejected as unacceptable, especially an act, saying, or conduct judged bad, evil, forbidden, indecent, or otherwise objectionable.",
          "usage_conditions": "In moral and legal usage, the noun denotes what sound judgment or revealed law rejects. As a passive-participle adjective it can also describe what is denied or regarded as strange.",
          "source_refs": [
            "lane:entry:44517",
            "mufradat:row:1484"
          ]
        },
        {
          "sense_id": "nkr_munkar_s2",
          "definition": "Something unrecognized, unknown, or not known as familiar.",
          "usage_conditions": "This recognition-based use is distinct from the moral noun meaning a wrong or forbidden act.",
          "source_refs": [
            "lane:entry:44517"
          ]
        }
      ],
      "quran_examples": [
