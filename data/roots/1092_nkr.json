{
  "root": "nkr",
  "arabic": "نكر",
  "root_idea": {
    "summary": "A core contrast with familiar recognition: what the heart does not settle into accepting or the tongue does not acknowledge.",
    "development": "From unfamiliarity and non-recognition, the root develops meanings of denial, rejection, disapproval, strangeness, alteration into an unknown state, difficulty, and—in some Classical branches—cunning or strategic intelligence.",
    "source_refs": [
      "maqayis:row:4743",
      "mufradat:row:1484"
    ]
  },
