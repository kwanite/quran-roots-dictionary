      "senses": [
        {
          "sense_id": "njw-najja-II-s1",
          "definition": "To save, rescue, or deliver someone from danger or destruction.",
          "usage_conditions": "A transitive causative/intensive form; the object may be an individual or a group, and the danger may be physical or punitive.",
          "source_refs": [
            "mufradat:row:1416"
          ]
        },
        {
          "sense_id": "njw-najja-II-s2",
          "definition": "To preserve or leave someone safely beyond destruction, with the surviving body or person set apart as a sign.",
          "usage_conditions": "In the Quranic account of Pharaoh, the form is explained as leaving or preserving his body after the destruction of his people; this is a particular preservation construction within the saving branch.",
          "source_refs": [
            "mufradat:row:1416"
          ]
        }
