{
  "root": "njw",
  "arabic": "نجو",
  "root_idea": {
    "summary": "The root combines two broad orientations: separation or clearing away from something, and concealment or confidential exchange.",
    "development": "The separation branch develops into escape, safety, deliverance, elevated refuge, movement away, and the removal of waste; the concealment branch develops into private speech, secret discourse, and private interlocution. Related usages also extend to uncovering or stripping away.",
    "source_refs": [
      "maqayis:row:4563",
      "mufradat:row:1416"
    ]
  },
