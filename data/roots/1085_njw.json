  "other_classical_meanings": [
    {
      "meaning_id": "cls-naja-excretion",
      "headword_arabic": "نَجَا",
      "definition": "To void excrement or emit wind.",
      "usage_conditions": "A bodily-function usage distinct from the escape meaning.",
      "source_refs": [
        "lane:entry:32097"
      ]
    },
    {
      "meaning_id": "cls-naja-swift",
      "headword_arabic": "نَجَا",
      "definition": "To be quick or swift, and to outstrip others.",
      "usage_conditions": "The sense includes the related verbal noun نَجَاءٌ for speed.",
      "source_refs": [
        "lane:entry:32097"
      ]
    },
    {
      "meaning_id": "cls-peel",
      "headword_arabic": "نَجَا",
      "definition": "To strip or peel bark from a tree or skin from an animal; a peeled stick or branch may also be called نَجًا.",
      "usage_conditions": "A transitive usage involving removal of an outer covering.",
      "source_refs": [
        "mufradat:row:1416",
        "maqayis:row:4563"
      ]
    },
    {
      "meaning_id": "cls-naja-private",
      "headword_arabic": "نَجَا",
      "definition": "In a transitive usage, to speak privately with someone.",
      "usage_conditions": "This reported usage is distinct from the ordinary intransitive sense ‘to escape’; it is interpreted as equivalent to private conversation.",
      "source_refs": [
        "mufradat:row:1416"
      ]
    },
    {
      "meaning_id": "cls-istinja",
      "headword_arabic": "اِسْتَنْجَى",
      "definition": "To wash or wipe the place of excrement with a stone, dry clay, or similar material.",
      "usage_conditions": "A technical purification usage connected with removing bodily waste or seeking a secluded place for that purpose.",
      "source_refs": [
        "lane:entry:32100"
      ]
    },
    {
      "meaning_id": "cls-rain",
      "headword_arabic": "نَجْوٌ، نَجَاءٌ",
      "definition": "A shower of rain.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:32101"
      ]
    },
    {
      "meaning_id": "cls-well",
      "headword_arabic": "نَجَاءٌ",
      "definition": "A well whose water lies far below its mouth.",
      "usage_conditions": "",
      "source_refs": [
        "lane:entry:32101"
      ]
    },
    {
      "meaning_id": "cls-najwa-highground",
      "headword_arabic": "نَجْوَةٌ",
      "definition": "An elevated piece of land, especially ground that remains above surrounding floodwater.",
      "usage_conditions": "The elevation is understood as providing refuge from a flood.",
      "source_refs": [
        "lane:entry:32102",
        "mufradat:row:1416",
        "maqayis:row:4563"
      ]
    },
    {
      "meaning_id": "cls-najat-land",
      "headword_arabic": "نَجَاةٌ",
      "definition": "A type of land whose trees provide usable sticks or rods.",
      "usage_conditions": "A classical land-description usage, separate from the abstract sense ‘salvation’.",
      "source_refs": [
        "mufradat:row:1416"
      ]
    },
    {
      "meaning_id": "cls-manjat",
      "headword_arabic": "مَنْجَاةٌ",
      "definition": "A cause or means of safety.",
      "usage_conditions": "A noun of means or circumstance denoting what affords deliverance.",
      "source_refs": [
        "lane:entry:32105"
      ]
    },
    {
      "meaning_id": "cls-anja-highground",
      "headword_arabic": "أَنْجَى",
      "definition": "To go to or resort to an elevated place.",
      "usage_conditions": "A classical Form IV usage connected with reaching a نَجْوَةٌ; it is distinct from the Quranic Form IV sense ‘to save’.",
      "source_refs": [
        "mufradat:row:1416"
      ]
    },
    {
      "meaning_id": "cls-anja-restore",
      "headword_arabic": "أَنْجَى",
      "definition": "To restore or make someone stand or recover.",
      "usage_conditions": "A rare reported usage occurring in a statement about the effect of medicine.",
      "source_refs": [
        "mufradat:row:1416"
      ]
    }
  ],
