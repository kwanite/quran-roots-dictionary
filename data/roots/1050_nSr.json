  "other_classical_meanings": [
    {
      "meaning_id": "nSr-nasara-preserve",
      "headword_arabic": "نَصَرَ",
      "definition": "To serve or preserve someone from another person or thing.",
      "usage_conditions": "A distinct construction with مِنْ expresses protection or preservation from a source of harm.",
      "source_refs": [
        "lane:entry:43830"
      ]
    },
    {
      "meaning_id": "nSr-nasara-rain",
      "headword_arabic": "نَصَرَ",
      "definition": "To aid or water the earth by rain, causing it to produce herbage.",
      "usage_conditions": "A tropical use applied to rain or to the earth receiving abundant rain.",
      "source_refs": [
        "lane:entry:43830"
      ]
    },
    {
      "meaning_id": "nSr-nasara-give",
      "headword_arabic": "نَصَرَ",
      "definition": "To give or bestow something to another.",
      "usage_conditions": "A tropical extension of aid, especially in the language of a person asking others to give to him.",
      "source_refs": [
        "lane:entry:43830",
        "maqayis:row:4649",
        "mufradat:row:1448"
      ]
    },
    {
      "meaning_id": "nSr-nasara-sustenance",
      "headword_arabic": "نَصَرَ",
      "definition": "To bestow means of subsistence or provision.",
      "usage_conditions": "An attributed tropical use equivalent to providing or supplying sustenance.",
      "source_refs": [
        "lane:entry:43830"
      ]
    },
    {
      "meaning_id": "nSr-nassara-christianize",
      "headword_arabic": "نَصَّرَ",
      "definition": "To make someone a Christian.",
      "usage_conditions": "This is the causative Form II use, distinct from the Quranic noun and relational adjective for a Christian.",
      "source_refs": [
        "lane:entry:43831"
      ]
    },
    {
      "meaning_id": "nSr-naasara-reciprocal",
      "headword_arabic": "نَاصَرَ",
      "definition": "To render reciprocal aid to another.",
      "usage_conditions": "Form III presents the action as aid exchanged between two parties.",
      "source_refs": [
        "lane:entry:43832"
      ]
    },
    {
      "meaning_id": "nSr-tanassara-strive",
      "headword_arabic": "تَنَصَّرَ",
      "definition": "To labor or strive to aid or assist.",
      "usage_conditions": "This is the effort-oriented Form V use, not merely the ordinary act of helping.",
      "source_refs": [
        "lane:entry:43833"
      ]
    },
    {
      "meaning_id": "nSr-tanassara-become-christian",
      "headword_arabic": "تَنَصَّرَ",
      "definition": "To become a Christian.",
      "usage_conditions": "A separate Form V use from striving to aid.",
      "source_refs": [
        "lane:entry:43833"
      ]
    },
    {
      "meaning_id": "nSr-tanasara-confirm",
      "headword_arabic": "تَنَاصَرَ",
      "definition": "Of reports or accounts, to confirm or verify one another.",
      "usage_conditions": "A tropical reciprocal use applied to mutually corroborating statements rather than to people rendering aid.",
      "source_refs": [
        "lane:entry:43834"
      ]
    },
    {
      "meaning_id": "nSr-istansara-beg",
      "headword_arabic": "اِسْتَنْصَرَ",
      "definition": "To beg.",
      "usage_conditions": "A tropical extension of seeking aid, treating a requested gift as aid.",
      "source_refs": [
        "lane:entry:43836"
      ]
    },
    {
      "meaning_id": "nSr-nasr-booty",
      "headword_arabic": "نَصْر",
      "definition": "Spoil, plunder, or booty.",
      "usage_conditions": "A separately attested nominal use in classical vocabulary.",
      "source_refs": [
        "lane:entry:43837"
      ]
    },
    {
      "meaning_id": "nSr-nasr-rain",
      "headword_arabic": "نَصْر",
      "definition": "Rain.",
      "usage_conditions": "A tropical nominal use, especially rain understood as aid to the earth.",
      "source_refs": [
        "lane:entry:43837"
      ]
    },
    {
      "meaning_id": "nSr-nasr-gift",
      "headword_arabic": "نَصْر",
      "definition": "A gift.",
      "usage_conditions": "A tropical nominal extension from aid or from rain aiding the earth.",
      "source_refs": [
        "lane:entry:43837"
      ]
    },
    {
      "meaning_id": "nSr-nasair-gifts",
      "headword_arabic": "نَصَائِر",
      "definition": "Gifts.",
      "usage_conditions": "Plural nominal usage corresponding to the gift sense of نَصْر.",
      "source_refs": [
        "lane:entry:43837"
      ]
    },
    {
      "meaning_id": "nSr-nasur-aider",
      "headword_arabic": "نَصُور",
      "definition": "One who aids or assists much or well.",
      "usage_conditions": "An intensive descriptive form emphasizing frequency or excellence of aiding.",
      "source_refs": [
        "lane:entry:43844"
      ]
    },
    {
      "meaning_id": "nSr-ansar-prophetic",
      "headword_arabic": "أَنْصَار",
      "definition": "The Helpers of the Prophet, especially the supporters from the Aws and Khazraj.",
      "usage_conditions": "This is the historical collective designation, distinct from the ordinary plural meaning 'helpers'.",
      "source_refs": [
        "lane:entry:43848"
      ]
    },
    {
      "meaning_id": "nSr-mansura-rained-land",
      "headword_arabic": "مَنْصُورَة",
      "definition": "Land watered or rained upon.",
      "usage_conditions": "A tropical passive-participial use describing land benefited by rain.",
      "source_refs": [
        "lane:entry:43852"
      ]
    },
    {
      "meaning_id": "nSr-nasraniya-religion",
      "headword_arabic": "النَّصْرَانِيَّة",
      "definition": "The religion of the Christians.",
      "usage_conditions": "The feminine abstract form denotes the religious affiliation or religion associated with the نَصَارَى.",
      "source_refs": [
        "lane:entry:43843"
      ]
    }
