      "headword_arabic": "نَصَرَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 59,
      "senses": [
        {
          "sense_id": "nSr-naSara-I-s1",
          "definition": "To aid, assist, or support someone or a cause, especially against an adversary.",
          "usage_conditions": "The Quran uses the verb for aiding people, messengers, servants, or God's cause; when directed toward God's religion or servants, the construction includes supporting its commands and ordinances.",
          "source_refs": [
            "lane:entry:43830",
            "mufradat:row:1448"
          ]
        },
        {
          "sense_id": "nSr-naSara-I-s2",
          "definition": "To make victorious; to cause someone to prevail over or overcome an adversary.",
          "usage_conditions": "This is the resultative aspect of aid in contexts where divine or other assistance brings victory.",
          "source_refs": [
            "lane:entry:43830",
            "mufradat:row:1448"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "47:7",
