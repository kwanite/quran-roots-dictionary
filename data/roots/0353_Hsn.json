      "senses": [
        {
          "sense_id": "Hsn_husna_s1",
          "definition": "The best, most excellent, or most beautiful thing or state.",
          "usage_conditions": "The feminine elative form, frequently substantivized; it includes constructions such as the Most Beautiful Names and the best course or outcome.",
