      "headword_arabic": "إِحْسَان",
      "public_pos_label": "Verbal noun",
      "verb_form": null,
      "occurrence_count": 12,
      "senses": [
        {
          "sense_id": "Hsn_ihsan_s1",
          "definition": "Good treatment, beneficence, or kindness toward another.",
          "usage_conditions": "The outward exercise of goodness in which more is given than is strictly owed and less is taken than is due; it is broader than mere benefaction and exceeds strict justice.",
          "source_refs": [
            "lane:entry:14478",
            "mufradat:row:325"
          ]
        },
        {
          "sense_id": "Hsn_ihsan_s2",
          "definition": "Excellence in one's own action, conduct, or performance.",
          "usage_conditions": "Includes doing an act well, maintaining good obedience, and acting with moral or practical excellence; it may apply to one's own action as well as to treatment of others.",
          "source_refs": [
            "lane:entry:14478",
            "mufradat:row:325"
          ]
        },
        {
          "sense_id": "Hsn_ihsan_s3",
          "definition": "Sincerity, watchful obedience, and steadfast adherence to the righteous way.",
          "usage_conditions": "A Quran-attested theological and devotional use in which ihsān denotes inward sincerity together with vigilant, sound obedience and following the established path of the righteous.",
          "source_refs": [
            "lane:entry:14478"
          ]
        }
      ],
