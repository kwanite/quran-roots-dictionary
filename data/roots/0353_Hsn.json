  "other_classical_meanings": [
    {
      "meaning_id": "cm_hassana_makegood",
      "headword_arabic": "حَسَّنَ",
      "definition": "To make or render something good, beautiful, comely, or pleasing; to beautify, embellish, or adorn it.",
      "usage_conditions": "Form II. The lexical entry also explains a Quranic expression as making the creation of each thing good, but no Form II QAC group is supplied here.",
      "source_refs": [
        "lane:entry:14476"
      ]
    },
    {
      "meaning_id": "cm_muhasana_vie",
      "headword_arabic": "حَاسَنَ",
      "definition": "To vie with someone or contend for superiority in goodness or beauty.",
      "usage_conditions": "A reciprocal or comparative construction involving competition in ḥusn.",
      "source_refs": [
        "lane:entry:14477"
      ]
    },
    {
      "meaning_id": "cm_tahassana_selfbeautify",
      "headword_arabic": "تَحَسَّنَ",
      "definition": "To beautify or adorn oneself, and to affect what is good, comely, or pleasing in appearance, conduct, or character.",
      "usage_conditions": "Form V; the usage includes grooming or being shaved as part of improving one's appearance.",
      "source_refs": [
        "lane:entry:14479"
      ]
    },
    {
      "meaning_id": "cm_tahasuna_affectgood",
      "headword_arabic": "تَحَاسَنَ",
      "definition": "To affect goodness or beauty without genuinely possessing it.",
      "usage_conditions": "Form VI, with an expressly pretended or merely displayed quality.",
      "source_refs": [
        "lane:entry:14480"
      ]
    },
    {
      "meaning_id": "cm_istihsan_approve",
      "headword_arabic": "اِسْتَحْسَنَ",
      "definition": "To judge, esteem, approve, or like something as good, beautiful, pleasing, or acceptable.",
      "usage_conditions": "Form X; the object is evaluated favorably by the speaker or observer.",
      "source_refs": [
        "lane:entry:14481"
      ]
    },
    {
      "meaning_id": "cm_ahsana_knowwell",
      "headword_arabic": "أَحْسَنَ",
      "definition": "To know something well or be proficient in it.",
      "usage_conditions": "A figurative Form IV use, including being proficient in a language or another field of knowledge.",
      "source_refs": [
        "lane:entry:14478"
      ]
    },
    {
      "meaning_id": "cm_ahsana_sandhill",
      "headword_arabic": "أَحْسَنَ",
      "definition": "To sit upon a high hill or heap of sand called حَسَن.",
      "usage_conditions": "A rare lexical use recorded for the Form IV headword.",
      "source_refs": [
        "lane:entry:14478"
      ]
    },
    {
      "meaning_id": "cm_husn_flowerplant",
      "headword_arabic": "حُسْن",
      "definition": "A flowering plant, identified as a convolvulus, known for its beautiful flower.",
      "usage_conditions": "Occurs in the plant name سِتُّ الحُسْنِ.",
      "source_refs": [
        "lane:entry:14482"
      ]
    },
    {
      "meaning_id": "cm_hasan_hadith",
      "headword_arabic": "حَسَن",
      "definition": "A hadith of good authority.",
      "usage_conditions": "A technical hadith classification, generally applied to a report transmitted initially by two or more relaters.",
      "source_refs": [
        "lane:entry:14483"
      ]
    },
    {
      "meaning_id": "cm_hasan_discourse",
      "headword_arabic": "حَسَن",
      "definition": "Good, comely, good-humoured, pleasing, or pleasant discourse.",
      "usage_conditions": "An adjectival use specifically applied to speech or conversation.",
      "source_refs": [
        "lane:entry:14483"
      ]
    },
    {
      "meaning_id": "cm_hasan_armbone",
      "headword_arabic": "الحَسَن",
      "definition": "A portion of the arm bone near the elbow or shoulder joint.",
      "usage_conditions": "An anatomical term whose exact segment is described differently by authorities; it denotes the fleshy upper or elbow-adjacent portion distinguished from the قبيح portion.",
      "source_refs": [
        "lane:entry:14483"
      ]
    },
    {
      "meaning_id": "cm_hasan_tree",
      "headword_arabic": "حَسَن",
      "definition": "A tree of beautiful appearance, also called الألاء, growing in rows on a sandy hill.",
      "usage_conditions": "A botanical noun named for the tree's beauty.",
      "source_refs": [
        "lane:entry:14483"
      ]
    },
    {
      "meaning_id": "cm_hasan_sandhill",
      "headword_arabic": "حَسَن",
      "definition": "A high sand hill or heap of sand.",
      "usage_conditions": "A geographic or topographic noun; it is also used as a personal name.",
      "source_refs": [
        "lane:entry:14483"
      ]
    },
    {
      "meaning_id": "cm_hisna_ledge",
      "headword_arabic": "حِسْنَة",
      "definition": "A ledge or projecting shelf of rock on a mountain.",
      "usage_conditions": "A distinct nominal form with the plural حِسَن.",
      "source_refs": [
        "lane:entry:14486"
      ]
    },
    {
      "meaning_id": "cm_husayn_mountain",
      "headword_arabic": "حُسَيْن",
      "definition": "A high mountain.",
      "usage_conditions": "A lexical use distinct from the diminutive use of حُسَيْن as a personal name.",
      "source_refs": [
        "lane:entry:14492"
      ]
    },
    {
      "meaning_id": "cm_husayna_tree",
      "headword_arabic": "حُسَيْنَاء",
      "definition": "A kind of tree with small leaves.",
      "usage_conditions": "A botanical noun distinct from the related diminutive and intensifying forms.",
      "source_refs": [
        "lane:entry:14494"
      ]
    },
    {
      "meaning_id": "cm_husayna_utmost",
      "headword_arabic": "حُسَيْنَى",
      "definition": "One's utmost or best effort, ability, deed, or condition.",
      "usage_conditions": "Used in the construction حُسَيْنَاهُ أَنْ يَفْعَلَ كَذَا, expressing the best or utmost that someone can do.",
      "source_refs": [
        "lane:entry:14493"
      ]
    },
    {
      "meaning_id": "cm_hasin_moon",
      "headword_arabic": "حَاسِن",
      "definition": "The moon.",
      "usage_conditions": "A lexicalized noun derived from the notion of beauty.",
      "source_refs": [
        "lane:entry:14496"
      ]
    },
    {
      "meaning_id": "cm_tahsin_calligraphy",
      "headword_arabic": "تَحْسِين",
      "definition": "Deliberate, orderly, regular, close, and compact writing; calligraphic improvement.",
      "usage_conditions": "A technical substantive, contrasted with مَشْق, writing with elongated or widely spaced letters.",
      "source_refs": [
        "lane:entry:14499"
      ]
    },
    {
      "meaning_id": "cm_mahsana_benefit",
      "headword_arabic": "مَحْسَنَة",
      "definition": "A cause of good; something beneficial to the body or circumstances.",
      "usage_conditions": "A noun for an object or circumstance that produces benefit rather than the benefit itself.",
      "source_refs": [
        "lane:entry:14503"
      ]
    },
    {
      "meaning_id": "cm_mahasin_bodybeauties",
      "headword_arabic": "مَحَاسِن",
      "definition": "The beautiful places or parts of the body, especially bodily features or facial beauties.",
      "usage_conditions": "A plural noun commonly used without a singular in ordinary lexical usage; contrasted with bodily defects.",
      "source_refs": [
        "lane:entry:14506"
      ]
    },
    {
      "meaning_id": "cm_mahasin_qualities",
      "headword_arabic": "مَحَاسِن",
      "definition": "Good qualities, virtues, or good actions of any kind.",
      "usage_conditions": "A broader figurative extension of the plural, contrasted with مَسَاوِئ or other defects.",
      "source_refs": [
        "lane:entry:14506"
      ]
    }
