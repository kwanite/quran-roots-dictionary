{
  "root": "rhb",
  "arabic": "رهب",
  "root_idea": {
    "summary": "The root has two principal semantic orientations: fear or apprehension, and thinness or lightness.",
    "development": "The fear branch extends from guarded fear to causing fear in others and to religious withdrawal or monastic austerity. A separate branch describes lean or fatigued camels, slender arrowheads, and a bone or cartilage in the chest.",
    "source_refs": [
      "maqayis:row:2164"
    ]
  },
