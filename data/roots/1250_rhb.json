  "quranic_forms": [
    {
      "public_form_id": "pf_rhb_rahiba",
      "form_group_ids": [
        "qac-form:rhb:yarohabu:verb:I"
      ],
      "headword_arabic": "رَهِبَ",
      "public_pos_label": "Verb · Form I",
      "verb_form": "I",
      "occurrence_count": 3,
      "senses": [
        {
          "sense_id": "s_rhb_rahiba_1",
          "definition": "To fear; to experience fear with caution, apprehension, or awe.",
          "usage_conditions": "An intransitive fear verb; the Quranic uses include direct exhortations to fear God and descriptions of people who are fearful.",
          "source_refs": [
            "lane:entry:24666",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "2:40",
          "word_location": "2:40:13",
          "sense_ids": [
            "s_rhb_rahiba_1"
          ]
        },
        {
          "verse_key": "7:154",
          "word_location": "7:154:15",
          "sense_ids": [
            "s_rhb_rahiba_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_arhaba",
      "form_group_ids": [
        "qac-form:rhb:turohibu:verb:IV"
      ],
      "headword_arabic": "أَرْهَبَ",
      "public_pos_label": "Verb · Form IV",
      "verb_form": "IV",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "s_rhb_arhaba_1",
          "definition": "To frighten, terrify, or cause someone to fear.",
          "usage_conditions": "A transitive causative use, with the feared party expressed as the object or understood from context.",
          "source_refs": [
            "lane:entry:24668",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "8:60",
          "word_location": "8:60:10",
          "sense_ids": [
            "s_rhb_arhaba_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_istarhaba",
      "form_group_ids": [
        "qac-form:rhb:{sotarohabu:verb:X"
      ],
      "headword_arabic": "اِسْتَرْهَبَ",
      "public_pos_label": "Verb · Form X",
      "verb_form": "X",
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "s_rhb_istarhaba_1",
          "definition": "To call forth fear in others, causing them to become afraid.",
          "usage_conditions": "A causative construction in which the subject produces fear and the object is made to fear.",
          "source_refs": [
            "lane:entry:24670",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "7:116",
          "word_location": "7:116:8",
          "sense_ids": [
            "s_rhb_istarhaba_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_rahab",
      "form_group_ids": [
        "qac-form:rhb:rahab:nominal:-"
      ],
      "headword_arabic": "رَهَبٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "s_rhb_rahab_1",
          "definition": "Fear or apprehensive dread.",
          "usage_conditions": "A fear noun that can be coordinated with رغبة, desire or hope, as in the Quranic expression involving both desire and fear.",
          "source_refs": [
            "lane:entry:24666",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "21:90",
          "word_location": "21:90:16",
          "sense_ids": [
            "s_rhb_rahab_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_rahbaniyya",
      "form_group_ids": [
        "qac-form:rhb:rahobaAniy~ap:nominal:-"
      ],
      "headword_arabic": "رَهْبَانِيَّةٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "s_rhb_rahbaniyya_1",
          "definition": "Monasticism or ascetic religious withdrawal; a life of religious austerity and detachment.",
          "usage_conditions": "In the Quranic context, the term is associated with excessive religious discipline and withdrawal from ordinary human society, described as an innovation adopted by some people.",
          "source_refs": [
            "lane:entry:24683",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "57:27",
          "word_location": "57:27:19",
          "sense_ids": [
            "s_rhb_rahbaniyya_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_rahba",
      "form_group_ids": [
        "qac-form:rhb:rahobap:nominal:-"
      ],
      "headword_arabic": "رَهْبَةٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "s_rhb_rahba_1",
          "definition": "Fear or apprehension, especially fear accompanied by caution.",
          "usage_conditions": "A noun of emotional state; the Quranic use denotes fear in which the feared consequence is kept in view.",
          "source_refs": [
            "lane:entry:24666",
            "lane:entry:24675",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "59:13",
          "word_location": "59:13:3",
          "sense_ids": [
            "s_rhb_rahba_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_ruhban",
      "form_group_ids": [
        "qac-form:rhb:ruhoba`n:nominal:-"
      ],
      "headword_arabic": "رُهْبَانٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 3,
      "senses": [
        {
          "sense_id": "s_rhb_ruhban_1",
          "definition": "Monks or Christian religious recluses and devotees.",
          "usage_conditions": "The form may function as a singular or plural in Classical Arabic; the Quranic occurrences refer to Christian religious figures as a group or class.",
          "source_refs": [
            "lane:entry:24687",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "5:82",
          "word_location": "5:82:23",
          "sense_ids": [
            "s_rhb_ruhban_1"
          ]
        },
        {
          "verse_key": "9:31",
          "word_location": "9:31:3",
          "sense_ids": [
            "s_rhb_ruhban_1"
          ]
        },
        {
          "verse_key": "9:34",
          "word_location": "9:34:8",
          "sense_ids": [
            "s_rhb_ruhban_1"
          ]
        }
      ]
    },
    {
      "public_form_id": "pf_rhb_rahb",
      "form_group_ids": [
        "qac-form:rhb:r~ahob:nominal:-"
      ],
      "headword_arabic": "رَهْبٌ",
      "public_pos_label": "Noun",
      "verb_form": null,
      "occurrence_count": 1,
      "senses": [
        {
          "sense_id": "s_rhb_rahb_1",
          "definition": "Fear, panic, or apprehensive dread.",
          "usage_conditions": "In 28:32 this is one established interpretation of the word, treating it as a fear noun related to رَهِبَ.",
          "source_refs": [
            "lane:entry:24673",
            "mufradat:row:590"
          ]
        },
        {
          "sense_id": "s_rhb_rahb_2",
          "definition": "A sleeve.",
          "usage_conditions": "In 28:32 this is an alternative lexical interpretation of the expression; the passage has competing transmitted readings and explanations, including the fear meaning.",
          "source_refs": [
            "lane:entry:24673",
            "mufradat:row:590"
          ]
        }
      ],
      "quran_examples": [
        {
          "verse_key": "28:32",
          "word_location": "28:32:14",
          "sense_ids": [
            "s_rhb_rahb_1"
          ]
        }
      ]
    }
  ],
  "other_classical_meanings": [
    {
      "meaning_id": "cm_rhb_rahhaba_deterrence",
      "headword_arabic": "رَهَّبَ",
      "definition": "To deter someone from a thing, making him relinquish it or abstain from it.",
      "usage_conditions": "A transitive Form II use, contrasted with encouraging someone toward a thing.",
      "source_refs": [
        "lane:entry:24667"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahhaba_make_monk",
      "headword_arabic": "رَهَّبَ",
      "definition": "To make someone a monk.",
      "usage_conditions": "Reported as a later or possibly post-Classical use.",
      "source_refs": [
        "lane:entry:24667"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahhaba_fatigue",
      "headword_arabic": "رَهَّبَ / مُرَهِّبٌ",
      "definition": "To become fatigued or jaded; of a camel, to falter or lie down from weakness, especially weakness in the back.",
      "usage_conditions": "Applied to a person or camel; the participial form is specifically used of a fatigued she-camel.",
      "source_refs": [
        "lane:entry:24667",
        "lane:entry:24690"
      ]
    },
    {
      "meaning_id": "cm_rhb_ruhhiba_thin_blade",
      "headword_arabic": "رُهِّبَ",
      "definition": "To be rubbed, apparently so as to be made thin, said of an iron arrowhead or blade.",
      "usage_conditions": "A specialized description of an arrow or similar blade.",
      "source_refs": [
        "lane:entry:24667"
      ]
    },
    {
      "meaning_id": "cm_rhb_arhaba_camels",
      "headword_arabic": "أَرْهَبَ",
      "definition": "To drive away, repel, or withhold camels from a watering place.",
      "usage_conditions": "A specialized transitive use with camels as the object.",
      "source_refs": [
        "lane:entry:24668"
      ]
    },
    {
      "meaning_id": "cm_rhb_arhaba_ride_rahb",
      "headword_arabic": "أَرْهَبَ",
      "definition": "To ride a camel of the kind called رَهْب.",
      "usage_conditions": "A conventional use referring to a particular camel description.",
      "source_refs": [
        "lane:entry:24668"
      ]
    },
    {
      "meaning_id": "cm_rhb_trahhaba_ascetic",
      "headword_arabic": "تَرَهَّبَ",
      "definition": "To become a monk or ascetic and devote oneself to religious exercises, often by withdrawing from the world.",
      "usage_conditions": "The practice may involve residence in a monastic cell and detachment from ordinary social life.",
      "source_refs": [
        "lane:entry:24669"
      ]
    },
    {
      "meaning_id": "cm_rhb_trahhaba_threaten",
      "headword_arabic": "تَرَهَّبَ",
      "definition": "To threaten someone.",
      "usage_conditions": "A transitive conventional use distinct from becoming a monk or ascetic.",
      "source_refs": [
        "lane:entry:24669"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahb_camel",
      "headword_arabic": "رَهْبٌ",
      "definition": "A camel that is lean, emaciated, or fatigued from travel; also, a tall or broad-made male camel.",
      "usage_conditions": "The descriptions vary by sex and authority and belong to specialized camel vocabulary.",
      "source_refs": [
        "lane:entry:24671"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahb_arrow",
      "headword_arabic": "رَهْبٌ",
      "definition": "A slender or large arrow, especially its thin iron head or blade.",
      "usage_conditions": "The plural is رِهَابٌ.",
      "source_refs": [
        "lane:entry:24671"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahban_excessively_fearful",
      "headword_arabic": "رَهْبَانُ",
      "definition": "Excessively fearful.",
      "usage_conditions": "Applied adjectivally, including of a person.",
      "source_refs": [
        "lane:entry:24679"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahbut_fearful",
      "headword_arabic": "رَهَبُوتٌ",
      "definition": "Fearful or fearsome.",
      "usage_conditions": "Applied to a man; the form also occurs in proverbial expressions concerning being feared rather than pitied.",
      "source_refs": [
        "lane:entry:24681"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahabah_sternum",
      "headword_arabic": "رَهَابَةٌ",
      "definition": "The ensiform cartilage or lower extremity of the sternum, a small tongue-shaped bone or cartilage projecting over the abdomen.",
      "usage_conditions": "An anatomical term; some authorities identify it with the extremity of the stomach.",
      "source_refs": [
        "lane:entry:24685"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahib_fearer",
      "headword_arabic": "رَاهِبٌ",
      "definition": "One who fears, especially one who fears God with reverence or guarded awe.",
      "usage_conditions": "An active participial description of a person characterized by fear.",
      "source_refs": [
        "lane:entry:24687"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahib_monk",
      "headword_arabic": "رَاهِبٌ",
      "definition": "A Christian monk, ascetic, religious recluse, or devotee.",
      "usage_conditions": "The ordinary plural is رُهْبَانٌ, with other plural forms also attested.",
      "source_refs": [
        "lane:entry:24687"
      ]
    },
    {
      "meaning_id": "cm_rhb_rahiba_frightening_state",
      "headword_arabic": "رَاهِبَةٌ",
      "definition": "A state or condition that frightens.",
      "usage_conditions": "A noun describing a frightening condition rather than a person who fears.",
      "source_refs": [
        "lane:entry:24688"
      ]
    },
    {
      "meaning_id": "cm_rhb_arhab_nonrapacious_birds",
      "headword_arabic": "أَرْهَابٌ",
      "definition": "Birds that are not rapacious and do not prey.",
      "usage_conditions": "The lexical explanation is preserved although the proposed connection with timidity is only reported as an interpretation.",
      "source_refs": [
        "lane:entry:24689"
      ]
    },
    {
      "meaning_id": "cm_rhb_marhub_feared",
      "headword_arabic": "مَرْهُوبٌ",
      "definition": "Feared, or regarded with guarded fear and awe.",
      "usage_conditions": "Applied especially to God in the cited devotional expression.",
      "source_refs": [
        "lane:entry:24691"
      ]
    },
    {
      "meaning_id": "cm_rhb_marhub_lion",
      "headword_arabic": "المَرْهُوبُ",
      "definition": "The lion.",
      "usage_conditions": "A conventional transferred designation based on being feared.",
      "source_refs": [
        "lane:entry:24691"
      ]
    }
  ],
